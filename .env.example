# Copy to .env (repo root, for docker-compose) and to apps/api/.env / packages/database/.env
# as needed — see Docs/ARCHITECTURE.md "Local environment" for the full setup.
# Every var apps/api actually reads is validated at startup by
# apps/api/src/config/env.validation.ts (zod) — it fails fast with a clear
# message if one is missing or malformed, rather than an undefined a hundred
# requests later. Keep this file and that schema in sync.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001

# --- Database (matches docker-compose.yml's postgres service) ---
DATABASE_URL="postgresql://texawave:texawave@localhost:5432/texawave_erp?schema=public"

# --- Redis (matches docker-compose.yml's redis service) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Generate a real one for anything beyond a laptop: openssl rand -base64 48
# Never commit a real secret here or anywhere else in the repo.
JWT_SECRET="replace-with-a-real-random-secret-at-least-32-characters-long"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Frontend (apps/ui) ---
NEXT_PUBLIC_API_URL=http://localhost:3000
