# Shared/infra vars only — consumed directly by docker-compose.yml (Postgres/
# Redis credentials) and by packages/database (Prisma needs DATABASE_URL to
# run migrations). App-specific vars live in their own package's example
# file: apps/api/.env.example (API-only) and apps/ui/.env.example
# (NEXT_PUBLIC_* only) — see Docs/ARCHITECTURE.md "Local environment" for the
# full local setup, including which file to copy where.

# --- Database (matches docker-compose.yml's postgres service) ---
DATABASE_URL="postgresql://texawave:texawave@localhost:5432/texawave_erp?schema=public"

# --- Redis (matches docker-compose.yml's redis service) ---
REDIS_URL="redis://localhost:6379"
