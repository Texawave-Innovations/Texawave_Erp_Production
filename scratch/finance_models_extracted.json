{
  "FinanceMasterListItem": {
    "fields": [
      "id             Int       @id @default(autoincrement())",
      "organizationId Int       @map(\"organization_id\")",
      "category       String",
      "value          String",
      "numericValue   Decimal?  @map(\"numeric_value\") @db.Decimal(10, 4)",
      "customFields   Json      @default(\"{"
    ],
    "attributes": []
  },
  "FinanceAccount": {
    "fields": [
      "id              Int       @id @default(autoincrement())",
      "organizationId  Int       @map(\"organization_id\")",
      "accountCode     String    @map(\"account_code\")",
      "accountName     String    @map(\"account_name\")",
      "accountType     String    @map(\"account_type\")",
      "parentAccountId Int?      @map(\"parent_account_id\")",
      "currency        String    @default(\"INR\")",
      "currentBalance  Decimal   @default(0) @map(\"current_balance\") @db.Decimal(15, 2)",
      "isActive        Boolean   @default(true) @map(\"is_active\")",
      "isReconciled    Boolean   @default(false) @map(\"is_reconciled\")",
      "description     String?",
      "createdBy       Int?      @map(\"created_by\")",
      "updatedBy       Int?      @map(\"updated_by\")",
      "createdAt       DateTime  @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt       DateTime  @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "deletedAt       DateTime? @map(\"deleted_at\") @db.Timestamptz(6)",
      "organization    Organization          @relation(fields: [organizationId], references: [id])",
      "parentAccount   FinanceAccount?       @relation(\"AccountHierarchy\", fields: [parentAccountId], references: [id])",
      "subAccounts     FinanceAccount[]      @relation(\"AccountHierarchy\")",
      "journalLines    FinanceJournalLine[]",
      "bankAccounts    FinanceBankAccount[]",
      "expenses        FinanceExpense[]"
    ],
    "attributes": [
      "@@unique([organizationId, accountCode])",
      "@@index([organizationId, accountType])",
      "@@index([organizationId, isActive])",
      "@@map(\"accounts\")",
      "@@schema(\"finance\")"
    ]
  },
  "FinanceJournalEntry": {
    "fields": [
      "id              Int       @id @default(autoincrement())",
      "organizationId  Int       @map(\"organization_id\")",
      "entryNumber     String    @map(\"entry_number\")",
      "entryDate       DateTime  @map(\"entry_date\") @db.Date",
      "entryType       String    @default(\"MANUAL\") @map(\"entry_type\")",
      "narration       String",
      "referenceNumber String?   @map(\"reference_number\")",
      "totalDebit      Decimal   @map(\"total_debit\") @db.Decimal(15, 2)",
      "totalCredit     Decimal   @map(\"total_credit\") @db.Decimal(15, 2)",
      "status          String    @default(\"DRAFT\")",
      "postedAt        DateTime? @map(\"posted_at\") @db.Timestamptz(6)",
      "postedBy        Int?      @map(\"posted_by\")",
      "reversedEntryId Int?      @unique @map(\"reversed_entry_id\")",
      "createdBy       Int?      @map(\"created_by\")",
      "updatedBy       Int?      @map(\"updated_by\")",
      "createdAt       DateTime  @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt       DateTime  @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "organization    Organization            @relation(fields: [organizationId], references: [id])",
      "reversedEntry   FinanceJournalEntry?    @relation(\"JournalReversal\", fields: [reversedEntryId], references: [id])",
      "reversalOf      FinanceJournalEntry?    @relation(\"JournalReversal\")",
      "lines           FinanceJournalLine[]",
      "bankTxnMatch    FinanceBankTransaction?",
      "expense         FinanceExpense?",
      "receivedPay     FinancePaymentReceived?",
      "madePay         FinancePaymentMade?"
    ],
    "attributes": [
      "@@unique([organizationId, entryNumber])",
      "@@index([organizationId, entryDate])",
      "@@index([organizationId, status])",
      "@@map(\"journal_entries\")",
      "@@schema(\"finance\")"
    ]
  },
  "FinanceJournalLine": {
    "fields": [
      "id             Int      @id @default(autoincrement())",
      "organizationId Int      @map(\"organization_id\")",
      "journalEntryId Int      @map(\"journal_entry_id\")",
      "accountId      Int      @map(\"account_id\")",
      "lineOrder      Int      @default(0) @map(\"line_order\")",
      "description    String?",
      "debit          Decimal  @default(0) @db.Decimal(15, 2)",
      "credit         Decimal  @default(0) @db.Decimal(15, 2)",
      "createdAt      DateTime @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt      DateTime @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "organization   Organization        @relation(fields: [organizationId], references: [id])",
      "journalEntry   FinanceJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)",
      "account        FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)"
    ],
    "attributes": [
      "@@index([organizationId, journalEntryId])",
      "@@index([organizationId, accountId])",
      "@@map(\"journal_lines\")",
      "@@schema(\"finance\")"
    ]
  },
  "FinanceBankAccount": {
    "fields": [
      "id             Int       @id @default(autoincrement())",
      "organizationId Int       @map(\"organization_id\")",
      "accountName    String    @map(\"account_name\")",
      "accountNumber  String    @map(\"account_number\")",
      "bankName       String    @map(\"bank_name\")",
      "ifscCode       String    @map(\"ifsc_code\")",
      "branchName     String?   @map(\"branch_name\")",
      "accountType    String    @default(\"CURRENT\") @map(\"account_type\")",
      "currency       String    @default(\"INR\")",
      "openingBalance Decimal   @default(0) @map(\"opening_balance\") @db.Decimal(15, 2)",
      "currentBalance Decimal   @default(0) @map(\"current_balance\") @db.Decimal(15, 2)",
      "glAccountId    Int?      @map(\"gl_account_id\")",
      "isActive       Boolean   @default(true) @map(\"is_active\")",
      "createdBy      Int?      @map(\"created_by\")",
      "updatedBy      Int?      @map(\"updated_by\")",
      "createdAt      DateTime  @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt      DateTime  @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "deletedAt      DateTime? @map(\"deleted_at\") @db.Timestamptz(6)",
      "organization   Organization              @relation(fields: [organizationId], references: [id])",
      "glAccount      FinanceAccount?           @relation(fields: [glAccountId], references: [id])",
      "transactions   FinanceBankTransaction[]",
      "expenses       FinanceExpense[]",
      "paymentsRec    FinancePaymentReceived[]",
      "paymentsMade   FinancePaymentMade[]"
    ],
    "attributes": [
      "@@unique([organizationId, accountNumber])",
      "@@index([organizationId, isActive])",
      "@@map(\"bank_accounts\")",
      "@@schema(\"finance\")"
    ]
  },
  "FinanceBankTransaction": {
    "fields": [
      "id                    Int       @id @default(autoincrement())",
      "organizationId        Int       @map(\"organization_id\")",
      "bankAccountId         Int       @map(\"bank_account_id\")",
      "transactionDate       DateTime  @map(\"transaction_date\") @db.Date",
      "referenceNumber       String?   @map(\"reference_number\")",
      "description           String",
      "transactionType       String    @map(\"transaction_type\")",
      "amount                Decimal   @db.Decimal(15, 2)",
      "balanceAfter          Decimal?  @map(\"balance_after\") @db.Decimal(15, 2)",
      "isReconciled          Boolean   @default(false) @map(\"is_reconciled\")",
      "reconciledAt          DateTime? @map(\"reconciled_at\") @db.Timestamptz(6)",
      "matchedJournalEntryId Int?      @unique @map(\"matched_journal_entry_id\")",
      "createdBy             Int?      @map(\"created_by\")",
      "createdAt             DateTime  @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt             DateTime  @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "organization          Organization         @relation(fields: [organizationId], references: [id])",
      "bankAccount           FinanceBankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)",
      "matchedEntry          FinanceJournalEntry? @relation(fields: [matchedJournalEntryId], references: [id])"
    ],
    "attributes": [
      "@@index([organizationId, bankAccountId, transactionDate])",
      "@@index([organizationId, isReconciled])",
      "@@map(\"bank_transactions\")",
      "@@schema(\"finance\")"
    ]
  },
  "FinanceExpense": {
    "fields": [
      "id                Int       @id @default(autoincrement())",
      "organizationId    Int       @map(\"organization_id\")",
      "expenseNumber     String    @map(\"expense_number\")",
      "expenseTypeId     Int       @map(\"expense_type_id\")",
      "expenseDate       DateTime  @map(\"expense_date\") @db.Date",
      "amount            Decimal   @db.Decimal(15, 2)",
      "taxAmount         Decimal   @default(0) @map(\"tax_amount\") @db.Decimal(15, 2)",
      "netAmount         Decimal   @default(0) @map(\"net_amount\") @db.Decimal(15, 2)",
      "paymentModeId     Int?      @map(\"payment_mode_id\")",
      "bankAccountId     Int?      @map(\"bank_account_id\")",
      "vendorName        String?   @map(\"vendor_name\")",
      "notes             String?",
      "receiptUrl        String?   @map(\"receipt_url\")",
      "status            String    @default(\"PAID\")",
      "glAccountId       Int?      @map(\"gl_account_id\")",
      "journalEntryId    Int?      @unique @map(\"journal_entry_id\")",
      "hrExpenseClaimId  Int?      @unique @map(\"hr_expense_claim_id\")",
      "createdBy         Int?      @map(\"created_by\")",
      "updatedBy         Int?      @map(\"updated_by\")",
      "createdAt         DateTime  @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt         DateTime  @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "deletedAt         DateTime? @map(\"deleted_at\") @db.Timestamptz(6)",
      "organization      Organization           @relation(fields: [organizationId], references: [id])",
      "expenseType       FinanceMasterListItem  @relation(\"ExpenseCategory\", fields: [expenseTypeId], references: [id])",
      "paymentMode       FinanceMasterListItem? @relation(\"ExpensePaymentMode\", fields: [paymentModeId], references: [id])",
      "bankAccount       FinanceBankAccount?    @relation(fields: [bankAccountId], references: [id])",
      "glAccount         FinanceAccount?        @relation(fields: [glAccountId], references: [id])",
      "journalEntry      FinanceJournalEntry?   @relation(fields: [journalEntryId], references: [id])"
    ],
    "attributes": [
      "@@unique([organizationId, expenseNumber])",
      "@@index([organizationId, expenseDate])",
      "@@index([organizationId, expenseTypeId])",
      "@@map(\"expenses\")",
      "@@schema(\"finance\")"
    ]
  },
  "FinancePaymentReceived": {
    "fields": [
      "id                Int       @id @default(autoincrement())",
      "organizationId    Int       @map(\"organization_id\")",
      "paymentNumber     String    @map(\"payment_number\")",
      "paymentDate       DateTime  @map(\"payment_date\") @db.Date",
      "customerId        Int?      @map(\"customer_id\")",
      "customerName      String    @map(\"customer_name\")",
      "amount            Decimal   @db.Decimal(15, 2)",
      "allocatedAmount   Decimal   @default(0) @map(\"allocated_amount\") @db.Decimal(15, 2)",
      "unallocatedAmount Decimal   @default(0) @map(\"unallocated_amount\") @db.Decimal(15, 2)",
      "paymentModeId     Int       @map(\"payment_mode_id\")",
      "bankAccountId     Int?      @map(\"bank_account_id\")",
      "referenceNumber   String?   @map(\"reference_number\")",
      "invoiceReference  String?   @map(\"invoice_reference\")",
      "notes             String?",
      "status            String    @default(\"CONFIRMED\")",
      "journalEntryId    Int?      @unique @map(\"journal_entry_id\")",
      "createdBy         Int?      @map(\"created_by\")",
      "updatedBy         Int?      @map(\"updated_by\")",
      "createdAt         DateTime  @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt         DateTime  @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "deletedAt         DateTime? @map(\"deleted_at\") @db.Timestamptz(6)",
      "organization      Organization                        @relation(fields: [organizationId], references: [id])",
      "customer          Account?                            @relation(fields: [customerId], references: [id])",
      "paymentMode       FinanceMasterListItem               @relation(\"PaymentReceivedMode\", fields: [paymentModeId], references: [id])",
      "bankAccount       FinanceBankAccount?                 @relation(fields: [bankAccountId], references: [id])",
      "journalEntry      FinanceJournalEntry?                @relation(fields: [journalEntryId], references: [id])",
      "allocations       FinancePaymentReceivedAllocation[]"
    ],
    "attributes": [
      "@@unique([organizationId, paymentNumber])",
      "@@index([organizationId, customerId])",
      "@@index([organizationId, paymentDate])",
      "@@map(\"payments_received\")",
      "@@schema(\"finance\")"
    ]
  },
  "FinancePaymentReceivedAllocation": {
    "fields": [
      "id                Int      @id @default(autoincrement())",
      "organizationId    Int      @map(\"organization_id\")",
      "paymentReceivedId Int      @map(\"payment_received_id\")",
      "invoiceReference  String   @map(\"invoice_reference\")",
      "allocatedAmount   Decimal  @map(\"allocated_amount\") @db.Decimal(15, 2)",
      "allocationDate    DateTime @default(now()) @map(\"allocation_date\") @db.Timestamptz(6)",
      "notes             String?",
      "createdAt         DateTime @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt         DateTime @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "organization      Organization           @relation(fields: [organizationId], references: [id])",
      "paymentReceived   FinancePaymentReceived @relation(fields: [paymentReceivedId], references: [id], onDelete: Cascade)"
    ],
    "attributes": [
      "@@index([organizationId, paymentReceivedId])",
      "@@index([organizationId, invoiceReference])",
      "@@map(\"payment_received_allocations\")",
      "@@schema(\"finance\")"
    ]
  },
  "FinancePaymentMade": {
    "fields": [
      "id                   Int       @id @default(autoincrement())",
      "organizationId       Int       @map(\"organization_id\")",
      "paymentNumber        String    @map(\"payment_number\")",
      "paymentDate          DateTime  @map(\"payment_date\") @db.Date",
      "vendorName           String    @map(\"vendor_name\")",
      "amount               Decimal   @db.Decimal(15, 2)",
      "paymentModeId        Int       @map(\"payment_mode_id\")",
      "bankAccountId        Int?      @map(\"bank_account_id\")",
      "referenceNumber      String?   @map(\"reference_number\")",
      "billReference        String?   @map(\"bill_reference\")",
      "scmSupplierPaymentId Int?      @unique @map(\"scm_supplier_payment_id\")",
      "notes                String?",
      "status               String    @default(\"CONFIRMED\")",
      "journalEntryId       Int?      @unique @map(\"journal_entry_id\")",
      "createdBy            Int?      @map(\"created_by\")",
      "updatedBy            Int?      @map(\"updated_by\")",
      "createdAt            DateTime  @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt            DateTime  @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "deletedAt            DateTime? @map(\"deleted_at\") @db.Timestamptz(6)",
      "organization         Organization          @relation(fields: [organizationId], references: [id])",
      "paymentMode          FinanceMasterListItem @relation(\"PaymentMadeMode\", fields: [paymentModeId], references: [id])",
      "bankAccount          FinanceBankAccount?   @relation(fields: [bankAccountId], references: [id])",
      "journalEntry         FinanceJournalEntry?  @relation(fields: [journalEntryId], references: [id])",
      "scmPayment           ScmSupplierPayment?   @relation(fields: [scmSupplierPaymentId], references: [id])"
    ],
    "attributes": [
      "@@unique([organizationId, paymentNumber])",
      "@@index([organizationId, paymentDate])",
      "@@map(\"payments_made\")",
      "@@schema(\"finance\")"
    ]
  },
  "FinanceGstEntry": {
    "fields": [
      "id                 Int      @id @default(autoincrement())",
      "organizationId     Int      @map(\"organization_id\")",
      "gstin              String",
      "period             String   /// e.g. \"2026-10\"",
      "entryType          String   @map(\"entry_type\")",
      "sourceType         String   @map(\"source_type\")",
      "sourceId           Int?     @map(\"source_id\")",
      "sourceReference    String   @map(\"source_reference\")",
      "hsnSacCode         String?  @map(\"hsn_sac_code\")",
      "taxableAmount      Decimal  @map(\"taxable_amount\") @db.Decimal(15, 2)",
      "cgstRate           Decimal  @default(0) @map(\"cgst_rate\") @db.Decimal(5, 2)",
      "cgstAmount         Decimal  @default(0) @map(\"cgst_amount\") @db.Decimal(15, 2)",
      "sgstRate           Decimal  @default(0) @map(\"sgst_rate\") @db.Decimal(5, 2)",
      "sgstAmount         Decimal  @default(0) @map(\"sgst_amount\") @db.Decimal(15, 2)",
      "igstRate           Decimal  @default(0) @map(\"igst_rate\") @db.Decimal(5, 2)",
      "igstAmount         Decimal  @default(0) @map(\"igst_amount\") @db.Decimal(15, 2)",
      "totalTaxAmount     Decimal  @map(\"total_tax_amount\") @db.Decimal(15, 2)",
      "isProformaExcluded Boolean  @default(false) @map(\"is_proforma_excluded\")",
      "status             String   @default(\"ACTIVE\")",
      "createdBy          Int?     @map(\"created_by\")",
      "createdAt          DateTime @default(now()) @map(\"created_at\") @db.Timestamptz(6)",
      "updatedAt          DateTime @updatedAt @map(\"updated_at\") @db.Timestamptz(6)",
      "organization       Organization @relation(fields: [organizationId], references: [id])"
    ],
    "attributes": [
      "@@index([organizationId, period, entryType])",
      "@@index([organizationId, sourceReference])",
      "@@map(\"gst_entries\")",
      "@@schema(\"finance\")"
    ]
  }
}
