// TexaWave ERP — Prisma schema.
// Single source of truth for the data model (Docs/ARCHITECTURE.md §5). Only
// platform tables exist so far (auth/tenancy/RBAC/teams) plus one fixture
// table (`Tag`) backing the reference feature — see
// apps/api/src/modules/_reference/tags/. Business-module tables are not part
// of this foundation work.
//
// Primary keys are auto-incrementing `Int`, not UUID (Docs/ARCHITECTURE.md
// §5.1 / Docs/CODING_STANDARDS.md §2) — `BigInt` is reserved for
// `audit_logs`/`status_history` only, neither of which exists yet.

// "prisma-client-js" (the classic generator), not the newer "prisma-client"
// TS-native generator: the newer one emits raw .ts with no build step of its
// own, which only a TS-aware runtime (tsx/ts-node/vitest) can load — plain
// `node` (used by `start:prod`, and by any tool further down the chain that
// runs compiled output) fails with ERR_UNKNOWN_FILE_EXTENSION on it. The
// classic generator emits ready-to-run compiled JS + .d.ts, so every
// consumer in this repo (vitest, swc/tsc-built apps/api, plain node) can
// load it uniformly with zero extra build step here.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The tenant root. Single-organization, internal-only app — one row,
/// seeded once (Docs/ARCHITECTURE.md — Multi-tenancy decision). Kept on
/// every tenant table for schema consistency even though it's a constant,
/// not a live dimension.
model Organization {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdBy Int?      @map("created_by")
  updatedBy Int?      @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users           User[]
  roles           Role[]
  tags            Tag[]
  teams           Team[]
  departments     Department[]
  userTeamAccess  UserTeamAccess[]

  @@map("organizations")
}

model User {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  email          String
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization        Organization         @relation(fields: [organizationId], references: [id])
  userRoles           UserRole[]
  ledTeams            Team[]               @relation("TeamLead")
  teamAccess          UserTeamAccess[]
  passwordResetTokens PasswordResetToken[]

  // Email only needs to be unique WITHIN an organization — the same person's
  // email can legitimately appear at two different client organizations.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

/// Global catalog, seeded once. Permission strings: `<module>.<entity>.<action>`
/// or `<module>.<entity>.<action>.<scope>` for anything team-scoped, `scope`
/// being `own`|`team`|`all` (Docs/CODING_STANDARDS.md §2).
model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   Int?     @map("created_by")
  updatedBy   Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Roles are per-organization — each client can shape its own roles against
/// the global permission catalog.
model Role {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      Int?     @map("created_by")
  updatedBy      Int?     @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

/// Unlike most join tables, this one carries the full §5.1 audit baseline
/// deliberately: the row IS the permission-grant record — "who granted this
/// permission to this role, and when" — and `isActive` lets a grant be
/// revoked/restored without losing that history (never hard-deleted; see
/// apps/api/src/modules/settings/roles/roles.repository.ts).
model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Same rationale as `RolePermission` — the row is the role-assignment
/// record, so it keeps the full audit baseline rather than being treated as
/// a throwaway pivot table.
model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdBy Int?     @map("created_by")
  updatedBy Int?     @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Sits above Team — see Docs/ARCHITECTURE.md §11 (Changelog, 2026-09-22)
/// for why this landed now, ahead of the RBAC module, so RBAC can build on
/// it rather than retrofit it later. `Team.departmentId` is nullable and NOT
/// required/backfilled yet — don't treat every Team as having a Department
/// until a follow-up migration makes it required and this comment is
/// removed.
model Department {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  name           String
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  teams        Team[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

/// Teams — the real access boundary for HR/team-scoped data
/// (Docs/ARCHITECTURE.md §5.5, §7A). Seed rows (Software/Mechanical/
/// Electrical) come from packages/database/prisma/seed.ts, not a migration
/// data statement.
model Team {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  departmentId   Int?      @map("department_id")
  name           String
  code           String
  leadUserId     Int?      @map("lead_user_id")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])
  lead         User?            @relation("TeamLead", fields: [leadUserId], references: [id])
  userAccess   UserTeamAccess[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("teams")
}

/// User↔team membership. Most users: one row, their own team, `isLead:
/// false`. A team lead: one row, their team, `isLead: true`. HR/Admin: no
/// rows needed — they hold a `.all`-scoped permission and bypass the team
/// filter entirely (Docs/ARCHITECTURE.md §5.5, Docs/CODING_STANDARDS.md
/// §10a).
model UserTeamAccess {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  userId         Int       @map("user_id")
  teamId         Int       @map("team_id")
  isLead         Boolean   @default(false) @map("is_lead")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  team         Team         @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
  @@index([organizationId])
  @@index([teamId])
  @@map("user_team_access")
}

/// Password-reset flow. Not org/team-scoped — looked up directly by
/// tokenHash, same way Redis refresh-token keys aren't org-scoped either.
/// Only the hash is ever persisted; the raw token is emailed to the user and
/// never stored (Docs' auth story — never store a directly-usable secret).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdBy Int?      @map("created_by")
  updatedBy Int?      @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// FIXTURE table backing the reference feature
/// (apps/api/src/modules/_reference/tags/) — demonstrates the §5.1 baseline
/// columns end to end. Not a real business concept; delete when a real module
/// needs the pattern spot and this is no longer needed as a teaching example.
model Tag {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  name           String
  colorToken     String    @default("gray") @map("color_token")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}
