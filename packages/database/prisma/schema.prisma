// TexaWave ERP — Prisma schema.
// Single source of truth for the data model (Docs/ARCHITECTURE.md §5). Only
// platform tables exist so far (auth/tenancy/RBAC/teams) plus one fixture
// table (`Tag`) backing the reference feature — see
// apps/api/src/modules/_reference/tags/. Business-module tables are not part
// of this foundation work.
//
// Primary keys are auto-incrementing `Int`, not UUID (Docs/ARCHITECTURE.md
// §5.1 / Docs/CODING_STANDARDS.md §2) — `BigInt` is reserved for
// `audit_logs`/`status_history` only, neither of which exists yet.

// "prisma-client-js" (the classic generator), not the newer "prisma-client"
// TS-native generator: the newer one emits raw .ts with no build step of its
// own, which only a TS-aware runtime (tsx/ts-node/vitest) can load — plain
// `node` (used by `start:prod`, and by any tool further down the chain that
// runs compiled output) fails with ERR_UNKNOWN_FILE_EXTENSION on it. The
// classic generator emits ready-to-run compiled JS + .d.ts, so every
// consumer in this repo (vitest, swc/tsc-built apps/api, plain node) can
// load it uniformly with zero extra build step here.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Postgres schema-per-module split (Docs/PLATFORM_SCHEMA_SPLIT_PLAN.md). Every
// model below MUST carry an @@schema(...) — Prisma's multiSchema mode is
// all-or-nothing once `schemas` is set here (Prisma 6.19: multiSchema is GA,
// not a previewFeature — listing it as one is deprecated, confirmed by a
// `prisma generate` warning during this rehearsal). scm/crm/finance are
// deliberately NOT listed yet: Prisma requires every listed schema to be used
// by at least one model, so a future module's schema name is added here only
// when that module gets its first model (plan §2) — never pre-created empty.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "hr"]
}

/// The tenant root. Single-organization, internal-only app — one row,
/// seeded once (Docs/ARCHITECTURE.md — Multi-tenancy decision). Kept on
/// every tenant table for schema consistency even though it's a constant,
/// not a live dimension.
model Organization {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdBy Int?      @map("created_by")
  updatedBy Int?      @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users                   User[]
  roles                   Role[]
  tags                    Tag[]
  teams                   Team[]
  departments             Department[]
  userTeamAccess          UserTeamAccess[]
  approvals               Approval[]
  employeePersonalDetails EmployeePersonalDetail[]
  employeeBankDetails     EmployeeBankDetail[]
  employeeFamilyMembers   EmployeeFamilyMember[]
  employeeExperiences     EmployeeExperience[]
  employeeDocuments       EmployeeDocument[]
  auditLogs               AuditLog[]
  designations            Designation[]
  employmentTypes         EmploymentType[]
  workLocations           WorkLocation[]
  locationPrivileges      EmployeeLocationPrivilege[]
  officeNetworkAddresses  OfficeNetworkAddress[]
  employees               Employee[]
  employeeStatusHistory   EmployeeStatusHistory[]
  documentSequences       DocumentSequence[]
  shifts                  Shift[]
  shiftAssignments        ShiftAssignment[]
  holidays                Holiday[]
  leaveTypes              LeaveType[]
  leaveRequests           LeaveRequest[]
  leaveEntitlements       LeaveEntitlement[]
  leaveDelegations        LeaveApprovalDelegation[]
  expenseClaims           ExpenseClaim[]
  exitRequests            ExitRequest[]
  tasks                   Task[]
  tickets                 Ticket[]
  ticketComments          TicketComment[]
  weeklyOffRules          WeeklyOffRule[]
  menuItems               MenuItem[]
  attendanceRecords       AttendanceRecord[]
  attendanceCorrections   AttendanceCorrection[]
  attendanceMonthLocks    AttendanceMonthLock[]
  notifications           Notification[]
  revisionLetters         RevisionLetter[]
  promotionLetters        PromotionLetter[]
  interviews              Interview[]
  offerLetters            OfferLetter[]
  employeeProfiles        EmployeeProfile[]
  employeeSensitiveInfos  EmployeeSensitiveInfo[]
  employeeAddresses       EmployeeAddress[]
  employeeGovernmentIds   EmployeeGovernmentId[]
  payrollPeriods        PayrollPeriod[]
  payrollRuns           PayrollRun[]
  payrollEntries        PayrollEntry[]
  payrollEarnings       PayrollEarning[]
  payrollDeductions     PayrollDeduction[]
  employeeSalaries      EmployeeSalary[]
  payrollSetting        PayrollSetting?
  employeePfProfiles    EmployeePfProfile[]
  pfContributions       PfContribution[]
  employeeEsiProfiles   EmployeeEsiProfile[]
  esiContributions      EsiContribution[]
  employeeLoans         EmployeeLoan[]
  loanRepayments        LoanRepayment[]
  loanSkipRequests      LoanSkipRequest[]
  employeeBonuses       EmployeeBonus[]
  payslips              Payslip[]
  paymentBatches        PaymentBatch[]
  payrollPayments       PayrollPayment[]
  salaryComponents          SalaryComponent[]
  salaryTemplates           SalaryTemplate[]
  employeeSalaryComponents  EmployeeSalaryComponent[]
  professionalTaxSlabs      ProfessionalTaxSlab[]
  ptLocationStates          PtLocationState[]
  incomeTaxRegimes          IncomeTaxRegime[]
  employeeTaxDeclarations   EmployeeTaxDeclaration[]
  loanPrepayments           LoanPrepayment[]
  organizationSetting       OrganizationSetting?
  userPreferences           UserPreference[]
  exchangeRates             ExchangeRate[]

  @@map("organizations")
  @@schema("platform")
}

model User {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  email              String
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  fullName           String    @map("full_name")
  isActive           Boolean   @default(true) @map("is_active")
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organization        Organization            @relation(fields: [organizationId], references: [id])
  userRoles           UserRole[]
  ledTeams            Team[]                  @relation("TeamLead")
  teamAccess          UserTeamAccess[]
  auditLogs           AuditLog[]
  employee            Employee?
  statusChanges       EmployeeStatusHistory[]
  leaveRequested      LeaveRequest[]          @relation("LeaveRequester")
  leaveDecided        LeaveRequest[]          @relation("LeaveDecider")
  leaveFirstDecided   LeaveRequest[]          @relation("LeaveFirstDecider")
  leaveCancelled      LeaveRequest[]          @relation("LeaveCanceller")
  leaveDelegatedFrom  LeaveApprovalDelegation[] @relation("LeaveDelegator")
  leaveDelegatedTo    LeaveApprovalDelegation[] @relation("LeaveDelegate")
  expenseClaimsRequested ExpenseClaim[]       @relation("ExpenseClaimRequester")
  expenseClaimsDecided   ExpenseClaim[]       @relation("ExpenseClaimDecider")
  exitRequestsRequested  ExitRequest[]        @relation("ExitRequestRequester")
  exitRequestsDecided    ExitRequest[]        @relation("ExitRequestDecider")
  tasksAssignedByMe   Task[]                  @relation("TaskAssignedBy")
  tasksApprovedByMe   Task[]                  @relation("TaskApprovedBy")
  ticketsRaisedByMe   Ticket[]                @relation("TicketRaisedBy")
  ticketCommentsByMe  TicketComment[]         @relation("TicketCommentByHr")
  attendanceCorrectionsRequested AttendanceCorrection[] @relation("AttendanceCorrectionRequester")
  attendanceCorrectionsDecided   AttendanceCorrection[] @relation("AttendanceCorrectionDecider")
  attendanceMonthLocksSubmitted  AttendanceMonthLock[]  @relation("AttendanceMonthLockSubmitter")
  attendanceMonthLocksDecided    AttendanceMonthLock[]  @relation("AttendanceMonthLockDecider")
  notifications                  Notification[]
  passwordResetTokens PasswordResetToken[]
  approvalsRequested  Approval[]              @relation("ApprovalRequester")
  approvalsDecided    Approval[]              @relation("ApprovalDecider")
  payrollPeriodsFinalized   PayrollPeriod[]         @relation("PayrollPeriodFinalizer")
  payrollRunsCreated        PayrollRun[]            @relation("PayrollRunCreator")
  payrollRunsApproved       PayrollRun[]            @relation("PayrollRunApprover")
  loanSkipRequestsRequested LoanSkipRequest[]       @relation("LoanSkipRequester")
  loanSkipRequestsApproved  LoanSkipRequest[]       @relation("LoanSkipApprover")
  bonusesApproved           EmployeeBonus[]         @relation("BonusApprover")
  paymentBatchesGenerated   PaymentBatch[]          @relation("PaymentBatchGenerator")
  payrollPeriodsReopened    PayrollPeriod[]         @relation("PayrollPeriodReopener")
  loansApproved             EmployeeLoan[]          @relation("LoanApprover")
  loansHrReviewed           EmployeeLoan[]          @relation("LoanHrReviewer")
  loanPrepaymentsRequested  LoanPrepayment[]        @relation("LoanPrepaymentRequester")
  loanPrepaymentsDecided    LoanPrepayment[]        @relation("LoanPrepaymentDecider")
  taxDeclarationsVerified   EmployeeTaxDeclaration[] @relation("TaxDeclarationVerifier")
  preference                UserPreference?

  // Email only needs to be unique WITHIN an organization — the same person's
  // email can legitimately appear at two different client organizations.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
  @@schema("platform")
}

/// Global catalog, seeded once. Permission strings: `<module>.<entity>.<action>`
/// or `<module>.<entity>.<action>.<scope>` for anything team-scoped, `scope`
/// being `own`|`team`|`all` (Docs/CODING_STANDARDS.md §2).
model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   Int?     @map("created_by")
  updatedBy   Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("platform")
}

/// Roles are per-organization — each client can shape its own roles against
/// the global permission catalog.
/// `is_system` marks the roles the platform ships (Super Admin, HR Manager,
/// Team Lead, Employee): their permissions are editable, but they cannot be
/// renamed or deactivated. `version` is the optimistic lock for every change
/// to the role or its grants (Docs/ARCHITECTURE.md §11, 2026-10-11).
model Role {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  version        Int      @default(1)
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      Int?     @map("created_by")
  updatedBy      Int?     @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
  @@schema("platform")
}

/// Unlike most join tables, this one carries the full §5.1 audit baseline
/// deliberately: the row IS the permission-grant record — "who granted this
/// permission to this role, and when" — and `isActive` lets a grant be
/// revoked/restored without losing that history (never hard-deleted; see
/// apps/api/src/modules/settings/roles/roles.repository.ts).
model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("platform")
}

/// Same rationale as `RolePermission` — the row is the role-assignment
/// record, so it keeps the full audit baseline rather than being treated as
/// a throwaway pivot table.
model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdBy Int?     @map("created_by")
  updatedBy Int?     @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("platform")
}

/// Sits above Team — see Docs/ARCHITECTURE.md §11 (Changelog, 2026-09-22)
/// for why this landed now, ahead of the RBAC module, so RBAC can build on
/// it rather than retrofit it later. `Team.departmentId` is nullable and NOT
/// required/backfilled yet — don't treat every Team as having a Department
/// until a follow-up migration makes it required and this comment is
/// removed.
model Department {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  name           String
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  teams        Team[]
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
  @@schema("platform")
}

/// Teams — the real access boundary for HR/team-scoped data
/// (Docs/ARCHITECTURE.md §5.5, §7A). Seed rows (Software/Mechanical/
/// Electrical) come from packages/database/prisma/seed.ts, not a migration
/// data statement.
model Team {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  departmentId   Int?      @map("department_id")
  name           String
  code           String
  leadUserId     Int?      @map("lead_user_id")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization          Organization             @relation(fields: [organizationId], references: [id])
  department            Department?              @relation(fields: [departmentId], references: [id])
  lead                  User?                    @relation("TeamLead", fields: [leadUserId], references: [id])
  userAccess            UserTeamAccess[]
  personalDetails       EmployeePersonalDetail[]
  bankDetails           EmployeeBankDetail[]
  familyMembers         EmployeeFamilyMember[]
  experiences           EmployeeExperience[]
  documents             EmployeeDocument[]
  employees             Employee[]
  shiftAssignments      ShiftAssignment[]
  weeklyOffRules        WeeklyOffRule[]
  employeeAddresses     EmployeeAddress[]
  employeeGovernmentIds EmployeeGovernmentId[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("teams")
  @@schema("platform")
}

/// User↔team membership. Most users: one row, their own team, `isLead:
/// false`. A team lead: one row, their team, `isLead: true`. HR/Admin: no
/// rows needed — they hold a `.all`-scoped permission and bypass the team
/// filter entirely (Docs/ARCHITECTURE.md §5.5, Docs/CODING_STANDARDS.md
/// §10a).
model UserTeamAccess {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  userId         Int       @map("user_id")
  teamId         Int       @map("team_id")
  isLead         Boolean   @default(false) @map("is_lead")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  team         Team         @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
  @@index([organizationId])
  @@index([teamId])
  @@map("user_team_access")
  @@schema("platform")
}

/// Password-reset flow. Not org/team-scoped — looked up directly by
/// tokenHash, same way Redis refresh-token keys aren't org-scoped either.
/// Only the hash is ever persisted; the raw token is emailed to the user and
/// never stored (Docs' auth story — never store a directly-usable secret).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdBy Int?      @map("created_by")
  updatedBy Int?      @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
  @@schema("platform")
}

/// FIXTURE table backing the reference feature
/// (apps/api/src/modules/_reference/tags/) — demonstrates the §5.1 baseline
/// columns end to end. Not a real business concept; delete when a real module
/// needs the pattern spot and this is no longer needed as a teaching example.
model Tag {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  name           String
  colorToken     String    @default("gray") @map("color_token")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
  @@schema("platform")
}

/// Navigation menu item model — filtered by resolved permissions server-side
/// (Docs/ARCHITECTURE.md §4, §6). Parent-child hierarchy supported.
model MenuItem {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  label          String
  path           String?
  icon           String?
  order          Int       @default(0)
  parentId       Int?      @map("parent_id")
  permission     String? // Permission code required to view this item (null = accessible by all authenticated users)
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       MenuItem?    @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]   @relation("MenuHierarchy")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
  @@map("menu_items")
  @@schema("platform")
}

/// APPEND-ONLY audit trail (apps/api/src/platform/audit, reports/AUDIT_PLATFORM_DESIGN.md).
/// Deliberate exception to the §5.1 baseline: no updated_at / deleted_at /
/// is_active / updated_by, because this table must never be edited or
/// soft-deleted. The migration installs triggers that reject UPDATE, DELETE
/// and TRUNCATE. `before`/`after` are allow-listed snapshots with secrets
/// stripped by the writer (audit-redaction.ts) — never raw rows.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  actorUserId    Int?     @map("actor_user_id")
  /// user | system (CHECK in the migration); a system actor has no user id.
  actorType      String   @default("user") @map("actor_type")
  entityType     String   @map("entity_type")
  entityId       BigInt   @map("entity_id")
  action         String
  before         Json?
  after          Json?
  reason         String?
  ip             String?  @db.VarChar(64)
  correlationId  String?  @map("correlation_id")
  at             DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId, id(sort: Desc)], map: "audit_logs_entity_history_idx")
  @@index([organizationId, actorUserId, id(sort: Desc)], map: "audit_logs_actor_idx")
  @@index([organizationId, at], map: "audit_logs_at_idx")
  @@map("audit_logs")
  @@schema("platform")
}

model OrganizationSetting {
  id                     Int       @id @default(autoincrement())
  organizationId         Int       @unique @map("organization_id")
  theme                  String    @default("system")
  density                String    @default("comfortable")
  country                String    @default("IN")
  locale                 String    @default("en-IN")
  timezone               String    @default("Asia/Kolkata")
  dateFormat             String    @default("DD/MM/YYYY") @map("date_format")
  timeFormat             String    @default("12h") @map("time_format")
  baseCurrency           String    @default("INR") @map("base_currency")
  currencySymbolPosition String    @default("before") @map("currency_symbol_position")
  numberFormat           String    @default("indian") @map("number_format")
  fiscalYearStartMonth   Int       @default(4) @map("fiscal_year_start_month")
  customFields           Json      @default("{}") @map("custom_fields")
  createdBy              Int?      @map("created_by")
  updatedBy              Int?      @map("updated_by")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_settings")
  @@schema("platform")
}

model UserPreference {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  organizationId  Int       @map("organization_id")
  theme           String?
  density         String?
  locale          String?
  timezone        String?
  dateFormat      String?   @map("date_format")
  timeFormat      String?   @map("time_format")
  displayCurrency String?   @map("display_currency")
  customFields    Json      @default("{}") @map("custom_fields")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("user_preferences")
  @@schema("platform")
}

model ExchangeRate {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  fromCurrency   String    @map("from_currency") @db.VarChar(3)
  toCurrency     String    @map("to_currency") @db.VarChar(3)
  rate           Decimal   @db.Decimal(18, 6)
  effectiveDate  DateTime  @map("effective_date") @db.Date
  source         String    @default("manual") @db.VarChar(64)
  isHistorical   Boolean   @default(false) @map("is_historical")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, fromCurrency, toCurrency, effectiveDate])
  @@index([organizationId, fromCurrency, toCurrency])
  @@map("exchange_rates")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// HR master data (apps/api/src/modules/master-data/*). Business tables follow
// the §5.1 baseline; timestamps are `timestamptz` (Docs/ARCHITECTURE.md §5.1)
// and codes are stored upper-case. Rows are deactivated (`is_active = false`),
// never deleted: historical employee/leave records keep pointing at them.
// ---------------------------------------------------------------------------

model Designation {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  name           String
  description    String?
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  employees        Employee[]
  promotionLetters PromotionLetter[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("designations")
  @@schema("hr")
}

/// Master data, not an enum: the approved starting set (Permanent, Contract,
/// Temporary, Intern) is inserted by the migration, and HR may add more.
/// `probation_days` / `notice_days` are NULLABLE and deliberately NOT read by
/// any code path yet — whether probation/notice rules exist is an open
/// business decision (reports/HR_IMPLEMENTATION_READINESS.md §3.1).
model EmploymentType {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  name           String
  description    String?
  probationDays  Int?      @map("probation_days")
  noticeDays     Int?      @map("notice_days")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("employment_types")
  @@schema("hr")
}

/// Where an employee works / a holiday applies. Optional everywhere it is
/// referenced. Added because the brief asks for location scope; the old ERP
/// has no location master, so this stays minimal.
model WorkLocation {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  name           String
  description    String?
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  employees      Employee[]
  holidays       Holiday[]
  weeklyOffRules WeeklyOffRule[]
  ptLocationState PtLocationState?

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("work_locations")
  @@schema("hr")
}

// ---------------------------------------------------------------------------
// Employees (apps/api/src/modules/hr/employees)
// ---------------------------------------------------------------------------

/// Per-organization counters for human-readable document numbers
/// (Docs/ARCHITECTURE.md §5.3). Employee codes use doc_type = 'employee',
/// prefix 'EMP-', padding 6 → EMP-000001. The counter row is locked by the
/// UPDATE that increments it, inside the same transaction that inserts the
/// employee: concurrent creators queue on that row lock, and a rolled-back
/// create also rolls back its number (no gaps, no duplicates).
model DocumentSequence {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  docType        String    @map("doc_type")
  prefix         String
  padding        Int       @default(6)
  /// The NEXT number to hand out.
  nextNumber     Int       @default(1) @map("next_number")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, docType])
  @@map("document_sequences")
  @@schema("platform")
}

/// The person record every HR/attendance/leave table points at. Always keyed
/// by `id`, never by employee_code (the human label).
///
/// It stores NO credentials: a login is a `users` row, linked 1:1 through the
/// optional, unique `user_id`. `status` is ACTIVE / INACTIVE / RESIGNED /
/// TERMINATED (CHECK in the migration); RESIGNED and TERMINATED are terminal
/// except through the audited correction workflow. `is_active` mirrors
/// `status = 'ACTIVE'` (CHECK). `version` is an optimistic-lock counter.
/// Invariants Prisma cannot express (status/exit-date consistency, immutable
/// code and organization, reporting-line cycles) are in the migration.
model Employee {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  employeeCode     String    @map("employee_code")
  userId           Int?      @unique @map("user_id")
  fullName         String    @map("full_name")
  workEmail        String?   @map("work_email")
  phone            String?
  teamId           Int       @map("team_id")
  departmentId     Int?      @map("department_id")
  designationId    Int       @map("designation_id")
  employmentTypeId Int       @map("employment_type_id")
  workLocationId   Int?      @map("work_location_id")
  reportsToId      Int?      @map("reports_to_id")
  status           String    @default("ACTIVE")
  onboardingStatus String    @default("PENDING_ACTIVATION") @map("onboarding_status")
  /// HR's review of the submitted onboarding profile, independent of
  /// `onboarding_status` (Docs/ARCHITECTURE.md §7): NOT_SUBMITTED |
  /// PENDING_REVIEW | APPROVED | CHANGES_REQUESTED (CHECK in the migration).
  onboardingReviewStatus String    @default("NOT_SUBMITTED") @map("onboarding_review_status")
  onboardingSubmittedAt  DateTime? @map("onboarding_submitted_at") @db.Timestamptz(6)
  onboardingReviewedAt   DateTime? @map("onboarding_reviewed_at") @db.Timestamptz(6)
  onboardingReviewedBy   Int?      @map("onboarding_reviewed_by")
  onboardingReviewNote   String?   @map("onboarding_review_note")
  dateOfJoining    DateTime  @map("date_of_joining") @db.Date
  probationEndDate DateTime? @map("probation_end_date") @db.Date
  confirmationDate DateTime? @map("confirmation_date") @db.Date
  referredBy       String?   @map("referred_by")
  workDomain       String?   @map("work_domain")
  dateOfExit       DateTime? @map("date_of_exit") @db.Date
  exitReason       String?   @map("exit_reason")
  version          Int       @default(1)
  customFields     Json      @default("{}") @map("custom_fields")
  isActive         Boolean   @default(true) @map("is_active")
  createdBy        Int?      @map("created_by")
  updatedBy        Int?      @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization          Organization               @relation(fields: [organizationId], references: [id])
  user                  User?                      @relation(fields: [userId], references: [id])
  team                  Team                       @relation(fields: [teamId], references: [id])
  department            Department?                @relation(fields: [departmentId], references: [id])
  designation           Designation                @relation(fields: [designationId], references: [id])
  employmentType        EmploymentType             @relation(fields: [employmentTypeId], references: [id])
  workLocation          WorkLocation?              @relation(fields: [workLocationId], references: [id])
  locationPrivilege     EmployeeLocationPrivilege?
  reportsTo             Employee?                  @relation("ReportingLine", fields: [reportsToId], references: [id])
  directReports         Employee[]                 @relation("ReportingLine")
  statusHistory         EmployeeStatusHistory[]
  shiftAssignments      ShiftAssignment[]
  leaveRequests         LeaveRequest[]
  leaveEntitlements     LeaveEntitlement[]
  expenseClaims         ExpenseClaim[]
  exitRequests          ExitRequest[]
  tasksAssigned         Task[]                     @relation("TaskAssignee")
  tasksCreated          Task[]                     @relation("TaskCreatedBy")
  tickets               Ticket[]                   @relation("TicketRequester")
  ticketComments        TicketComment[]            @relation("TicketCommentByEmployee")
  revisionLetters       RevisionLetter[]
  promotionLetters      PromotionLetter[]
  profile               EmployeeProfile?
  sensitiveInfo         EmployeeSensitiveInfo?
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  attendanceMonthLocks  AttendanceMonthLock[]
  personalDetail        EmployeePersonalDetail?
  bankDetail            EmployeeBankDetail?
  familyMembers         EmployeeFamilyMember[]
  experiences           EmployeeExperience[]
  documents             EmployeeDocument[]
  employeeAddresses     EmployeeAddress[]
  employeeGovernmentId  EmployeeGovernmentId?
  salaries         EmployeeSalary[]
  pfProfile        EmployeePfProfile?
  esiProfile       EmployeeEsiProfile?
  loans            EmployeeLoan[]
  bonuses          EmployeeBonus[]
  payrollEntries   PayrollEntry[]
  payslips         Payslip[]
  payrollPayments  PayrollPayment[]
  pfContributions  PfContribution[]
  esiContributions EsiContribution[]
  taxDeclarations  EmployeeTaxDeclaration[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([organizationId, onboardingReviewStatus])
  @@index([organizationId, teamId])
  @@index([organizationId, departmentId])
  @@index([organizationId, designationId])
  @@index([organizationId, employmentTypeId])
  @@index([organizationId, reportsToId])
  @@map("employees")
  @@schema("hr")
}

/// Append-only business record of every status change (and of the employee's
/// creation, from_status NULL). Complements — does not replace — the audit
/// trail: this is what HR/attendance/payroll query; audit_logs is forensics.
model EmployeeStatusHistory {
  id             BigInt   @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  employeeId     Int      @map("employee_id")
  fromStatus     String?  @map("from_status")
  toStatus       String   @map("to_status")
  /// transition | correction (CHECK in the migration)
  changeType     String   @default("transition") @map("change_type")
  effectiveDate  DateTime @map("effective_date") @db.Date
  reason         String?
  changedBy      Int      @map("changed_by")
  at             DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  changer      User         @relation(fields: [changedBy], references: [id])

  @@index([organizationId, employeeId, id(sort: Desc)], map: "employee_status_history_employee_idx")
  @@map("employee_status_history")
  @@schema("hr")
}

// ---------------------------------------------------------------------------
// Shifts (apps/api/src/modules/master-data/shifts, hr/shift-assignments)
// ---------------------------------------------------------------------------

/// A working-time template. Times are wall-clock "HH:MM" strings (no time
/// zone — the business time zone is an Attendance decision) with CHECKs in the
/// migration. `is_overnight` is DERIVED by the API (end earlier than start
/// means the shift crosses midnight) and enforced by a CHECK. `working_minutes`
/// is the expected working duration and can never exceed the span between
/// start and end.
///
/// Deliberately NOT here: break length, grace period, half-day or overtime
/// thresholds. They are unapproved attendance policy
/// (reports/HR_IMPLEMENTATION_READINESS.md §3.7 S-1); adding a nullable column
/// later is trivial, guessing a default is not.
model Shift {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  name           String
  description    String?
  startTime      String    @map("start_time") @db.VarChar(5)
  endTime        String    @map("end_time") @db.VarChar(5)
  isOvernight    Boolean   @map("is_overnight")
  workingMinutes Int       @map("working_minutes")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  assignments  ShiftAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("shifts")
  @@schema("hr")
}

/// Which shift an employee — or, as a default, a whole team — works over a
/// date range. Assignments are never overwritten: a change of shift ends the
/// old assignment and creates a new one, so history is kept. A mistaken
/// assignment is VOIDED (`is_active = false`), not deleted.
///
/// Exactly one of `employee_id` / `team_id` is set (CHECK). An exclusion
/// constraint per target (in the migration) forbids two active assignments
/// whose inclusive date ranges overlap — concurrency-safe, unlike a
/// check-then-insert in application code. `effective_to` NULL = open-ended.
model ShiftAssignment {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  shiftId        Int       @map("shift_id")
  employeeId     Int?      @map("employee_id")
  teamId         Int?      @map("team_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  reason         String?
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  shift        Shift        @relation(fields: [shiftId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])

  @@index([organizationId, shiftId])
  @@index([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, teamId, effectiveFrom])
  @@map("shift_assignments")
  @@schema("hr")
}

// ---------------------------------------------------------------------------
// HR calendar (apps/api/src/modules/hr/holidays, weekly-off-rules, calendar)
// ---------------------------------------------------------------------------

/// A non-working date for the organization, or — when `work_location_id` is set
/// — only for that location. The date and the scope are immutable; a wrong
/// entry is deactivated (kept for history) and re-entered. At most one active
/// holiday per date per scope (partial unique indexes in the migration).
model Holiday {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  holidayDate    DateTime  @map("holiday_date") @db.Date
  name           String
  description    String?
  workLocationId Int?      @map("work_location_id")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id])

  @@index([organizationId, holidayDate])
  @@map("holidays")
  @@schema("hr")
}

/// Which weekdays are non-working, for whom, and over which dates. NOTHING is
/// assumed and nothing is seeded — in particular Sunday is not special: a
/// weekly off exists only if someone creates a rule. Scope is the whole
/// organization (both ids NULL), one location, or one team (never both).
/// `days_of_week` uses ISO numbering (1 = Monday … 7 = Sunday).
///
/// Rules are never edited in place: a change ends the old rule and creates a
/// new one, so which days were off on any past date stays answerable; a
/// mistake is voided (`is_active = false`). An exclusion constraint forbids two
/// active rules of the SAME scope covering a common day. Which of several
/// applicable scopes wins (org vs location vs team) is an unresolved policy
/// question and is deliberately NOT decided here.
model WeeklyOffRule {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  name           String
  description    String?
  daysOfWeek     Int[]     @map("days_of_week")
  workLocationId Int?      @map("work_location_id")
  teamId         Int?      @map("team_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id])
  team         Team?         @relation(fields: [teamId], references: [id])

  @@index([organizationId, effectiveFrom])
  @@map("weekly_off_rules")
  @@schema("hr")
}

// ---------------------------------------------------------------------------
// Leave (apps/api/src/modules/hr/leave-types, hr/leave-requests)
// ---------------------------------------------------------------------------
// Types, requests (half-days, cancellation, resubmission, one- or two-level
// approval), per-employee entitlements and approval delegations. Balances are
// derived, never stored (Docs/HR_LEAVE.md §5). No leave types are seeded —
// the list of types is business data.

model LeaveType {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  name           String
  description    String?
  /** Paid leave draws on the balance; unpaid leave is not balance-limited. */
  isPaid            Boolean  @default(true) @map("is_paid")
  /** Default annual entitlement in days, accrued monthly (annual / 12 per month). */
  annualEntitlement Decimal  @default(0) @map("annual_entitlement") @db.Decimal(5, 1)
  /** Unused days carried into the next year are capped at this value. */
  carryForwardLimit Decimal  @default(0) @map("carry_forward_limit") @db.Decimal(5, 1)
  /** 1 = one approval (reporting manager or a scoped approver); 2 = the
   * reporting manager (or a scoped approver) first, then HR (`.all`). */
  approvalLevels Int       @default(1) @map("approval_levels")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id])
  requests     LeaveRequest[]
  entitlements LeaveEntitlement[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
  @@schema("hr")
}

/// A request for leave over an inclusive date range (whole days only).
///
/// Lifecycle: PENDING → APPROVED | REJECTED, both terminal. Once decided a
/// request never changes — enforced by a trigger, together with immutability
/// of everything the employee submitted. Whoever decides is recorded
/// (`decided_by`/`decided_at`), a rejection must carry a note (CHECK), and the
/// employee's own user can never be the decider (maker-checker: enforced by
/// the service and proven by tests — a CHECK cannot see that relationship).
/// An exclusion constraint forbids two PENDING/APPROVED requests of one
/// employee covering a common day.
model LeaveRequest {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  employeeId     Int       @map("employee_id")
  leaveTypeId    Int       @map("leave_type_id")
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  /** FULL, FIRST_HALF or SECOND_HALF (halves only on a single date). */
  dayPortion     String    @default("FULL") @map("day_portion")
  /** Working days consumed: weekly-offs and holidays excluded; half = 0.5. */
  leaveDays      Decimal   @default(0) @map("leave_days") @db.Decimal(4, 1)
  reason         String
  status         String    @default("PENDING")
  /** Copied from the leave type at (re)submission, so changing the type
   * never changes a request already in flight. */
  approvalLevels Int       @default(1) @map("approval_levels")
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationNote String?   @map("cancellation_note")
  /** Who cancelled: the employee, or HR (`hr.leave.cancel`). */
  cancelledBy      Int?      @map("cancelled_by")
  requestedBy    Int       @map("requested_by")
  /** First of two approvals (approval_levels = 2); status stays PENDING. */
  firstDecidedBy    Int?      @map("first_decided_by")
  firstDecidedAt    DateTime? @map("first_decided_at") @db.Timestamptz(6)
  firstDecisionNote String?   @map("first_decision_note")
  decidedBy      Int?      @map("decided_by")
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?   @map("decision_note")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])
  requester    User         @relation("LeaveRequester", fields: [requestedBy], references: [id])
  decider      User?        @relation("LeaveDecider", fields: [decidedBy], references: [id])
  firstDecider User?        @relation("LeaveFirstDecider", fields: [firstDecidedBy], references: [id])
  canceller    User?        @relation("LeaveCanceller", fields: [cancelledBy], references: [id])

  @@index([organizationId, employeeId, startDate])
  @@index([organizationId, status])
  @@index([organizationId, leaveTypeId])
  @@map("leave_requests")
  @@schema("hr")
}

/// A reporting manager's stand-in for leave approval over an inclusive date
/// range (e.g. while the manager is on leave). During the range the delegate
/// may decide what the delegator could decide AS REPORTING MANAGER — never
/// more: team/all approval still comes only from the delegate's own roles.
/// Not edited: a delegation is revoked (`is_active = false`) and re-created.
model LeaveApprovalDelegation {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  delegatorUserId Int       @map("delegator_user_id")
  delegateUserId  Int       @map("delegate_user_id")
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  reason          String?
  isActive        Boolean   @default(true) @map("is_active")
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  delegator    User         @relation("LeaveDelegator", fields: [delegatorUserId], references: [id])
  delegate     User         @relation("LeaveDelegate", fields: [delegateUserId], references: [id])

  @@index([organizationId, delegateUserId, startDate])
  @@index([organizationId, delegatorUserId])
  @@map("leave_approval_delegations")
  @@schema("hr")
}

// ---------------------------------------------------------------------------
// Expense claims (apps/api/src/modules/hr/expense-claims). Legacy:
// hr/expenseRequests in RTDB (ExpenseApprovals.tsx, MyExpenses.tsx). Three
// legacy statuses, six legacy categories, no edit/cancel/resubmit, no payment
// link. Decisions are final. See Docs/HR_LEGACY_PARITY.md §3.11.
// ---------------------------------------------------------------------------

/// One expense claim submitted by an employee and decided by HR.
model ExpenseClaim {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  employeeId     Int       @map("employee_id")
  expenseType    String    @map("expense_type")
  amount         Decimal   @db.Decimal(12, 2)
  expenseDate    DateTime  @map("expense_date") @db.Date
  description    String
  receiptRef     String?   @map("receipt_ref")
  status         String    @default("PENDING")
  requestedBy    Int       @map("requested_by")
  decidedBy      Int?      @map("decided_by")
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?   @map("decision_note")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  requester    User         @relation("ExpenseClaimRequester", fields: [requestedBy], references: [id])
  decider      User?        @relation("ExpenseClaimDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, expenseDate])
  @@index([organizationId, status])
  @@map("expense_claims")
  @@schema("hr")
}

// ---------------------------------------------------------------------------
// Exit requests (apps/api/src/modules/hr/exit-requests). Legacy: hr/exitRequests
// in RTDB (employee/ExitRequest.tsx, hr/ExitRequests.tsx). Five legacy statuses,
// no cancel/withdraw/resubmit. Creating or approving a request does NOT change
// the employee record; see Docs/HR_LEGACY_PARITY.md §3.8 (decision E2).
// ---------------------------------------------------------------------------

/// One resignation request submitted by an employee and managed by HR.
model ExitRequest {
  id                       Int       @id @default(autoincrement())
  organizationId           Int       @map("organization_id")
  employeeId               Int       @map("employee_id")
  status                   String    @default("SUBMITTED")
  reason                   String
  preferredLastWorkingDate DateTime  @map("preferred_last_working_date") @db.Date
  noticePeriodDays         Int       @default(30) @map("notice_period_days")
  additionalNotes          String?   @map("additional_notes")
  confirmedLastWorkingDate DateTime? @map("confirmed_last_working_date") @db.Date
  settlementStatus         String?   @map("settlement_status")
  hrNote                   String?   @map("hr_note")
  requestedBy              Int       @map("requested_by")
  decidedBy                Int?      @map("decided_by")
  decidedAt                DateTime? @map("decided_at") @db.Timestamptz(6)
  createdBy                Int?      @map("created_by")
  updatedBy                Int?      @map("updated_by")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  requester    User         @relation("ExitRequestRequester", fields: [requestedBy], references: [id])
  decider      User?        @relation("ExitRequestDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, createdAt])
  @@index([organizationId, status])
  @@map("exit_requests")
  @@schema("hr")
}

// ---------------------------------------------------------------------------
// Task Assignment (apps/api/src/modules/hr/tasks) — dedicated HR tasks, NOT
// the paused projects/tasks design (Docs/ARCHITECTURE.md §5): HR tasks have
// no project, carry priority, and go through an admin-approval step on
// completion. See Docs/HR_LEGACY_PARITY.md §3.9/§6 for the reuse decision.
// ---------------------------------------------------------------------------

/// One task, admin-assigned to an employee or self-created by one. `status`
/// is the four legacy values; `adminApproved` is only meaningful once
/// `status = DONE` (the decision-consistency check enforces this). A task is
/// never deleted (none in legacy) — cancellation is the closest equivalent
/// and, like every other status, is reversible by whoever can write tasks.
model Task {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  title              String
  description        String?
  assigneeId         Int       @map("assignee_id")
  assignedByUserId   Int       @map("assigned_by_user_id")
  createdByEmployeeId Int?     @map("created_by_employee_id")
  dueDate            DateTime  @map("due_date") @db.Date
  priority           String    @default("MEDIUM")
  status             String    @default("PENDING")
  isEmployeeCreated  Boolean   @default(false) @map("is_employee_created")
  requestToAdmin     Boolean   @default(false) @map("request_to_admin")
  adminApproved      Boolean   @default(false) @map("admin_approved")
  approvedByUserId   Int?      @map("approved_by_user_id")
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(6)
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id])
  assignee        Employee     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignedByUser  User         @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id])
  createdByEmployee Employee?  @relation("TaskCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  approvedByUser  User?        @relation("TaskApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, assigneeId, status])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@map("tasks")
  @@schema("hr")
}

/// One employee ticket (legacy `hr/tickets`). Raised by the employee, or by an
/// HR admin on the employee's behalf (`raisedByAdmin`). The ticket row holds
/// the request and its status only; every reply lives in `TicketComment`, so
/// the conversation is kept as history instead of being overwritten.
/// `status` is the four legacy values; `resolvedAt` is stamped when a ticket
/// is resolved or closed and kept on reopen, as the legacy screen does.
model Ticket {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  employeeId      Int       @map("employee_id")
  category        String
  subject         String
  description     String
  status          String    @default("OPEN")
  raisedByAdmin   Boolean   @default(false) @map("raised_by_admin")
  raisedByUserId  Int?      @map("raised_by_user_id")
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id])
  employee     Employee        @relation("TicketRequester", fields: [employeeId], references: [id])
  raisedByUser User?           @relation("TicketRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  comments     TicketComment[]

  @@index([organizationId, employeeId, status])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("tickets")
  @@schema("hr")
}

/// One reply on a ticket. Append-only: database triggers (migration) reject
/// UPDATE, DELETE and TRUNCATE, so the conversation cannot be edited after the
/// fact. Exactly one author is set, matching `authorKind`.
model TicketComment {
  id               Int      @id @default(autoincrement())
  organizationId   Int      @map("organization_id")
  ticketId         Int      @map("ticket_id")
  authorKind       String   @map("author_kind")
  authorUserId     Int?     @map("author_user_id")
  authorEmployeeId Int?     @map("author_employee_id")
  body             String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorUser     User?        @relation("TicketCommentByHr", fields: [authorUserId], references: [id], onDelete: Restrict)
  authorEmployee Employee?    @relation("TicketCommentByEmployee", fields: [authorEmployeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, ticketId, createdAt])
  @@map("ticket_comments")
  @@schema("hr")
}

// ---------------------------------------------------------------------------
// Attendance (apps/api/src/modules/hr/attendance) — an HR submodule; its
// tables live in the hr schema. Derived hours/overtime/shortfall are NOT
// stored: they are computed on read by attendance-calculation.service.ts.
// ---------------------------------------------------------------------------

/// One row per employee per Asia/Kolkata calendar day that has punches, an
/// HR-set status, or a correction. `status` is only what was explicitly set
/// (PRESENT | ABSENT | HALF_DAY, CHECK in the migration); NULL means nothing
/// was stored. An unmarked day is never persisted as absent.
/// Per-employee annual entitlement override for one leave type and year.
/// Absent row = the leave type's default `annualEntitlement` applies.
model LeaveEntitlement {
  id                Int      @id @default(autoincrement())
  organizationId    Int      @map("organization_id")
  employeeId        Int      @map("employee_id")
  leaveTypeId       Int      @map("leave_type_id")
  year              Int
  annualEntitlement Decimal  @map("annual_entitlement") @db.Decimal(5, 1)
  createdBy         Int?     @map("created_by")
  updatedBy         Int?     @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([organizationId, employeeId])
  @@map("leave_entitlements")
  @@schema("hr")
}

model AttendanceRecord {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  employeeId     Int       @map("employee_id")
  attendanceDate DateTime  @map("attendance_date") @db.Date
  status         String?
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id])
  employee     Employee                @relation(fields: [employeeId], references: [id])
  sessions     AttendanceSession[]
  corrections  AttendanceCorrection[]

  @@unique([organizationId, employeeId, attendanceDate])
  @@index([organizationId, attendanceDate])
  @@map("attendance_records")
  @@schema("hr")
}

/// One punch pair. `check_in_at` / `check_out_at` are server-set (or set by an
/// approved correction / HR edit, recorded in `source`). At most one open
/// session per record and per employee is enforced by partial unique indexes
/// and the check-in advisory lock (migration).
model AttendanceSession {
  id                 Int       @id @default(autoincrement())
  attendanceRecordId Int       @map("attendance_record_id")
  checkInAt          DateTime  @map("check_in_at") @db.Timestamptz(6)
  checkOutAt         DateTime? @map("check_out_at") @db.Timestamptz(6)
  /// SELF | HR | CORRECTION | IMPORT (CHECK in the migration)
  source             String
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  record AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId, checkInAt])
  @@map("attendance_sessions")
  @@schema("hr")
}

/// A request to correct a day's punches. Lifecycle: SUBMITTED → APPROVED |
/// REJECTED, both terminal. Decision fields are written only by a conditional
/// update (status = SUBMITTED), so a decision can happen exactly once.
model AttendanceCorrection {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  employeeId         Int       @map("employee_id")
  attendanceRecordId Int?      @map("attendance_record_id")
  attendanceDate     DateTime  @map("attendance_date") @db.Date
  /// MISSED_CHECK_IN | MISSED_CHECK_OUT | INCORRECT_TIME | LATE_ARRIVAL | EARLY_DEPARTURE
  correctionType     String    @map("correction_type")
  requestedCheckInAt  DateTime? @map("requested_check_in_at") @db.Timestamptz(6)
  requestedCheckOutAt DateTime? @map("requested_check_out_at") @db.Timestamptz(6)
  reason             String
  status             String    @default("SUBMITTED")
  requestedBy        Int       @map("requested_by")
  decidedBy          Int?      @map("decided_by")
  decidedAt          DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?   @map("decision_note")
  customFields       Json      @default("{}") @map("custom_fields")
  isActive           Boolean   @default(true) @map("is_active")
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id])
  employee     Employee           @relation(fields: [employeeId], references: [id])
  record       AttendanceRecord?  @relation(fields: [attendanceRecordId], references: [id])
  requester    User               @relation("AttendanceCorrectionRequester", fields: [requestedBy], references: [id])
  decider      User?              @relation("AttendanceCorrectionDecider", fields: [decidedBy], references: [id])

  @@index([organizationId, employeeId, attendanceDate])
  @@index([organizationId, status])
  @@map("attendance_corrections")
  @@schema("hr")
}

/// The monthly attendance close for one employee (legacy "Send for Approval"
/// → Admin "Accept / Decline", Docs/HR_API.md → Attendance month locks).
/// No row = the month is OPEN. Lifecycle:
///   SUBMITTED (HR finalized; summary frozen) → APPROVED (locked for payroll)
///   SUBMITTED → RETURNED (declined with a note; editable, may be re-submitted)
///   APPROVED  → REOPENED (approver unlocks with a reason; must be re-submitted)
/// While SUBMITTED or APPROVED no punch, status or correction of that month
/// may change. `summary` is the snapshot taken at submission, so what was
/// approved never drifts when the calendar changes later. Team-scoped through
/// `employee`. Transitions are conditional updates on `status`, so each
/// decision happens exactly once.
model AttendanceMonthLock {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  employeeId     Int       @map("employee_id")
  /// First day of the calendar month (CHECK in the migration).
  month          DateTime  @db.Date
  /// SUBMITTED | APPROVED | RETURNED | REOPENED (CHECK in the migration)
  status         String
  summary        Json
  submittedBy    Int       @map("submitted_by")
  submittedAt    DateTime  @map("submitted_at") @db.Timestamptz(6)
  decidedBy      Int?      @map("decided_by")
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?   @map("decision_note")
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  submitter    User         @relation("AttendanceMonthLockSubmitter", fields: [submittedBy], references: [id])
  decider      User?        @relation("AttendanceMonthLockDecider", fields: [decidedBy], references: [id])

  @@unique([organizationId, employeeId, month])
  @@index([organizationId, month, status])
  @@map("attendance_month_locks")
  @@schema("hr")
}

/// Salary revision letter issued to an existing employee (legacy RTDB
/// `revisionLetters`, Recruitment → Revision Letter). Always employee-linked,
/// so it is team-scoped THROUGH `employee`. `status` is GENERATED only: the
/// legacy app never assigns any other value. The four salary components are
/// the stored truth; gross is derived. Issuing a letter does NOT change the
/// employee's stored salary. `document_no` is issued once from the per-FY
/// `platform.document_sequences` counter and is never changed.
model RevisionLetter {
  id                   Int      @id @default(autoincrement())
  organizationId       Int      @map("organization_id")
  employeeId           Int      @map("employee_id")
  documentNo           String   @map("document_no")
  employeeName         String   @map("employee_name")
  designation          String
  location             String
  letterDate           DateTime @map("letter_date") @db.Date
  effectiveDate        DateTime @map("effective_date") @db.Date
  basic                Decimal  @db.Decimal(12, 2)
  da                   Decimal  @db.Decimal(12, 2)
  hra                  Decimal  @db.Decimal(12, 2)
  ca                   Decimal  @db.Decimal(12, 2)
  signatoryName        String   @map("signatory_name")
  signatoryDesignation String   @map("signatory_designation")
  status               String   @default("GENERATED")
  createdBy            Int?     @map("created_by")
  updatedBy            Int?     @map("updated_by")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  salaries     EmployeeSalary[]

  @@unique([organizationId, documentNo])
  @@index([organizationId, employeeId])
  @@map("revision_letters")
  @@schema("hr")
}

/// Promotion letter issued to an existing employee (Recruitment → Promotion
/// Letter). Same shape and rules as `RevisionLetter` — employee-linked, so
/// team-scoped THROUGH `employee`; GENERATED only; the four components are the
/// stored truth and gross is derived — plus a new designation chosen from the
/// `designations` master. `designation` and `previous_designation` are name
/// snapshots taken at issue, so a later rename in the master does not rewrite
/// an issued letter. Issuing a letter does NOT change the employee's stored
/// designation or salary. `document_no` is issued once from the per-FY
/// `platform.document_sequences` counter and is never changed.
model PromotionLetter {
  id                   Int      @id @default(autoincrement())
  organizationId       Int      @map("organization_id")
  employeeId           Int      @map("employee_id")
  designationId        Int      @map("designation_id")
  documentNo           String   @map("document_no")
  employeeName         String   @map("employee_name")
  previousDesignation  String   @map("previous_designation")
  designation          String
  location             String
  letterDate           DateTime @map("letter_date") @db.Date
  effectiveDate        DateTime @map("effective_date") @db.Date
  basic                Decimal  @db.Decimal(12, 2)
  da                   Decimal  @db.Decimal(12, 2)
  hra                  Decimal  @db.Decimal(12, 2)
  ca                   Decimal  @db.Decimal(12, 2)
  signatoryName        String   @map("signatory_name")
  signatoryDesignation String   @map("signatory_designation")
  status               String   @default("GENERATED")
  createdBy            Int?     @map("created_by")
  updatedBy            Int?     @map("updated_by")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization @relation(fields: [organizationId], references: [id])
  employee          Employee     @relation(fields: [employeeId], references: [id])
  designationMaster Designation  @relation(fields: [designationId], references: [id])

  @@unique([organizationId, documentNo])
  @@index([organizationId, employeeId])
  @@index([designationId])
  @@map("promotion_letters")
  @@schema("hr")
}

/// Interview schedule entry (legacy RTDB `interviewSchedule`, Recruitment →
/// Interview Schedule). Candidate and interviewer are FREE TEXT, as legacy
/// stores them: there is no candidate or employee reference, so there is no
/// owner to scope by. Access is an explicit org-wide permission (HR_API.md).
/// Only `status` changes after creation; legacy has no reschedule or edit.
/// Legacy values map to SCHEDULED/COMPLETED/SELECTED/REJECTED/NO_SHOW and
/// ONLINE/IN_PERSON/PHONE. Both are enforced by CHECK constraints.
model Interview {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  candidateName   String   @map("candidate_name")
  roleTitle       String   @map("role_title")
  interviewerName String   @map("interviewer_name")
  interviewDate   DateTime @map("interview_date") @db.Date
  /// Wall-clock time as `HH:MM`, the form legacy stores.
  interviewTime   String   @map("interview_time") @db.VarChar(5)
  mode            String
  status          String   @default("SCHEDULED")
  notes           String?
  createdBy       Int?     @map("created_by")
  updatedBy       Int?     @map("updated_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, interviewDate])
  @@index([organizationId, status])
  @@map("interviews")
  @@schema("hr")
}

/// Offer letter (legacy RTDB `offerLetters`, Recruitment → Offer Letter). A
/// full snapshot of the form inputs. Candidate is free text. There is NO
/// employee reference (legacy's :id route only prefills and is never saved)
/// and NO link to revision letters. Legacy declares Sent/Accepted but never
/// assigns them, so status is GENERATED only (CHECK). Access is an explicit
/// org-wide permission. Signature and seal images are not stored (no file
/// storage exists yet).
model OfferLetter {
  id                   Int      @id @default(autoincrement())
  organizationId       Int      @map("organization_id")
  candidateName        String   @map("candidate_name")
  role                 String
  location             String
  reportingManager     String   @map("reporting_manager")
  offerDate            DateTime @map("offer_date") @db.Date
  joiningDate          DateTime @map("joining_date") @db.Date
  offerValidityDate    DateTime @map("offer_validity_date") @db.Date
  basic                Decimal  @db.Decimal(12, 2)
  da                   Decimal  @db.Decimal(12, 2)
  hra                  Decimal  @db.Decimal(12, 2)
  ca                   Decimal  @db.Decimal(12, 2)
  workScheduleMonFri   String   @map("work_schedule_mon_fri")
  workScheduleSat      String   @map("work_schedule_sat")
  workScheduleSun      String   @map("work_schedule_sun")
  signatoryName        String   @map("signatory_name")
  signatoryDesignation String   @map("signatory_designation")
  companyEmail         String   @map("company_email")
  companyPhone         String   @map("company_phone")
  companyWebsite       String   @map("company_website")
  companyAddress       String   @map("company_address")
  status               String   @default("GENERATED")
  createdBy            Int?     @map("created_by")
  updatedBy            Int?     @map("updated_by")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, joiningDate])
  @@index([organizationId, candidateName])
  @@map("offer_letters")
  @@schema("hr")
}

/// RETIRED — no code reads or writes this table. Its data was copied into
/// `employee_personal_details` and `employee_addresses` by migration
/// 20261011090000_hr_employee_gaps, which now hold every employee's personal
/// details. Kept (not dropped) until a reviewer approves the drop; do not add
/// new readers.
model EmployeeProfile {
  id                        Int       @id @default(autoincrement())
  organizationId            Int       @map("organization_id")
  employeeId                Int       @unique @map("employee_id")
  title                     String?
  dateOfBirth               DateTime? @map("date_of_birth") @db.Date
  gender                    String?
  maritalStatus             String?   @map("marital_status")
  bloodGroup                String?   @map("blood_group")
  languages                 String[]  @default([])
  fatherName                String?   @map("father_name")
  motherName                String?   @map("mother_name")
  spouseName                String?   @map("spouse_name")
  emergencyContactName      String?   @map("emergency_contact_name")
  emergencyContactPhone     String?   @map("emergency_contact_phone")
  emergencyContactRelation  String?   @map("emergency_contact_relation")
  presentAddress            Json?     @map("present_address")
  permanentAddress          Json?     @map("permanent_address")
  isFresher                 Boolean   @default(false) @map("is_fresher")
  experienceYears           Decimal?  @map("experience_years") @db.Decimal(4, 1)
  previousCompany           String?   @map("previous_company")
  previousRole              String?   @map("previous_role")
  createdBy                 Int?      @map("created_by")
  updatedBy                 Int?      @map("updated_by")
