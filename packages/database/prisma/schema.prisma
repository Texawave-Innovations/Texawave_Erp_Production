// ---------------------------------------------------------------------------
// Payroll masters & statutory engine (apps/api/src/modules/hr/payroll,
// Docs/PAYROLL_AND_COMPLIANCE.md §3, §4.10–§4.15)
// ---------------------------------------------------------------------------

/// The organization's list of salary components (earnings and deductions).
/// A salary structure is a set of lines over this list; nothing about Basic,
/// HRA or conveyance is fixed in code. `code` is immutable once created and
/// may not be one the engine produces itself (ARREARS, BONUS, OVERTIME, PF,
/// ESI, PT, TDS, LOAN — CHECK). System components (BASIC, HRA, CONVEYANCE,
/// DA, OTHER_ALLOWANCE, SPECIAL_ALLOWANCE) are seeded per organization and
/// cannot be deleted, only deactivated.
model SalaryComponent {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  name           String
  /// EARNING | DEDUCTION (CHECK)
  kind           String
  /// Reduced in proportion to loss-of-pay days (false = paid in full).
  isProrated     Boolean   @default(true) @map("is_prorated")
  /// Counted as taxable salary for TDS.
  isTaxable      Boolean   @default(true) @map("is_taxable")
  /// Part of the PF wage (Basic + DA by default).
  pfApplicable   Boolean   @default(false) @map("pf_applicable")
  /// Part of the ESI wage.
  esiApplicable  Boolean   @default(true) @map("esi_applicable")
  isSystem       Boolean   @default(false) @map("is_system")
  displayOrder   Int       @default(100) @map("display_order")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization              @relation(fields: [organizationId], references: [id])
  templateLines SalaryTemplateComponent[]
  salaryLines   EmployeeSalaryComponent[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("salary_components")
  @@schema("hr")
}

/// A reusable salary breakup (e.g. per grade). Applying it to a gross amount
/// produces the lines of an employee's structure; the structure keeps its own
/// copy, so editing a template never changes an existing salary.
model SalaryTemplate {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  name           String
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id])
  lines        SalaryTemplateComponent[]
  salaries     EmployeeSalary[]

  @@unique([organizationId, code])
  @@map("salary_templates")
  @@schema("hr")
}

/// One line of a template. `calculation_type`: FIXED (value = rupees),
/// PERCENT_OF_GROSS, PERCENT_OF_BASIC (value = percent), REMAINDER (gross
/// minus every other earning; at most one per template — partial unique
/// index).
model SalaryTemplateComponent {
  id                Int     @id @default(autoincrement())
  salaryTemplateId  Int     @map("salary_template_id")
  salaryComponentId Int     @map("salary_component_id")
  calculationType   String  @map("calculation_type")
  value             Decimal @default(0) @db.Decimal(12, 2)
  displayOrder      Int     @default(100) @map("display_order")

  template  SalaryTemplate  @relation(fields: [salaryTemplateId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@unique([salaryTemplateId, salaryComponentId])
  @@map("salary_template_components")
  @@schema("hr")
}

/// The monthly amount of one component in one salary structure: the source
/// of truth the payroll engine reads. The legacy columns on
/// `employee_salaries` (basic, hra, ...) are kept in step for the system
/// components only.
model EmployeeSalaryComponent {
  id                Int      @id @default(autoincrement())
  organizationId    Int      @map("organization_id")
  employeeSalaryId  Int      @map("employee_salary_id")
  salaryComponentId Int      @map("salary_component_id")
  monthlyAmount     Decimal  @map("monthly_amount") @db.Decimal(12, 2)
  createdBy         Int?     @map("created_by")
  updatedBy         Int?     @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  employeeSalary EmployeeSalary  @relation(fields: [employeeSalaryId], references: [id], onDelete: Cascade)
  component      SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@unique([employeeSalaryId, salaryComponentId])
  @@index([organizationId, employeeSalaryId])
  @@map("employee_salary_components")
  @@schema("hr")
}

/// Professional Tax slab for one state: employees whose gross earnings for
/// the month fall in [min, max] pay `monthly_amount`, or `special_amount` in
/// `special_month` (e.g. a higher February instalment). An empty
/// `applicable_months` means every month; otherwise only those months
/// (half-yearly states).
model ProfessionalTaxSlab {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  stateCode        String    @map("state_code")
  minMonthlyWage   Decimal   @map("min_monthly_wage") @db.Decimal(12, 2)
  maxMonthlyWage   Decimal?  @map("max_monthly_wage") @db.Decimal(12, 2)
  monthlyAmount    Decimal   @map("monthly_amount") @db.Decimal(10, 2)
  specialMonth     Int?      @map("special_month")
  specialAmount    Decimal?  @map("special_amount") @db.Decimal(10, 2)
  applicableMonths Int[]     @default([]) @map("applicable_months")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  createdBy        Int?      @map("created_by")
  updatedBy        Int?      @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, stateCode])
  @@map("professional_tax_slabs")
  @@schema("hr")
}

/// The state whose Professional Tax applies at a work location (payroll's
/// own mapping; the work-location master has no state). A location without
/// a row uses `payroll_settings.pt_default_state_code`.
model PtLocationState {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  workLocationId Int      @unique @map("work_location_id")
  stateCode      String   @map("state_code")
  createdBy      Int?     @map("created_by")
  updatedBy      Int?     @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  workLocation WorkLocation @relation(fields: [workLocationId], references: [id])

  @@index([organizationId])
  @@map("pt_location_states")
  @@schema("hr")
}

/// Income-tax rules of one regime for one financial year ("2026-27"). HR
/// enters them from the Finance Act; nothing about tax law is hard-coded.
model IncomeTaxRegime {
  id                    Int      @id @default(autoincrement())
  organizationId        Int      @map("organization_id")
  financialYear         String   @map("financial_year")
  /// OLD | NEW (CHECK)
  regime                String
  standardDeduction     Decimal  @default(0) @map("standard_deduction") @db.Decimal(12, 2)
  /// Section 87A: taxable income up to this gets a rebate of up to `rebate_max_amount`.
  rebateIncomeLimit     Decimal  @default(0) @map("rebate_income_limit") @db.Decimal(12, 2)
  rebateMaxAmount       Decimal  @default(0) @map("rebate_max_amount") @db.Decimal(12, 2)
  cessPercent           Decimal  @default(4) @map("cess_percent") @db.Decimal(5, 2)
  /// Old regime caps: 80C (including employee PF) and home-loan interest.
  section80cLimit       Decimal  @default(150000) @map("section_80c_limit") @db.Decimal(12, 2)
  homeLoanInterestLimit Decimal  @default(200000) @map("home_loan_interest_limit") @db.Decimal(12, 2)
  version               Int      @default(1)
  createdBy             Int?     @map("created_by")
  updatedBy             Int?     @map("updated_by")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id])
  slabs        IncomeTaxSlab[]

  @@unique([organizationId, financialYear, regime])
  @@map("income_tax_regimes")
  @@schema("hr")
}

/// One slab of a regime: income above `from_income` (and up to `to_income`,
/// null = no upper limit) is taxed at `rate_percent`.
model IncomeTaxSlab {
  id          Int      @id @default(autoincrement())
  regimeId    Int      @map("regime_id")
  fromIncome  Decimal  @map("from_income") @db.Decimal(14, 2)
  toIncome    Decimal? @map("to_income") @db.Decimal(14, 2)
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)

  regime IncomeTaxRegime @relation(fields: [regimeId], references: [id], onDelete: Cascade)

  @@unique([regimeId, fromIncome])
  @@map("income_tax_slabs")
  @@schema("hr")
}

/// An employee's tax declaration for one financial year. Lifecycle:
/// DRAFT → SUBMITTED → VERIFIED | REJECTED; REJECTED → SUBMITTED (resubmit).
/// The employee declares; HR verifies against proofs and records the
/// accepted (`verified_*`) amounts. TDS uses the verified amounts once
/// VERIFIED, the declared ones while SUBMITTED, and only the regime choice of
/// a DRAFT or REJECTED declaration.
model EmployeeTaxDeclaration {
  id                       Int       @id @default(autoincrement())
  organizationId           Int       @map("organization_id")
  employeeId               Int       @map("employee_id")
  financialYear            String    @map("financial_year")
  regime                   String
  section80c               Decimal   @default(0) @map("section_80c") @db.Decimal(12, 2)
  section80d               Decimal   @default(0) @map("section_80d") @db.Decimal(12, 2)
  hraExemption             Decimal   @default(0) @map("hra_exemption") @db.Decimal(12, 2)
  homeLoanInterest         Decimal   @default(0) @map("home_loan_interest") @db.Decimal(12, 2)
  otherDeductions          Decimal   @default(0) @map("other_deductions") @db.Decimal(12, 2)
  otherIncome              Decimal   @default(0) @map("other_income") @db.Decimal(12, 2)
  previousEmployerIncome   Decimal   @default(0) @map("previous_employer_income") @db.Decimal(12, 2)
  previousEmployerTds      Decimal   @default(0) @map("previous_employer_tds") @db.Decimal(12, 2)
  verifiedSection80c       Decimal?  @map("verified_section_80c") @db.Decimal(12, 2)
  verifiedSection80d       Decimal?  @map("verified_section_80d") @db.Decimal(12, 2)
  verifiedHraExemption     Decimal?  @map("verified_hra_exemption") @db.Decimal(12, 2)
  verifiedHomeLoanInterest Decimal?  @map("verified_home_loan_interest") @db.Decimal(12, 2)
  verifiedOtherDeductions  Decimal?  @map("verified_other_deductions") @db.Decimal(12, 2)
  status                   String    @default("DRAFT")
  submittedAt              DateTime? @map("submitted_at") @db.Timestamptz(6)
  verifiedById             Int?      @map("verified_by_id")
  verifiedAt               DateTime? @map("verified_at") @db.Timestamptz(6)
  verificationNote         String?   @map("verification_note")
  version                  Int       @default(1)
  createdBy                Int?      @map("created_by")
  updatedBy                Int?      @map("updated_by")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  verifier     User?        @relation("TaxDeclarationVerifier", fields: [verifiedById], references: [id])

  @@unique([employeeId, financialYear])
  @@index([organizationId, financialYear, status])
  @@map("employee_tax_declarations")
  @@schema("hr")
}

/// Money an employee repays outside payroll. Lifecycle PENDING → APPROVED |
/// REJECTED (maker-checker). On approval the amount settles the LAST pending
/// installments first (the tenure shrinks; the monthly EMI is unchanged);
/// those become PREPAID, and a loan with nothing left pending is CLOSED.
model LoanPrepayment {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  loanId         Int       @map("loan_id")
  amount         Decimal   @db.Decimal(12, 2)
  receivedOn     DateTime  @map("received_on") @db.Date
  reference      String?
  reason         String
  status         String    @default("PENDING")
  requestedById  Int       @map("requested_by_id")
  decidedById    Int?      @map("decided_by_id")
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  loan         EmployeeLoan @relation(fields: [loanId], references: [id])
  requester    User         @relation("LoanPrepaymentRequester", fields: [requestedById], references: [id])
  decider      User?        @relation("LoanPrepaymentDecider", fields: [decidedById], references: [id])

  @@index([organizationId, loanId])
  @@index([organizationId, status])
  @@map("loan_prepayments")
  @@schema("hr")
}

// ---------------------------------------------------------------------------
// In-app notifications (apps/api/src/platform/notifications)
// ---------------------------------------------------------------------------

/// One message in a user's in-app inbox. Written only by server-side code
/// (jobs and services), never by a client. A user reads and marks only their
/// own rows. `dedup_key` makes a sender idempotent: the same key for the same
/// user is stored once (unique index; NULL keys never collide), so a job that
/// runs twice never notifies twice.
model Notification {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  userId         Int       @map("user_id")
  /// Dotted sender code, e.g. attendance.missing_check_in
  type           String
  title          String
  body           String
  /// In-app path to open, e.g. /self-service/attendance
  link           String?
  dedupKey       String?   @map("dedup_key")
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, dedupKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// Sales Settings / Sales & Document Masters foundation
// (apps/api/src/modules/sales-settings) — Docs/SALES_SETTINGS_FOUNDATION.md
//
// First models in the "sales" schema (Docs/PLATFORM_SCHEMA_SPLIT_PLAN.md §2:
// a module gets its own schema only when its first model lands — this is
// that landing for `sales`). Document numbering reuses the existing
// `DocumentSequence` table (new `docType` values only, see the foundation
// doc) rather than adding a new table here.
// ---------------------------------------------------------------------------

/// One row per organization (single-org app, but kept org-scoped for
/// consistency with every other table — Docs/ARCHITECTURE.md §5.1).
/// Company tab of Sales Settings.
model CompanyDetail {
  id             Int       @id @default(autoincrement())
  organizationId Int       @unique @map("organization_id")
  name           String
  phone          String?
  email          String?
  website        String?
  addressLine1   String?   @map("address_line1")
  addressLine2   String?   @map("address_line2")
  city           String?
  state          String?
  pincode        String?
  country        String?
  gstin          String?
  pan            String?
  /// Base64 data URI, same storage convention as `SealSignature.imageDataUri`.
  logoDataUri    String?   @map("logo_data_uri") @db.Text
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("company_details")
  @@schema("sales")
}

/// CRM Accounts — minimal foundation (Phase 4B). Only the fields the legacy
/// Contacts.tsx actually reads off an account (`id`, `name`) are modeled;
/// the full Account-360 feature set (industry, owner, etc.) is explicitly
/// out of scope for this phase. `teamId` is nullable: legacy has no team
/// concept for CRM accounts, so this is a forward-looking column following
/// the same nullable-FK pattern used elsewhere (e.g. `EmployeeExperience`,
/// `EmployeeDocument`) rather than a live dimension today.
/// Phase 0 (Account-360 foundation, Docs/CRM_FULL_LEGACY_PARITY.md §4) expanded
/// this from the Phase 4B minimal foundation (id/name/teamId/customFields
/// only) to the fields legacy's `AccountFormDialog.tsx`'s 5 tabs and
/// `AccountDetail.tsx`'s header/Overview actually read/write — confirmed by
/// direct legacy audit, not inferred. Deliberately NOT modeled (present in
/// legacy's `CrmAccount` type but never confirmed rendered/edited by any
/// screen the audit read): `territory`, `region`, `segment`, `healthScore`,
/// `healthTrend`, `linkedSalesCustomerId` (explicitly "never written to
/// automatically" per legacy's own type comment) — add these later only if
/// a specific screen is found to need them, per CODING_STANDARDS' no-
/// speculative-fields rule. The Lead→Account conversion link already exists
/// from the other side (`Lead.linkedAccountId`, see `leads` below) — no
/// separate `sourceLeadId` column needed.
model Account {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  teamId             Int?      @map("team_id")
  name               String
  /// Prospect|Customer|Partner|Vendor|Reseller — free string, same
  /// no-DB-enum convention as every other status/type field in this schema.
  accountType        String?   @map("account_type")
  ownerName          String?   @map("owner_name")
  /// Headquarters / location (legacy `hq`).
  hq                 String?
  /// High|Medium|Low — legacy CRM metadata priority chip.
  priority           String?
  /// Hot|Warm|Cold — legacy CRM metadata temperature chip.
  temperature        String?
  industry           String?
  website            String?
  phone              String?
  email              String?
  linkedin           String?
  registrationNumber String?   @map("registration_number")
  numberOfEmployees  Int?      @map("number_of_employees")
  annualRevenue      Decimal?  @map("annual_revenue") @db.Decimal(16, 2)
  description        String?
  billingStreet      String?   @map("billing_street")
  billingCity        String?   @map("billing_city")
  billingState       String?   @map("billing_state")
  billingPostalCode  String?   @map("billing_postal_code")
  billingCountry     String?   @map("billing_country")
  shippingStreet     String?   @map("shipping_street")
  shippingCity       String?   @map("shipping_city")
  shippingState      String?   @map("shipping_state")
  shippingPostalCode String?   @map("shipping_postal_code")
  shippingCountry    String?   @map("shipping_country")
  /// Enterprise|Mid-Market|SMB|Individual
  customerCategory   String?   @map("customer_category")
  /// A|B|C
  customerClass      String?   @map("customer_class")
  /// Manufacturer|Distributor|Retailer|Service Provider|Reseller|Other
  businessType       String?   @map("business_type")
  resellerType       String?   @map("reseller_type")
  tags               String[]  @default([])
  /// Interested|Not Interested|Keep in Touch|Call Back|Send Info — the
  /// legacy `AccountStatusQueue`/`StatusTagDialog` engagement-posture tag,
  /// independent of any Opportunity pipeline stage. Per-tag required
  /// companion field (reason/date/infoType) enforced at the service layer,
  /// matching legacy's `changeCrmAccountStatusTag`.
  statusTag          String?   @map("status_tag")
  statusReason       String?   @map("status_reason")
  statusDate         DateTime? @map("status_date") @db.Timestamptz(6)
  statusInfoType     String?   @map("status_info_type")
  statusUpdatedBy    Int?      @map("status_updated_by")
  statusUpdatedAt    DateTime? @map("status_updated_at") @db.Timestamptz(6)
  customFields       Json?     @map("custom_fields")
  isActive           Boolean   @default(true) @map("is_active")
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organization       Organization          @relation(fields: [organizationId], references: [id])
  team               Team?                 @relation(fields: [teamId], references: [id])
  contacts           Contact[]
  leads              Lead[]
  opportunities      Opportunity[]
  quotations         Quotation[]
  notes              CrmNote[]
  coldCallingEntries CrmColdCallingEntry[]

  projects Project[]

  @@index([organizationId])
  @@index([organizationId, teamId])
  @@index([organizationId, statusTag])
  @@map("accounts")
  @@schema("crm")
}

/// CRM Contacts — migrated from the LIVE legacy
/// TexaWave_ERP/src/modules/crm/domain/contactsService.ts (RTDB path
/// `crm/contacts`), not the dead apps/.../modules/contacts/ClientsLayout.tsx.
/// `accountId` is a hard-required FK (confirmed at 3 points in the legacy UI).
/// `teamId` is nullable, same forward-looking rationale as `Account.teamId`.
model Contact {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  teamId          Int?      @map("team_id")
  accountId       Int       @map("account_id")
  name            String
  designation     String?
  department      String?
  email           String?
  phone           String?
  whatsapp        String?
  isPrimary       Boolean   @default(false) @map("is_primary")
  isDecisionMaker Boolean   @default(false) @map("is_decision_maker")
  customFields    Json?     @map("custom_fields")
  isActive        Boolean   @default(true) @map("is_active")
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  team          Team?         @relation(fields: [teamId], references: [id])
  account       Account       @relation(fields: [accountId], references: [id])
  leads         Lead[]
  opportunities Opportunity[]
  quotations    Quotation[]

  @@index([organizationId])
  @@index([organizationId, teamId])
  @@index([accountId])
  @@map("contacts")
  @@schema("crm")
}

/// CRM Leads — migrated from the LIVE legacy TexaWave_ERP/src/modules/crm/
/// Leads.tsx + domain/LeadConvertDialog.tsx (RTDB path `crm/leads`).
/// `teamId` nullable, same forward-looking rationale as `Account.teamId`/
/// `Contact.teamId`. `leadStatus`/`priority` are free strings (legacy has no
/// server-side enum either), validated against a fixed vocabulary only at
/// the DTO layer — same string convention used everywhere else in this
/// schema (no Postgres enum type exists in this file).
///
/// Deliberately NOT modeled yet (additive — add when that phase lands):
/// `sourceMiningRowId` (Accounts Mining Sheet has no production entity),
/// `linkedOpportunityId` (Pipeline/Opportunities has no production entity).
/// Legacy's separate `month` column is dropped as redundant with
/// `meetingDate` (both describe the same meeting date); `emailOptOut` is
/// typed as a real `Boolean` here instead of legacy's free-text "Yes"/"No".
model Lead {
  id                  Int       @id @default(autoincrement())
  organizationId      Int       @map("organization_id")
  teamId              Int?      @map("team_id")
  companyName         String    @map("company_name")
  domain              String?
  hq                  String?
  industry            String?
  annualRevenue       String?   @map("annual_revenue")
  numberOfEmployees   String?   @map("number_of_employees")
  prospectName        String    @map("prospect_name")
  title               String?
  contactNumber       String?   @map("contact_number")
  mobile              String?
  email               String?
  fax                 String?
  skypeId             String?   @map("skype_id")
  meetingStatus       String?   @map("meeting_status")
  meetingScheduled    String?   @map("meeting_scheduled")
  meetingDate         DateTime? @map("meeting_date")
  leadStatus          String    @default("NEW") @map("lead_status")
  priority            String?
  assignedTo          String?   @map("assigned_to")
  leadSource          String?   @map("lead_source")
  /// Hot|Warm|Cold (legacy lead temperature).
  rating              String?
  /// Free-text "Month" field (legacy lead row `month`).
  month               String?
  emailOptOut         Boolean   @default(false) @map("email_opt_out")
  dataProcessingBasis String?   @map("data_processing_basis")
  addressStreet       String?   @map("address_street")
  city                String?
  state               String?
  postalCode          String?   @map("postal_code")
  country             String?
  tags                String?
  areaOfInterest      String?   @map("area_of_interest")
  comments            String?
  linkedAccountId     Int?      @map("linked_account_id")
  linkedContactId     Int?      @map("linked_contact_id")
  /// Set once Convert's "Create a Deal" step creates an Opportunity — see
  /// `Opportunity.leadId` for the inverse (the Opportunity's own record of
  /// which Lead it was sourced from). Both sides are written together, in
  /// the same transaction, by `LeadsRepository.convert()` — never two
  /// independent writers, so they cannot drift apart the way legacy's two
  /// Firebase paths theoretically could.
  linkedOpportunityId Int?      @map("linked_opportunity_id")
  customFields        Json?     @map("custom_fields")
  isActive            Boolean   @default(true) @map("is_active")
  createdBy           Int?      @map("created_by")
  updatedBy           Int?      @map("updated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  organization         Organization  @relation(fields: [organizationId], references: [id])
  team                 Team?         @relation(fields: [teamId], references: [id])
  linkedAccount        Account?      @relation(fields: [linkedAccountId], references: [id])
  linkedContact        Contact?      @relation(fields: [linkedContactId], references: [id])
  linkedOpportunity    Opportunity?  @relation("LeadLinkedOpportunity", fields: [linkedOpportunityId], references: [id])
  sourcedOpportunities Opportunity[] @relation("OpportunitySourceLead")
  leadNotes            CrmLeadNote[]

  @@index([organizationId])
  @@index([organizationId, teamId])
  @@index([linkedAccountId])
  @@index([linkedContactId])
  @@index([linkedOpportunityId])
  @@map("leads")
  @@schema("crm")
}

/// CRM Pipeline Stages — migrated from the LIVE legacy TexaWave_ERP/src/
/// modules/crm/domain/pipelineStagesService.ts + config.ts (RTDB path
/// `crm/pipelineStages`, self-seeded from a static 13-stage list on first
/// read if empty). Production reproduces the self-seeding behavior at the
/// service layer (`PipelineStagesService.ensureSeeded`) rather than baking
/// a fixed set into the migration, since a migration only runs once and
/// can't seed an organization created afterward (e.g. every e2e test org).
/// `code` is the legacy stage-id slug (e.g. "new_lead") — kept so a
/// seeded org's stage codes exactly match what legacy displays, and so
/// `Opportunity.stageId` always has a human-legible code alongside the
/// numeric PK. Only `write` (not a scoped `.own/.team/.all`) exists, same
/// org-wide-reference-data shape as `crm.account.*` — legacy gates stage
/// management behind "CRM Admin / Sales Head" (`canManagePipelineConfig`),
/// which this app has no separate role concept for yet, same documented
/// stand-in as crm.lead.write.
model PipelineStage {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  label          String
  order          Int
  probability    Int?
  isWon          Boolean   @default(false) @map("is_won")
  isLost         Boolean   @default(false) @map("is_lost")
  /// Legacy excludes the "on_hold" stage from board/drag columns
  /// (`s.id !== 'on_hold'`) without a dedicated flag, matching on the
  /// static id string. This flag makes that exclusion a first-class,
  /// renameable property instead of a hardcoded string match.
  isOnHold       Boolean   @default(false) @map("is_on_hold")
  slaDays        Int?      @map("sla_days")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization     Organization              @relation(fields: [organizationId], references: [id])
  opportunities    Opportunity[]
  stageHistoryFrom OpportunityStageHistory[] @relation("StageHistoryFrom")
  stageHistoryTo   OpportunityStageHistory[] @relation("StageHistoryTo")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("pipeline_stages")
  @@schema("crm")
}

/// CRM Opportunities ("Deals") — migrated from the LIVE legacy
/// TexaWave_ERP/src/modules/crm/Pipeline.tsx + domain/opportunitiesService.ts
/// + domain/OpportunityDrawer.tsx (RTDB `crm/opportunities`).
///
/// Deliberately NOT modeled yet (additive — add when that phase lands, same
/// convention as Lead's deferred fields): `dealProducts`/Products-tab line
/// items (Products unmigrated), `quotations` (Quotations unmigrated),
/// `activities` (Activities feed unmigrated), `leadScore`/`leadTemperature`/
/// `forecastCategory`/`competitorId` (no production Lead-scoring or
/// Competitors entity). `probability` is nullable and is NEVER
/// auto-populated from the stage's own probability on create or stage
/// change — legacy only ever falls back to the stage's probability at
/// *display* time (`o.probability ?? stage.probability`, see Pipeline.tsx)
/// and never writes that fallback back onto the record; the API reproduces
/// the same display-time fallback instead of writing a value legacy never
/// writes.
model Opportunity {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  teamId             Int?      @map("team_id")
  accountId          Int       @map("account_id")
  contactId          Int?      @map("contact_id")
  /// The Lead this opportunity was converted from, if any — see
  /// `Lead.linkedOpportunityId` for the inverse.
  leadId             Int?      @map("lead_id")
  /// Generated at create time as `OPP-<last 6 digits of id, zero-padded>`
  /// (see leads.repository.ts-style generation in opportunities.repository.ts)
  /// — legacy uses the last 6 chars of its Firebase push id, which has no
  /// equivalent on an autoincrement int id, so the format is adapted, not
  /// copied byte-for-byte.
  opportunityNumber  String    @map("opportunity_number")
  title              String
  /// Free-text deal owner name — same convention as `Lead.assignedTo`
  /// (legacy ties ownership to a free-text name, not a User FK; see
  /// `domain/roles.ts` `canManageOpportunity`).
  ownerName          String    @map("owner_name")
  stageId            Int       @map("stage_id")
  stageEnteredAt     DateTime  @default(now()) @map("stage_entered_at")
  estimatedValue     Decimal   @default(0) @map("estimated_value") @db.Decimal(14, 2)
  currency           String?   @default("INR")
  expectedCloseDate  DateTime? @map("expected_close_date")
  probability        Int?
  priority           String?
  nextAction         String?   @map("next_action")
  nextActionDate     DateTime? @map("next_action_date")
  lastActivityAt     DateTime? @map("last_activity_at")
  status             String    @default("OPEN") @map("status")
  lostReason         String?   @map("lost_reason")
  lostReasonOther    String?   @map("lost_reason_other")
  lostAt             DateTime? @map("lost_at")
  competitor         String?
  holdReason         String?   @map("hold_reason")
  holdReasonOther    String?   @map("hold_reason_other")
  expectedResumeDate DateTime? @map("expected_resume_date")
  /// Best Case|Commit|Pipeline|Omitted|Closed (legacy forecast category).
  forecastCategory   String?   @map("forecast_category")
  holdNotes          String?   @map("hold_notes")
  onHoldAt           DateTime? @map("on_hold_at")
  resumedAt          DateTime? @map("resumed_at")
  stuckReason        String?   @map("stuck_reason")
  stuckReasonOther   String?   @map("stuck_reason_other")
  contactRole        String?   @map("contact_role")
  campaignSource     String?   @map("campaign_source")
  closingAmount      Decimal?  @map("closing_amount") @db.Decimal(14, 2)
  closingDate        DateTime? @map("closing_date")
  wonAt              DateTime? @map("won_at")
  customFields       Json?     @map("custom_fields")
  isActive           Boolean   @default(true) @map("is_active")
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organization       Organization              @relation(fields: [organizationId], references: [id])
  team               Team?                     @relation(fields: [teamId], references: [id])
  account            Account                   @relation(fields: [accountId], references: [id])
  contact            Contact?                  @relation(fields: [contactId], references: [id])
  lead               Lead?                     @relation("OpportunitySourceLead", fields: [leadId], references: [id])
  stage              PipelineStage             @relation(fields: [stageId], references: [id])
  convertedFromLeads Lead[]                    @relation("LeadLinkedOpportunity")
  stageHistory       OpportunityStageHistory[]
  lineItems          OpportunityProduct[]
  quotations         Quotation[]

  @@index([organizationId])
  @@index([organizationId, teamId])
  @@index([accountId])
  @@index([contactId])
  @@index([leadId])
  @@index([stageId])
  @@map("opportunities")
  @@schema("crm")
}

/// Append-only stage-transition audit trail — migrated from legacy's
/// `crm/opportunityStageHistory/{opportunityId}`. DB-trigger-enforced
/// append-only (`prevent_row_mutation()`, same mechanism as `audit_logs`/
/// `employee_status_history` — see the migration SQL), not just an
/// application-level convention: legacy's own comment says the current
/// stage "is only ever a pointer... the full history lives in" this
/// collection, so the history itself must never be editable after the
/// fact.
model OpportunityStageHistory {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  opportunityId  Int      @map("opportunity_id")
  fromStageId    Int?     @map("from_stage_id")
  toStageId      Int      @map("to_stage_id")
  changedBy      Int?     @map("changed_by")
  changedAt      DateTime @default(now()) @map("changed_at")
  remarks        String?

  organization Organization   @relation(fields: [organizationId], references: [id])
  opportunity  Opportunity    @relation(fields: [opportunityId], references: [id])
  fromStage    PipelineStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id])
  toStage      PipelineStage  @relation("StageHistoryTo", fields: [toStageId], references: [id])

  @@index([organizationId])
  @@index([opportunityId])
  @@map("opportunity_stage_history")
  @@schema("crm")
}

/// CRM Products catalog — migrated from the LIVE legacy TexaWave_ERP/src/
/// modules/crm/Products.tsx + domain/productsService.ts (RTDB `crm/products`).
/// Org-wide reference data, no team dimension — same shape as `Account`/
/// `PipelineStage` (Docs/CRM_PRODUCTS_LEGACY_PARITY.md §3), not the
/// `.own/.team/.all` shape used by Lead/Contact/Opportunity.
///
/// `code` is deliberately NOT unique (approved decision D1,
/// Docs/CRM_PRODUCTS_LEGACY_PARITY.md §4) — legacy's own
/// `createCrmProduct`/`updateCrmProduct` never check for an existing code
/// on manual create/edit, only advisory-matches it during bulk import
/// (unmigrated — D4). Reproducing that means NOT adding
/// `@@unique([organizationId, code])`, unlike `PipelineStage.code`.
///
/// Deliberately NOT modeled (verified absent in legacy, not merely
/// omitted — see the audit doc §2.2/§2.4): a currency field, any
/// stock/quantity field, a category or vendor master entity, SKU
/// generation, and a tax-rate upper bound.
model Product {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  name           String
  code           String
  category       String?
  vendor         String?
  /// Rejects negative values at the DTO layer (approved decision D3) —
  /// an intentional business-integrity safeguard, not a legacy behavior:
  /// legacy's own form has no server-side floor at all (only an HTML
  /// `min={0}` that doesn't stop a typed negative number).
  unitPrice      Decimal   @default(0) @map("unit_price") @db.Decimal(14, 2)
  /// No upper bound — legacy has none either (approved decision D2
  /// explicitly declines to add one without further approval).
  taxPercent     Decimal?  @map("tax_percent") @db.Decimal(5, 2)
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  customFields   Json?     @map("custom_fields")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization       Organization         @relation(fields: [organizationId], references: [id])
  lineItems          OpportunityProduct[]
  quotationLineItems QuotationLineItem[]

  @@index([organizationId])
  @@map("products")
  @@schema("crm")
}

/// Deal line items — migrated from legacy's `CrmDealProduct`
/// (`crm/dealProducts`, flat collection filtered by `opportunityId` in
/// memory). This is the "real persisted relationship" between Products
/// and the existing Opportunity architecture: adding a product to an
/// Opportunity creates one of these rows. `productName`/`unitPrice`/
/// `taxPercent` are a SNAPSHOT taken at add-time from the live `Product`
/// row — intentionally frozen, exactly like legacy, so a later product
/// rename/re-price/deactivation never retroactively changes a historical
/// line item (Docs/CRM_PRODUCTS_LEGACY_PARITY.md §2.6). `total` is
/// computed via the shared `computeLineBreakdown` port
/// (apps/api/src/modules/crm/shared/money.ts) — the same formula and
/// per-step rounding legacy's `dealProductsService.ts` uses, reused
/// as-is rather than re-derived, so a future Quote implementation can
/// import the identical function instead of re-deriving the formula.
///
/// Quotation line items (`crm/quotationItems`) are NOT modeled here —
/// Quotes/Quotations has no production entity yet. `Product.softDelete`'s
/// usage-count check therefore only counts THIS table today; it cannot
/// yet see quotation references (documented gap, not pretended-away).
model OpportunityProduct {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  opportunityId   Int       @map("opportunity_id")
  productId       Int       @map("product_id")
  productName     String    @map("product_name")
  quantity        Decimal   @db.Decimal(14, 2)
  unitPrice       Decimal   @map("unit_price") @db.Decimal(14, 2)
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  taxPercent      Decimal?  @map("tax_percent") @db.Decimal(5, 2)
  total           Decimal   @db.Decimal(14, 2)
  isActive        Boolean   @default(true) @map("is_active")
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([opportunityId])
  @@index([productId])
  @@map("opportunity_products")
  @@schema("crm")
}

/// CRM Quotations — migrated from the LIVE legacy TexaWave_ERP/src/
/// modules/crm/QuoteForm.tsx + Quotes.tsx + domain/quotationsService.ts
/// (RTDB `crm/quotations` + `crm/quotationItems`). Org-wide reference
/// data, no team dimension — approved decision D1
/// (Docs/CRM_QUOTES_LEGACY_PARITY.md §4/§6), same shape as `Product`/
/// `PipelineStage`. Delete is gated by a SEPARATE `crm.quotation.delete`
/// permission, not folded into `.write` — a deliberate departure from
/// every prior CRM entity's "`.write` stands in for admin-only delete"
/// convention, per this phase's explicit approval (legacy's Delete is
/// `isCrmAdmin`-only and must not be reachable by an ordinary write-only
/// role).
///
/// `subtotal`/`totalDiscount`/`totalTax`/`grandTotal` are NEVER
/// client-trusted (approved decision D4) — always recomputed server-side
/// from the submitted line items via the shared
/// `computeLineBreakdown`/`round2` port in
/// apps/api/src/modules/crm/shared/money.ts, the exact function legacy's
/// own QuoteForm.tsx already reuses from Deal Products
/// (Docs/CRM_QUOTES_LEGACY_PARITY.md §2.1). `adjustment` is the one
/// total-related field that IS a direct client input (a manual +/-
/// legacy always let the user type), not computed.
///
/// `quotationNumber` is generated server-side as `QUO-<id, zero-padded
/// to 6>` (approved decision D3) — derived from the row's own
/// autoincrement id after insert, the same two-step pattern already used
/// for `Opportunity.opportunityNumber`, which makes a collision
/// structurally impossible (no two rows ever share an id). The
/// `@@unique` below is still added as the explicit DB-level guarantee
/// the decision asked for, not because the numbering scheme could
/// collide on its own.
///
/// Deliberately NOT modeled (verified absent in legacy,
/// Docs/CRM_QUOTES_LEGACY_PARITY.md §1.4): a revision/version table, an
/// approval/sign-off table, a real Sales-Order-conversion link (legacy's
/// own `linkedSalesQuotationId` is never written to either — not
/// ported, since there is nothing to port).
model Quotation {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  accountId          Int       @map("account_id")
  opportunityId      Int?      @map("opportunity_id")
  contactId          Int?      @map("contact_id")
  quotationNumber    String    @map("quotation_number")
  subject            String
  /// Free string, no CHECK constraint — same convention as
  /// `Opportunity.status`. Deliberately NO transition guard: legacy lets
  /// the Status dropdown move to any of the 5 values from any other at
  /// any time (confirmed, Docs/CRM_QUOTES_LEGACY_PARITY.md §1.4) and
  /// this is reproduced exactly, not tightened.
  status             String    @default("Draft")
  quoteOwner         String?   @map("quote_owner")
  currency           String?   @default("INR")
  quoteDate          DateTime? @map("quote_date")
  validUntil         DateTime? @map("valid_until")
  customerReference  String?   @map("customer_reference")
  billingStreet      String?   @map("billing_street")
  billingCity        String?   @map("billing_city")
  billingState       String?   @map("billing_state")
  billingPostalCode  String?   @map("billing_postal_code")
  billingCountry     String?   @map("billing_country")
  shippingStreet     String?   @map("shipping_street")
  shippingCity       String?   @map("shipping_city")
  shippingState      String?   @map("shipping_state")
  shippingPostalCode String?   @map("shipping_postal_code")
  shippingCountry    String?   @map("shipping_country")
  carrier            String?
  deliveryNotes      String?   @map("delivery_notes")
  termsConditions    String?   @map("terms_conditions")
  paymentTerms       String?   @map("payment_terms")
  deliveryTerms      String?   @map("delivery_terms")
  notes              String?
  subtotal           Decimal   @default(0) @db.Decimal(14, 2)
  totalDiscount      Decimal   @default(0) @map("total_discount") @db.Decimal(14, 2)
  totalTax           Decimal   @default(0) @map("total_tax") @db.Decimal(14, 2)
  adjustment         Decimal   @default(0) @db.Decimal(14, 2)
  grandTotal         Decimal   @default(0) @map("grand_total") @db.Decimal(14, 2)
  isActive           Boolean   @default(true) @map("is_active")
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  account      Account             @relation(fields: [accountId], references: [id])
  opportunity  Opportunity?        @relation(fields: [opportunityId], references: [id])
  contact      Contact?            @relation(fields: [contactId], references: [id])
  lineItems    QuotationLineItem[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([accountId])
  @@index([opportunityId])
  @@map("quotations")
  @@schema("crm")
}

/// Quote line items — migrated from legacy's `CrmQuotationLineItem`
/// (`crm/quotationItems/{quotationId}`). Unlike `OpportunityProduct`,
/// `unitPrice` is NOT frozen — it is a genuine, independently editable
/// manual price override (Docs/CRM_QUOTES_LEGACY_PARITY.md §1.3/§3), the
/// single biggest behavioral difference from Deal Products. `listPrice`
/// IS frozen (the catalog price at pick-time, display-only in the UI).
/// `productId` is nullable — a line may be pure free text with no
/// catalog product at all (confirmed). Written via "replace all on
/// save" (approved decision D2): the whole array is replaced, inside the
/// same transaction as the parent `Quotation` header update, every save
/// — there is no standalone per-line create/update/delete endpoint the
/// way `OpportunityProduct` has one, matching legacy's single-Save-button
/// interaction exactly. Rows are therefore hard-deleted and recreated on
/// each replace, not soft-deleted individually; nothing depends on an
/// individual line surviving across a save, since legacy itself has no
/// such guarantee either (a Firebase `set()` on the whole sub-tree). The
/// parent `Quotation`'s own soft-delete does NOT cascade a delete onto
/// these rows (see quotations.repository.ts) — they are simply no longer
/// reachable once the parent is excluded from reads, the same "orphaned
/// but intact" posture already used elsewhere in this schema.
model QuotationLineItem {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  quotationId     Int      @map("quotation_id")
  productId       Int?     @map("product_id")
  productCode     String?  @map("product_code")
  description     String
  uom             String?
  quantity        Decimal  @db.Decimal(14, 2)
  listPrice       Decimal  @map("list_price") @db.Decimal(14, 2)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(14, 2)
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal? @map("discount_amount") @db.Decimal(14, 2)
  taxPercent      Decimal? @map("tax_percent") @db.Decimal(5, 2)
  taxAmount       Decimal? @map("tax_amount") @db.Decimal(14, 2)
  amount          Decimal  @db.Decimal(14, 2)
  /// Preserves the submitted array order across a replace-all save —
  /// legacy's own array index serves this role in Firebase.
  lineOrder       Int      @map("line_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  quotation    Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([quotationId])
  @@index([productId])
  @@map("quotation_line_items")
  @@schema("crm")
}

// -----------------------------------------------------------------------
// CRM Account-360 foundation (Phase 0, Docs/CRM_FULL_LEGACY_PARITY.md §4).
// Meeting/FollowUp/CrmActivity/CrmTask/CrmDocument share legacy's exact
// polymorphic `relatedType` + `relatedId` pair (confirmed:
// `domain/types.ts`'s `CrmRelatedType = 'lead'|'account'|'contact'|
// 'opportunity'`) instead of a dedicated FK column — Prisma has no native
// polymorphic-relation type, so `relatedId` is a plain Int with NO `@relation`
// (can't FK to four different tables at once); the repository layer
// validates the target row exists in the right table before writing,
// exactly like `OpportunitiesRepository.create` already validates
// `accountId`/`contactId`. `CrmNote` is the one exception — legacy's own
// Notes feature is scoped only to a company/Account (`crm/notes/{companyKey}`
// in Firebase, no `relatedType`), confirmed by direct audit, so it gets a
// real `accountId` FK instead.
// -----------------------------------------------------------------------

/// Legacy `domain/meetingsService.ts` + `CrmMeeting` type. Reschedule history
/// is its own child table (legacy keeps it as a `Record<string, entry>` map
/// on the parent; a relational table is the natural equivalent). No
/// `customFields` column — legacy's own comment notes there is no dedicated
/// edit UI for Meeting custom fields (bulk-import only, a later phase).
model CrmMeeting {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  relatedType      String    @map("related_type")
  relatedId        Int       @map("related_id")
  mode             String    @default("Online")
  meetingDate      DateTime  @map("meeting_date") @db.Date
  startTime        String?   @map("start_time")
  endTime          String?   @map("end_time")
  location         String?
  meetingLink      String?   @map("meeting_link")
  agenda           String?
  participants     String?
  /// REQUESTED|TENTATIVE|CONFIRMED|COMPLETED|CANCELLED|RESCHEDULED|NO_SHOW
  status           String    @default("REQUESTED")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  summary          String?
  requirements     String?
  concerns         String?
  competitors      String?
  budget           String?
  decisionMaker    String?   @map("decision_maker")
  expectedTimeline String?   @map("expected_timeline")
  nextFollowUpAt   DateTime? @map("next_follow_up_at") @db.Timestamptz(6)
  nextStep         String?   @map("next_step")
  /// Bulk-import auto-created custom columns (CrmCustomFieldDef key -> value)
  customFields     Json?     @map("custom_fields")
  createdBy        Int?      @map("created_by")
  updatedBy        Int?      @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id])
  reschedules  CrmMeetingReschedule[]

  @@index([organizationId, relatedType, relatedId])
  @@index([organizationId, status])
  @@map("crm_meetings")
  @@schema("crm")
}

model CrmMeetingReschedule {
  id            Int      @id @default(autoincrement())
  meetingId     Int      @map("meeting_id")
  previousDate  DateTime @map("previous_date") @db.Date
  reason        String?
  rescheduledBy Int?     @map("rescheduled_by")
  rescheduledAt DateTime @default(now()) @map("rescheduled_at") @db.Timestamptz(6)

  meeting CrmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("crm_meeting_reschedules")
  @@schema("crm")
}

/// Legacy `domain/followupsService.ts` + `CrmFollowUp` type. `status`
/// deliberately never stores `OVERDUE` — confirmed legacy's
/// `getEffectiveFollowUpStatus()` computes it at read time from
/// `scheduledAt` vs "now" and never writes it back (avoids write races
/// between viewers). Reproduced the same way here: only PENDING/COMPLETED/
/// CANCELLED/MISSED/RESCHEDULED are ever persisted; OVERDUE is derived in
/// the service layer. Also reproduced as-observed: rescheduling a Meeting
/// sets its status to RESCHEDULED, but rescheduling a FollowUp sets it back
/// to PENDING (confirmed legacy asymmetry, not corrected — same
/// reproduce-the-quirk convention already used for Opportunity's on-hold
/// stage handling).
model CrmFollowUp {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  relatedType    String    @map("related_type")
  relatedId      Int       @map("related_id")
  /// Reuses CrmActivity's type vocabulary (Call/Email/WhatsApp/etc.).
  type           String
  scheduledAt    DateTime  @map("scheduled_at") @db.Timestamptz(6)
  assignedTo     String    @map("assigned_to")
  priority       String    @default("Medium")
  notes          String?
  outcome        String?
  status         String    @default("PENDING")
  nextFollowUpAt DateTime? @map("next_follow_up_at") @db.Timestamptz(6)
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id])
  reschedules  CrmFollowUpReschedule[]

  @@index([organizationId, relatedType, relatedId])
  @@index([organizationId, status])
  @@map("crm_follow_ups")
  @@schema("crm")
}

/// List of org bank accounts. Bank & Signatory tab (bank half) of Sales
/// Settings.
model BankAccount {
  id                Int       @id @default(autoincrement())
  organizationId    Int       @map("organization_id")
  bankName          String    @map("bank_name")
  accountHolderName String    @map("account_holder_name")
  accountNumber     String    @map("account_number")
  ifscCode          String    @map("ifsc_code")
  branchName        String?   @map("branch_name")
  isPrimary         Boolean   @default(false) @map("is_primary")
  customFields      Json      @default("{}") @map("custom_fields")
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("bank_accounts")
  @@schema("sales")
}

/// One row per organization — the UI shows a single Name/Designation form,
/// not a list (contrast `Salesperson`, which is a list). Bank & Signatory
/// tab (signatory half) of Sales Settings.
model AuthorizedSignatory {
  id             Int       @id @default(autoincrement())
  organizationId Int       @unique @map("organization_id")
  name           String?
  designation    String?
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("authorized_signatories")
  @@schema("sales")
}

model CrmFollowUpReschedule {
  id            Int      @id @default(autoincrement())
  followUpId    Int      @map("follow_up_id")
  previousDate  DateTime @map("previous_date") @db.Timestamptz(6)
  reason        String?
  rescheduledBy Int?     @map("rescheduled_by")
  rescheduledAt DateTime @default(now()) @map("rescheduled_at") @db.Timestamptz(6)

  followUp CrmFollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([followUpId])
  @@map("crm_follow_up_reschedules")
  @@schema("crm")
}

/// Legacy `domain/activitiesService.ts` + `CrmActivity` type — the backing
/// store for the Timeline, manually-logged Notes-typed entries, and the
/// WhatsApp/LinkedIn/Email/Call activity queues (confirmed: these are all
/// just this one entity filtered by `type`, not separate tables). `'Stage
/// Change'` is a valid type value but is only ever auto-logged by the
/// Opportunity stage-change flow, never user-selectable — reproduced as a
/// legal-but-not-user-facing value, matching legacy's own
/// `ACTIVITY_TYPES` constant excluding it from the picker.
model CrmActivity {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  relatedType    String    @map("related_type")
  relatedId      Int       @map("related_id")
  /// Call|Email|WhatsApp|Meeting|Demo|Note|Task|Follow-up|Proposal|LinkedIn|
  /// Stage Change
  type           String
  subject        String
  notes          String?
  /// Sent|Received — Email type only, legacy leaves it unset otherwise.
  direction      String?
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, relatedType, relatedId])
  @@index([organizationId, type])
  @@map("crm_activities")
  @@schema("crm")
}

/// Legacy `domain/tasksService.ts` + `CrmTask` type — a generic,
/// polymorphic CRM task (relatable to Account/Contact/Opportunity/Lead),
/// confirmed structurally distinct from HR's `Task` model (which is hard
/// FK'd to `Employee` with HR-specific approval-request fields — not
/// reusable here without coupling CRM to HR assumptions it doesn't have).
/// `assignedTo` is deliberately a free-text name, not a User FK — matches
/// legacy exactly (`CrmTask.assignedTo: string`), not a correction.
model CrmTask {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  relatedType    String    @map("related_type")
  relatedId      Int       @map("related_id")
  title          String
  dueDate        DateTime  @map("due_date") @db.Date
  assignedTo     String    @map("assigned_to")
  priority       String    @default("Medium")
  /// Open|Completed — only two states, confirmed (no cancelled/in-progress
  /// in legacy's CrmTask, unlike HR's Task).
  status         String    @default("Open")
  notes          String?
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, relatedType, relatedId])
  @@index([organizationId, status])
  @@map("crm_tasks")
  @@schema("crm")
}

/// Salespersons tab of Sales Settings — tracked for commission/assignment by
/// future Sales documents (quotations/invoices reference this by id).
model Salesperson {
  id                Int       @id @default(autoincrement())
  organizationId    Int       @map("organization_id")
  name              String
  code              String?
  email             String?
  phone             String?
  commissionPercent Decimal?  @map("commission_percent") @db.Decimal(5, 2)
  customFields      Json      @default("{}") @map("custom_fields")
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("salespersons")
  @@schema("sales")
}

/// Legacy `domain/documentsService.ts` + `CrmDocument` type — confirmed
/// name + external link only, no real file upload (legacy's own comment:
/// Firebase Storage was never wired up). No update capability in legacy
/// either (only create/delete) — reproduced the same way, no update
/// endpoint planned for this entity.
model CrmDocument {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  relatedType    String    @map("related_type")
  relatedId      Int       @map("related_id")
  name           String
  link           String
  notes          String?
  uploadedBy     Int?      @map("uploaded_by")
  uploadedAt     DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, relatedType, relatedId])
  @@map("crm_documents")
  @@schema("crm")
}

/// Legacy `intelligence/notesService.ts` + `CrmNote` type — confirmed
/// architecturally distinct from `CrmActivity`'s `type: 'Note'` entries
/// (two unrelated things both called "Notes" in legacy; see Docs/
/// CRM_FULL_LEGACY_PARITY.md). Scoped only to an Account (legacy:
/// `crm/notes/{companyKey}`, never `relatedType`/`relatedId`), confirmed no
/// update capability in legacy (add/delete only — `updatedAt` on legacy's
/// own type is typed but never written, so it's omitted here rather than
/// modeled as a dead column).
model CrmNote {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  accountId      Int       @map("account_id")
  content        String
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId, accountId])
  @@map("crm_notes")
  @@schema("crm")
}

/// CRM Cold Calling Status — Phase 1B additive queue. Logs raw cold-calling
/// call outcomes exactly as they come out of the source spreadsheet (SINO /
/// Date / Company Name / Prospect Name / Designation / Status) ahead of a
/// human routing each row into the Account.statusTag disposition queues
/// (Interested / Not Interested / Keep in Touch / Call Back / Send Info).
/// Mirrors legacy TexaWave_ERP/src/modules/crm/ColdCallingStatus.tsx's
/// Firebase `crm/coldCallingStatus` path — isolated dataset; "linkedAccount"
/// + "dispositionTag" are the only bridge to the Account.statusTag queues,
/// and only once a person explicitly links/routes a row (never automatic).
model CrmColdCallingEntry {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  serialNo        String?   @map("serial_no")
  callDate        DateTime? @map("call_date") @db.Timestamptz(6)
  companyName     String    @map("company_name")
  prospectName    String?   @map("prospect_name")
  designation     String?
  /// Raw outcome text as logged — free text, never a fixed enum (matches
  /// legacy: "Status values are free text ... future outcomes must not
  /// require a code change").
  status          String?
  linkedAccountId Int?      @map("linked_account_id")
  /// Set once a person routes this row via the existing StatusTagDialog —
  /// mirrors legacy's `dispositionTag`. Not written automatically.
  dispositionTag  String?   @map("disposition_tag")
  dispositionAt   DateTime? @map("disposition_at") @db.Timestamptz(6)
  /// Bulk-import auto-created custom columns (CrmCustomFieldDef key -> value)
  customFields    Json?     @map("custom_fields")
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id])
  linkedAccount Account?     @relation(fields: [linkedAccountId], references: [id])

  @@index([organizationId])
  @@index([organizationId, linkedAccountId], map: "crm_cold_calling_entries_org_linked_account_idx")
  @@map("crm_cold_calling_entries")
  @@schema("crm")
}

/// Legacy `AccountsMiningSheet.tsx` (`crm/accountsMiningSheet`) — an
/// independent prospecting dataset, deliberately NOT an Account/Lead. All
/// legacy columns are free text (kept as nullable strings here, matching
/// legacy). `promotedToLeadId` is the idempotent "Promote to Lead" link
/// (legacy `promotedToLeadRowId`): once set, the promote action is disabled.
model CrmMiningRow {
  id                Int       @id @default(autoincrement())
  organizationId    Int       @map("organization_id")
  serialNo          String?   @map("serial_no")
  minedDate         String?   @map("mined_date")
  domain            String?
  companyName       String    @map("company_name")
  hq                String?
  website           String?
  keyDecisionMakers String?   @map("key_decision_makers")
  title             String?
  contactNumber     String?   @map("contact_number")
  email             String?
  emailStatus       String?   @map("email_status")
  followUpStatus    String?   @map("follow_up_status")
  industry          String?
  numberOfEmployees String?   @map("number_of_employees")
  city              String?
  state             String?
  country           String?
  linkedInProfile   String?   @map("linkedin_profile")
  assignedTo        String?   @map("assigned_to")
  /// High|Medium|Low
  priority          String?
  nextFollowUpDate  String?   @map("next_follow_up_date")
  notes             String?
  promotedToLeadId  Int?      @map("promoted_to_lead_id")
  customFields      Json?     @map("custom_fields")
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("crm_mining_rows")
  @@schema("crm")
}

/// Company Seal masterlist + Authorized Signature masterlist, unified behind
/// one `kind` discriminator since both are "title + image data URI" cards
/// with the same CRUD shape — see Docs/SALES_SETTINGS_FOUNDATION.md for the
/// `SealSignatureKind` values. `signatoryName`/`designation` only apply to
/// kind = 'signature'.
model SealSignature {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  kind           String
  title          String
  signatoryName  String?   @map("signatory_name")
  designation    String?
  /// Base64 data URI (as uploaded from the UI — see screenshots in the
  /// foundation doc), not a file path. No file-storage integration yet.
  imageDataUri   String    @map("image_data_uri") @db.Text
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, kind])
  @@map("seal_signatures")
  @@schema("sales")
}

/// Legacy `domain/quotasService.ts` (`crm/quotas`). `repName` is free text
/// (matches legacy — no User FK; attainment name-matches Opportunity
/// ownerName case/whitespace-insensitively). Attainment is computed on
/// read, never stored.
model CrmQuota {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  repName        String    @map("rep_name")
  team           String?
  managerName    String?   @map("manager_name")
  targetOwner    String?   @map("target_owner")
  /// monthly|quarterly
  period         String
  /// YYYY-MM | YYYY-Q1..4
  periodKey      String    @map("period_key")
  startDate      DateTime? @map("start_date") @db.Timestamptz(6)
  endDate        DateTime? @map("end_date") @db.Timestamptz(6)
  targetAmount   Decimal   @map("target_amount") @db.Decimal(16, 2)
  /// revenue|closedWonValue|dealsWon
  metric         String    @default("closedWonValue")
  currency       String?
  notes          String?
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, periodKey])
  @@map("crm_quotas")
  @@schema("crm")
}

/// Terms & Inventory tab — the 8 simple "add/delete chip" lookup lists
/// (Payment Terms, Delivery Terms, Dispatch Modes, GST Rates, Item
/// Categories, Item Types, Item Groups, Units) unified behind one `category`
/// discriminator. Deliberately NOT modeled as 8 separate tables and NOT on
/// the code+name `MasterDataService` base used by HR's master-data module:
/// the UI treats every one of these as an unstructured, non-unique value
/// list (duplicate values are allowed, e.g. two "9%" GST rates in the
/// reference screenshots), so a single generic table is the accurate model,
/// not a simplification. `numericValue` is used by GST Rates (the
/// percentage) and left null for the others. See
/// Docs/SALES_SETTINGS_FOUNDATION.md for the `SalesMasterListCategory`
/// values and how a future Sales/SCM module should reference rows here by
/// id (never copy the label).
model SalesMasterListItem {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  category       String
  value          String
  numericValue   Decimal?  @map("numeric_value") @db.Decimal(10, 4)
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, category])
  @@map("sales_master_list_items")
  @@schema("sales")
}

/// Legacy `notifications/types.ts` `CrmNotification` (`crm/notifications/feed`).
/// Generated server-side from due dates on Meetings/FollowUps/Tasks/
/// Opportunities/Quotations/Accounts; (sourceType, sourceId, type, dueDate)
/// is the idempotency key so regeneration never duplicates a row.
/// `deletedAt` = the legacy "recycle-bin" tab (admin permanent-delete removes
/// the row).
model CrmNotification {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  sourceType     String    @map("source_type")
  sourceId       Int       @map("source_id")
  type           String
  title          String
  description    String?
  accountId      Int?      @map("account_id")
  companyName    String?   @map("company_name")
  prospectName   String?   @map("prospect_name")
  dueDate        DateTime  @map("due_date") @db.Timestamptz(6)
  /// Pending|Acknowledged|Done|Snoozed|Overdue
  status         String    @default("Pending")
  /// high|medium|low
  priority       String    @default("medium")
  isRead         Boolean   @default(false) @map("is_read")
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  snoozeUntil    DateTime? @map("snooze_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sourceType, sourceId, type, dueDate], map: "crm_notifications_dedupe_key")
  @@index([organizationId, status])
  @@map("crm_notifications")
  @@schema("crm")
}

/// Finance Master — `category` picks which card on the Finance Master page a
/// row belongs to (Expense Types, Payment Modes; see
/// `FinanceMasterListCategory`). Same generic value-list shape as
/// `SalesMasterListItem` (Docs/SALES_SETTINGS_FOUNDATION.md design decision
/// #2) — a future Finance module (expenses, payments) should reference a row
/// here by `id`, never copy `value`.
model FinanceMasterListItem {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  category       String
  value          String
  numericValue   Decimal?  @map("numeric_value") @db.Decimal(10, 4)
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, category])
  @@map("finance_master_list_items")
  @@schema("finance")
}

/// Legacy `bulkImport/crmCustomFieldsService.ts` (`crm/customFieldDefs`).
/// An unrecognised Excel header auto-creates one of these (idempotent on
/// normalised label); values live in each row's `customFields` JSON.
model CrmCustomFieldDef {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  /// leads|accountsMining|accounts|meetings|coldCalling
  module         String
  key            String
  label          String
  sourceHeader   String?  @map("source_header")
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, module, key], map: "crm_custom_field_defs_org_module_key")
  @@map("crm_custom_field_defs")
  @@schema("crm")
}

/// Lead notes (legacy `crm/notes/<leadId>`; `CrmNote` is account-only).
model CrmLeadNote {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  leadId         Int       @map("lead_id")
  content        String
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId])
  @@map("crm_lead_notes")
  @@schema("crm")
}

/// SCM Supplier master — migrated from legacy `contacts/vendors/{id}`
/// (Docs/SCM_LEGACY_PARITY.md §3). Org-wide reference data, no team
/// dimension. Legacy's Firebase `supplierCodeClaims` node is replaced by the
/// `(organization_id, supplier_code)` unique index. `status` is a plain
/// string (Active | Inactive | Pending Approval | Blocked) with no DB-enforced
/// transition guard — legacy never had a real approval workflow. The single
/// default address is stored as flat columns; the legacy-Purchases-only bank
/// fields and unused `category`/`trusted` are deliberately omitted.
model Supplier {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  supplierCode   String    @map("supplier_code")
  companyName    String    @map("company_name")
  type           String?
  status         String    @default("Active")
  gstin          String?
  pan            String?
  contactPerson  String    @map("contact_person")
  phone          String?
  email          String?
  street         String?
  city           String?
  state          String?
  country        String?   @default("India")
  pincode        String?
  paymentTerms   String?   @default("30 Days") @map("payment_terms")
  creditLimit    Decimal   @default(0) @map("credit_limit") @db.Decimal(14, 2)
  currency       String    @default("INR")
  leadTimeDays   Int       @default(0) @map("lead_time_days")
  rating         Int?
  notes          String?
  customFields   Json?     @map("custom_fields")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization           @relation(fields: [organizationId], references: [id])
  rfqSuppliers    ScmRfqSupplier[]
  quotations      ScmSupplierQuotation[]
  purchaseOrders  ScmPurchaseOrder[]
  goodsReceipts   ScmGoodsReceipt[]
  bills           ScmSupplierBill[]
  payments        ScmSupplierPayment[]
  documents       ScmSupplierDocument[]
  /// Back-relation only (no column on suppliers) — Projects expenses that
  /// reference this supplier.
  projectExpenses ProjectExpense[]

  @@unique([organizationId, supplierCode])
  @@index([organizationId, status])
  @@map("suppliers")
  @@schema("scm")
}

// ---------------------------------------------------------------------------
// SCM foundation + inventory (Docs/SCM_LEGACY_PARITY.md section 5). Quantities
// are Decimal(14,3), money Decimal(14,2). Legacy Firebase patterns (posting
// claims, action locks, composite string keys) are replaced by transactions,
// row locks and unique constraints.
// ---------------------------------------------------------------------------

/// Per-organization, per-prefix, per-financial-year document counter
/// (`TW/PR/26-27/0001`). Replaces the legacy Firebase transactional counter.
model ScmNumberSequence {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  prefix         String
  fiscalYear     String   @map("fiscal_year")
  lastValue      Int      @default(0) @map("last_value")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, prefix, fiscalYear])
  @@map("number_sequences")
  @@schema("scm")
}

/// SCM product master (inventory-owned settings merged in: reorder/min/max,
/// cost, batch/serial tracking). Replaces the legacy reconciliation of the
/// Sales module's dual-shape product records.
model ScmProduct {
  id                  Int       @id @default(autoincrement())
  organizationId      Int       @map("organization_id")
  productCode         String    @map("product_code")
  name                String
  category            String?
  uom                 String    @default("PCS")
  hsn                 String?
  unitPrice           Decimal   @default(0) @map("unit_price") @db.Decimal(14, 2)
  costPrice           Decimal   @default(0) @map("cost_price") @db.Decimal(14, 2)
  reorderLevel        Decimal?  @map("reorder_level") @db.Decimal(14, 3)
  minimumStock        Decimal?  @map("minimum_stock") @db.Decimal(14, 3)
  maximumStock        Decimal?  @map("maximum_stock") @db.Decimal(14, 3)
  batchTracked        Boolean   @default(false) @map("batch_tracked")
  serialTracked       Boolean   @default(false) @map("serial_tracked")
  description         String?
  /// Barcode value override; when null the barcode screens derive a Code128 value from productCode.
  barcode             String?
  /// When the product barcode was first generated (printed on the label).
  barcodeCreatedAt    DateTime? @map("barcode_created_at")
  /// Warehouse picked for this SKU; its default bin must belong to it.
  warehouseId         Int?      @map("warehouse_id")
  /// Manually assigned default bin location for this SKU.
  binLocationId       Int?      @map("bin_location_id")
  /// Product-level expiry, only read when no batch expiry data exists.
  expiryDate          DateTime? @map("expiry_date") @db.Date
  /// Explicit "does not expire" flag, distinct from a never-set date.
  expiryNotApplicable Boolean   @default(false) @map("expiry_not_applicable")
  isActive            Boolean   @default(true) @map("is_active")
  createdBy           Int?      @map("created_by")
  updatedBy           Int?      @map("updated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  organization           Organization                 @relation(fields: [organizationId], references: [id])
  warehouse              ScmWarehouse?                @relation("ProductWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  binLocation            ScmWarehouseLocation?        @relation("ProductBinLocation", fields: [binLocationId], references: [id], onDelete: SetNull)
  balances               ScmStockBalance[]
  ledger                 ScmStockLedgerEntry[]
  batches                ScmStockBatch[]
  serials                ScmSerialNumber[]
  reservations           ScmStockReservation[]
  transfers              ScmStockTransfer[]
  adjustments            ScmStockAdjustment[]
  requisitionItems       ScmPurchaseRequisitionItem[]
  rfqItems               ScmRfqItem[]
  quotationItems         ScmSupplierQuotationItem[]
  purchaseOrderItems     ScmPurchaseOrderItem[]
  goodsReceiptItems      ScmGoodsReceiptItem[]
  salesOrderItems        ScmSalesOrderItem[]
  fulfillmentItems       ScmFulfillmentItem[]
  pickingItems           ScmPickingItem[]
  packingPackageItems    ScmPackingPackageItem[]
  returnItems            ScmReturnItem[]
  qualityInspectionItems ScmQualityInspectionItem[]
  quarantineRecords      ScmQuarantineRecord[]
  locationStock          ScmLocationStock[]
  putawayItems           ScmPutawayItem[]
  movementItems          ScmWarehouseMovementItem[]

  @@unique([organizationId, productCode])
  @@unique([organizationId, barcode])
  @@map("products")
  @@schema("scm")
}

model ScmWarehouse {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  name           String
  /// Main | Regional | Transit | Virtual | Other | Distribution | Fulfillment | Returns
  type           String    @default("Main")
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?   @map("postal_code")
  managerName    String?   @map("manager_name")
  status         String    @default("Active")
  contactPerson  String?   @map("contact_person")
  phone          String?
  email          String?
  capacity       Decimal?  @db.Decimal(14, 3)
  capacityUnit   String?   @map("capacity_unit")
  operatingHours String?   @map("operating_hours")
  notes          String?
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization      Organization             @relation(fields: [organizationId], references: [id])
  locations         ScmWarehouseLocation[]
  products          ScmProduct[]             @relation("ProductWarehouse")
  balances          ScmStockBalance[]
  ledger            ScmStockLedgerEntry[]
  batches           ScmStockBatch[]
  serials           ScmSerialNumber[]
  reservations      ScmStockReservation[]
  adjustments       ScmStockAdjustment[]
  transfersOut      ScmStockTransfer[]       @relation("TransferSource")
  transfersIn       ScmStockTransfer[]       @relation("TransferDestination")
  requisitions      ScmPurchaseRequisition[]
  rfqs              ScmRfq[]
  purchaseOrders    ScmPurchaseOrder[]
  goodsReceipts     ScmGoodsReceipt[]
  fulfillments      ScmFulfillment[]
  pickings          ScmPicking[]
  packings          ScmPacking[]
  shipments         ScmShipment[]
  returns           ScmReturn[]
  quarantineRecords ScmQuarantineRecord[]
  locationStock     ScmLocationStock[]
  putaways          ScmPutaway[]
  movements         ScmWarehouseMovement[]

  @@unique([organizationId, code])
  @@map("warehouses")
  @@schema("scm")
}

/// Zone -> Rack -> Shelf -> Bin hierarchy. `locationCode` is unique per warehouse.
model ScmWarehouseLocation {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  warehouseId      Int       @map("warehouse_id")
  parentLocationId Int?      @map("parent_location_id")
  /// ZONE | RACK | SHELF | BIN
  locationType     String?   @map("location_type")
  locationCode     String?   @map("location_code")
  zone             String?
  rack             String?
  shelf            String?
  binCode          String    @map("bin_code")
  locationName     String?   @map("location_name")
  capacity         Decimal?  @db.Decimal(14, 3)
  capacityUnit     String?   @map("capacity_unit")
  notes            String?
  status           String    @default("Active")
  createdBy        Int?      @map("created_by")
  updatedBy        Int?      @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  organization  Organization           @relation(fields: [organizationId], references: [id])
  warehouse     ScmWarehouse           @relation(fields: [warehouseId], references: [id])
  parent        ScmWarehouseLocation?  @relation("LocationTree", fields: [parentLocationId], references: [id])
  children      ScmWarehouseLocation[] @relation("LocationTree")
  products      ScmProduct[]           @relation("ProductBinLocation")
  locationStock ScmLocationStock[]

  @@unique([warehouseId, locationCode])
  @@index([organizationId, warehouseId])
  @@map("warehouse_locations")
  @@schema("scm")
}

/// Materialized on-hand snapshot, one row per product per warehouse. The
/// ledger stays authoritative; this row is only ever changed by StockService
/// inside the same transaction as the ledger insert, under a row lock.
model ScmStockBalance {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  productId      Int      @map("product_id")
  warehouseId    Int      @map("warehouse_id")
  onHand         Decimal  @default(0) @map("on_hand") @db.Decimal(14, 3)
  reserved       Decimal  @default(0) @db.Decimal(14, 3)
  incoming       Decimal  @default(0) @db.Decimal(14, 3)
  damaged        Decimal  @default(0) @db.Decimal(14, 3)
  quarantine     Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      ScmProduct   @relation(fields: [productId], references: [id])
  warehouse    ScmWarehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([organizationId, warehouseId])
  @@map("stock_balances")
  @@schema("scm")
}

/// Append-only (DB trigger) stock history. Corrections are new offsetting rows.
/// `idempotencyKey` replaces legacy `postOnce` claims: a retried posting with
/// the same key is a no-op that returns the original entry.
model ScmStockLedgerEntry {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  productId       Int      @map("product_id")
  warehouseId     Int      @map("warehouse_id")
  locationId      Int?     @map("location_id")
  batchId         Int?     @map("batch_id")
  serialId        Int?     @map("serial_id")
  transactionType String   @map("transaction_type")
  referenceType   String   @map("reference_type")
  referenceId     Int?     @map("reference_id")
  referenceNumber String?  @map("reference_number")
  quantityIn      Decimal  @default(0) @map("quantity_in") @db.Decimal(14, 3)
  quantityOut     Decimal  @default(0) @map("quantity_out") @db.Decimal(14, 3)
  unitCost        Decimal? @map("unit_cost") @db.Decimal(14, 2)
  transactionDate DateTime @default(now()) @map("transaction_date")
  idempotencyKey  String?  @map("idempotency_key")
  notes           String?
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      ScmProduct   @relation(fields: [productId], references: [id])
  warehouse    ScmWarehouse @relation(fields: [warehouseId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, productId, warehouseId])
  @@index([organizationId, referenceType, referenceId])
  @@index([organizationId, transactionDate])
  @@map("stock_ledger")
  @@schema("scm")
}

model ScmStockBatch {
  id                Int       @id @default(autoincrement())
  organizationId    Int       @map("organization_id")
  batchNumber       String    @map("batch_number")
  productId         Int       @map("product_id")
  warehouseId       Int       @map("warehouse_id")
  locationId        Int?      @map("location_id")
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  quantity          Decimal   @default(0) @db.Decimal(14, 3)
  /// ACTIVE | EXPIRED | QUARANTINED | BLOCKED
  status            String    @default("ACTIVE")
  createdBy         Int?      @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      ScmProduct   @relation(fields: [productId], references: [id])
  warehouse    ScmWarehouse @relation(fields: [warehouseId], references: [id])

  @@unique([organizationId, batchNumber, productId, warehouseId])
  @@map("stock_batches")
  @@schema("scm")
}

model ScmSerialNumber {
  id               Int      @id @default(autoincrement())
  organizationId   Int      @map("organization_id")
  serialNumber     String   @map("serial_number")
  productId        Int      @map("product_id")
  warehouseId      Int      @map("warehouse_id")
  locationId       Int?     @map("location_id")
  /// AVAILABLE | RESERVED | SOLD | TRANSFERRED | DAMAGED | RETURNED | QUARANTINED
  status           String   @default("AVAILABLE")
  currentReference String?  @map("current_reference")
  createdBy        Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      ScmProduct   @relation(fields: [productId], references: [id])
  warehouse    ScmWarehouse @relation(fields: [warehouseId], references: [id])

  @@unique([organizationId, serialNumber])
  @@map("serial_numbers")
  @@schema("scm")
}

model ScmStockReservation {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  productId        Int       @map("product_id")
  warehouseId      Int       @map("warehouse_id")
  salesOrderId     Int?      @map("sales_order_id")
  salesOrderNumber String?   @map("sales_order_number")
  fulfillmentId    Int?      @map("fulfillment_id")
  quantity         Decimal   @db.Decimal(14, 3)
  /// ACTIVE | RELEASED | FULFILLED | CANCELLED
  status           String    @default("ACTIVE")
  notes            String?
  createdBy        Int?      @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  releasedBy       Int?      @map("released_by")
  releasedAt       DateTime? @map("released_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  product      ScmProduct      @relation(fields: [productId], references: [id])
  warehouse    ScmWarehouse    @relation(fields: [warehouseId], references: [id])
  salesOrder   ScmSalesOrder?  @relation(fields: [salesOrderId], references: [id])
  fulfillment  ScmFulfillment? @relation(fields: [fulfillmentId], references: [id])

  @@index([organizationId, status])
  @@map("stock_reservations")
  @@schema("scm")
}

model ScmStockTransfer {
  id                     Int       @id @default(autoincrement())
  organizationId         Int       @map("organization_id")
  transferNumber         String    @map("transfer_number")
  productId              Int       @map("product_id")
  sourceWarehouseId      Int       @map("source_warehouse_id")
  sourceLocationId       Int?      @map("source_location_id")
  destinationWarehouseId Int       @map("destination_warehouse_id")
  destinationLocationId  Int?      @map("destination_location_id")
  quantity               Decimal   @db.Decimal(14, 3)
  /// DRAFT | REQUESTED | APPROVED | IN_TRANSIT | RECEIVED | CANCELLED
  status                 String    @default("REQUESTED")
  notes                  String?
  requestedBy            Int?      @map("requested_by")
  approvedBy             Int?      @map("approved_by")
  dispatchedBy           Int?      @map("dispatched_by")
  receivedBy             Int?      @map("received_by")
  approvedAt             DateTime? @map("approved_at")
  dispatchedAt           DateTime? @map("dispatched_at")
  receivedAt             DateTime? @map("received_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization         Organization @relation(fields: [organizationId], references: [id])
  product              ScmProduct   @relation(fields: [productId], references: [id])
  sourceWarehouse      ScmWarehouse @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse ScmWarehouse @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])

  @@unique([organizationId, transferNumber])
  @@map("stock_transfers")
  @@schema("scm")
}

model ScmStockAdjustment {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  adjustmentNumber String    @map("adjustment_number")
  productId        Int       @map("product_id")
  warehouseId      Int       @map("warehouse_id")
  locationId       Int?      @map("location_id")
  quantity         Decimal   @db.Decimal(14, 3)
  /// IN | OUT
  direction        String
  reason           String
  notes            String?
  /// PENDING | APPROVED | REJECTED
  status           String    @default("PENDING")
  requestedBy      Int?      @map("requested_by")
  approvedBy       Int?      @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      ScmProduct   @relation(fields: [productId], references: [id])
  warehouse    ScmWarehouse @relation(fields: [warehouseId], references: [id])

  @@unique([organizationId, adjustmentNumber])
  @@map("stock_adjustments")
  @@schema("scm")
}

// ---------------------------------------------------------------------------
// SCM procurement: PR -> RFQ -> Supplier Quotation -> Comparison -> PO -> GRN
// (Docs/SCM_LEGACY_PARITY.md section 4). Documents keep point-in-time name
// snapshots where legacy intentionally froze them (supplier name/GSTIN, line
// product names); everything else is a live join. Totals are always computed
// server-side.
// ---------------------------------------------------------------------------

model ScmPurchaseRequisition {
  id                     Int       @id @default(autoincrement())
  organizationId         Int       @map("organization_id")
  requisitionNumber      String    @map("requisition_number")
  requestedBy            Int?      @map("requested_by")
  requestedByName        String    @map("requested_by_name")
  department             String?
  requestDate            DateTime  @map("request_date") @db.Date
  requiredDate           DateTime? @map("required_date") @db.Date
  /// Low | Normal | High | Urgent
  priority               String    @default("Normal")
  warehouseId            Int       @map("warehouse_id")
  locationId             Int?      @map("location_id")
  purpose                String?
  notes                  String?
  subtotal               Decimal   @default(0) @db.Decimal(14, 2)
  tax                    Decimal   @default(0) @db.Decimal(14, 2)
  total                  Decimal   @default(0) @db.Decimal(14, 2)
  /// DRAFT | SUBMITTED | APPROVED | REJECTED | CANCELLED | CONVERTED
  status                 String    @default("DRAFT")
  approvedBy             Int?      @map("approved_by")
  approvedByName         String?   @map("approved_by_name")
  approvedAt             DateTime? @map("approved_at")
  rejectionReason        String?   @map("rejection_reason")
  sourceSalesOrderId     Int?      @map("source_sales_order_id")
  sourceSalesOrderNumber String?   @map("source_sales_order_number")
  fulfillmentId          Int?      @map("fulfillment_id")
  createdBy              Int?      @map("created_by")
  updatedBy              Int?      @map("updated_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization     Organization                 @relation(fields: [organizationId], references: [id])
  warehouse        ScmWarehouse                 @relation(fields: [warehouseId], references: [id])
  items            ScmPurchaseRequisitionItem[]
  rfqs             ScmRfq[]
  purchaseOrders   ScmPurchaseOrder[]
  sourceSalesOrder ScmSalesOrder?               @relation(fields: [sourceSalesOrderId], references: [id])
  fulfillment      ScmFulfillment?              @relation(fields: [fulfillmentId], references: [id])

  @@unique([organizationId, requisitionNumber])
  @@index([organizationId, status])
  @@map("purchase_requisitions")
  @@schema("scm")
}

model ScmPurchaseRequisitionItem {
  id                  Int       @id @default(autoincrement())
  requisitionId       Int       @map("requisition_id")
  lineNo              Int       @map("line_no")
  productId           Int       @map("product_id")
  productNameSnapshot String    @map("product_name_snapshot")
  uom                 String
  quantity            Decimal   @db.Decimal(14, 3)
  estimatedUnitCost   Decimal   @default(0) @map("estimated_unit_cost") @db.Decimal(14, 2)
  estimatedTotal      Decimal   @default(0) @map("estimated_total") @db.Decimal(14, 2)
  requiredDate        DateTime? @map("required_date") @db.Date
  notes               String?

  requisition ScmPurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     ScmProduct             @relation(fields: [productId], references: [id])

  @@index([requisitionId])
  @@map("purchase_requisition_items")
  @@schema("scm")
}

model ScmRfq {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  rfqNumber        String    @map("rfq_number")
  requisitionId    Int?      @map("requisition_id")
  issueDate        DateTime  @map("issue_date") @db.Date
  responseDueDate  DateTime? @map("response_due_date") @db.Date
  warehouseId      Int       @map("warehouse_id")
  deliveryLocation String?   @map("delivery_location")
  currency         String    @default("INR")
  paymentTerms     String?   @map("payment_terms")
  deliveryTerms    String?   @map("delivery_terms")
  notes            String?
  /// DRAFT | RESPONSES_PENDING | PARTIALLY_RESPONDED | RESPONDED | CLOSED | CANCELLED
  status           String    @default("DRAFT")
  createdBy        Int?      @map("created_by")
  updatedBy        Int?      @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization   Organization             @relation(fields: [organizationId], references: [id])
  warehouse      ScmWarehouse             @relation(fields: [warehouseId], references: [id])
  requisition    ScmPurchaseRequisition?  @relation(fields: [requisitionId], references: [id])
  items          ScmRfqItem[]
  suppliers      ScmRfqSupplier[]
  quotations     ScmSupplierQuotation[]
  comparisons    ScmQuotationComparison[]
  purchaseOrders ScmPurchaseOrder[]

  @@unique([organizationId, rfqNumber])
  @@index([organizationId, status])
  @@map("rfqs")
  @@schema("scm")
}

model ScmRfqItem {
  id                  Int     @id @default(autoincrement())
  rfqId               Int     @map("rfq_id")
  lineNo              Int     @map("line_no")
  productId           Int     @map("product_id")
  productNameSnapshot String  @map("product_name_snapshot")
  uom                 String
  quantity            Decimal @db.Decimal(14, 3)
  notes               String?

  rfq     ScmRfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product ScmProduct @relation(fields: [productId], references: [id])

  @@index([rfqId])
  @@map("rfq_items")
  @@schema("scm")
}

/// Many-to-many RFQ <-> Supplier (legacy `supplierIds[]` + name snapshot map).
model ScmRfqSupplier {
  id                   Int    @id @default(autoincrement())
  rfqId                Int    @map("rfq_id")
  supplierId           Int    @map("supplier_id")
  supplierNameSnapshot String @map("supplier_name_snapshot")

  rfq      ScmRfq   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([rfqId, supplierId])
  @@map("rfq_suppliers")
  @@schema("scm")
}

model ScmSupplierQuotation {
  id                      Int       @id @default(autoincrement())
  organizationId          Int       @map("organization_id")
  quotationNumber         String    @map("quotation_number")
  supplierQuotationNumber String?   @map("supplier_quotation_number")
  rfqId                   Int       @map("rfq_id")
  supplierId              Int       @map("supplier_id")
  vendorNameSnapshot      String    @map("vendor_name_snapshot")
  vendorGstinSnapshot     String?   @map("vendor_gstin_snapshot")
  quotationDate           DateTime  @map("quotation_date") @db.Date
  validUntil              DateTime? @map("valid_until") @db.Date
  currency                String    @default("INR")
  paymentTerms            String?   @map("payment_terms")
  deliveryTerms           String?   @map("delivery_terms")
  freight                 Decimal   @default(0) @db.Decimal(14, 2)
  discount                Decimal   @default(0) @db.Decimal(14, 2)
  tax                     Decimal   @default(0) @db.Decimal(14, 2)
  subtotal                Decimal   @default(0) @db.Decimal(14, 2)
  total                   Decimal   @default(0) @db.Decimal(14, 2)
  notes                   String?
  /// RECEIVED | SHORTLISTED | SELECTED | REJECTED | CANCELLED
  status                  String    @default("RECEIVED")
  createdBy               Int?      @map("created_by")
  updatedBy               Int?      @map("updated_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  organization   Organization               @relation(fields: [organizationId], references: [id])
  rfq            ScmRfq                     @relation(fields: [rfqId], references: [id])
  supplier       Supplier                   @relation(fields: [supplierId], references: [id])
  items          ScmSupplierQuotationItem[]
  purchaseOrders ScmPurchaseOrder[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId, rfqId])
  @@map("supplier_quotations")
  @@schema("scm")
}

model ScmSupplierQuotationItem {
  id                   Int       @id @default(autoincrement())
  quotationId          Int       @map("quotation_id")
  lineNo               Int       @map("line_no")
  productId            Int       @map("product_id")
  productNameSnapshot  String    @map("product_name_snapshot")
  uom                  String
  quantity             Decimal   @db.Decimal(14, 3)
  unitPrice            Decimal   @default(0) @map("unit_price") @db.Decimal(14, 2)
  discount             Decimal   @default(0) @db.Decimal(14, 2)
  taxRate              Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total                Decimal   @default(0) @db.Decimal(14, 2)
  promisedDeliveryDate DateTime? @map("promised_delivery_date") @db.Date
  notes                String?

  quotation ScmSupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   ScmProduct           @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@map("supplier_quotation_items")
  @@schema("scm")
}

/// One saved comparison decision per save (history), as legacy. Selecting a
/// quotation also moves the quotations' statuses, in one transaction.
model ScmQuotationComparison {
  id                   Int       @id @default(autoincrement())
  organizationId       Int       @map("organization_id")
  rfqId                Int       @map("rfq_id")
  quotationIds         Int[]     @map("quotation_ids")
  selectedQuotationIds Int[]     @map("selected_quotation_ids")
  selectedBy           Int?      @map("selected_by")
  selectedAt           DateTime? @map("selected_at")
  remarks              String?
  /// OPEN | DECIDED
  status               String    @default("OPEN")
  createdBy            Int?      @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  rfq          ScmRfq       @relation(fields: [rfqId], references: [id])

  @@index([organizationId, rfqId])
  @@map("quotation_comparisons")
  @@schema("scm")
}

model ScmPurchaseOrder {
  id                   Int       @id @default(autoincrement())
  organizationId       Int       @map("organization_id")
  poNumber             String    @map("po_number")
  supplierId           Int       @map("supplier_id")
  vendorNameSnapshot   String    @map("vendor_name_snapshot")
  vendorGstinSnapshot  String?   @map("vendor_gstin_snapshot")
  rfqId                Int?      @map("rfq_id")
  quotationId          Int?      @map("quotation_id")
  /// Material Requisition this PO was raised from (PO form "Link Material Requisition").
  /// `requisitionNumber` is a snapshot so the link still displays if the MR is deleted.
  requisitionId        Int?      @map("requisition_id")
  requisitionNumber    String?   @map("requisition_number")
  poDate               DateTime  @map("po_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  warehouseId          Int       @map("warehouse_id")
  deliveryLocation     String?   @map("delivery_location")
  paymentTerms         String?   @map("payment_terms")
  currency             String    @default("INR")
  freight              Decimal   @default(0) @db.Decimal(14, 2)
  discount             Decimal   @default(0) @db.Decimal(14, 2)
  subtotal             Decimal   @default(0) @db.Decimal(14, 2)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total                Decimal   @default(0) @db.Decimal(14, 2)
  notes                String?
  /// DRAFT | PENDING_APPROVAL | APPROVED | SENT | PARTIALLY_RECEIVED | RECEIVED | CANCELLED | CLOSED
  status               String    @default("DRAFT")
  approvedBy           Int?      @map("approved_by")
  approvedByName       String?   @map("approved_by_name")
  approvedAt           DateTime? @map("approved_at")
  /// True once StockBalance.incoming was raised for this PO's unreceived qty.
  incomingApplied      Boolean   @default(false) @map("incoming_applied")
  createdBy            Int?      @map("created_by")
  updatedBy            Int?      @map("updated_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id])
  supplier     Supplier                @relation(fields: [supplierId], references: [id])
  warehouse    ScmWarehouse            @relation(fields: [warehouseId], references: [id])
  rfq          ScmRfq?                 @relation(fields: [rfqId], references: [id])
  quotation    ScmSupplierQuotation?   @relation(fields: [quotationId], references: [id])
  requisition  ScmPurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  items        ScmPurchaseOrderItem[]
  receipts     ScmGoodsReceipt[]
  bills        ScmSupplierBill[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, status])
  @@index([requisitionId])
  @@map("purchase_orders")
  @@schema("scm")
}

model ScmPurchaseOrderItem {
  id                  Int     @id @default(autoincrement())
  purchaseOrderId     Int     @map("purchase_order_id")
  lineNo              Int     @map("line_no")
  productId           Int     @map("product_id")
  productNameSnapshot String  @map("product_name_snapshot")
  uom                 String
  quantity            Decimal @db.Decimal(14, 3)
  receivedQuantity    Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)
  unitPrice           Decimal @default(0) @map("unit_price") @db.Decimal(14, 2)
  discount            Decimal @default(0) @db.Decimal(14, 2)
  taxRate             Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount           Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total               Decimal @default(0) @db.Decimal(14, 2)

  purchaseOrder ScmPurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       ScmProduct            @relation(fields: [productId], references: [id])
  receiptItems  ScmGoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
  @@schema("scm")
}

/// A GRN is posted atomically with its stock effects, so it is only ever
/// COMPLETED (or later CANCELLED); legacy's DRAFT-then-"Retry posting" state
/// existed only to survive Firebase's lack of transactions.
model ScmGoodsReceipt {
  id                 Int      @id @default(autoincrement())
  organizationId     Int      @map("organization_id")
  grnNumber          String   @map("grn_number")
  purchaseOrderId    Int      @map("purchase_order_id")
  supplierId         Int      @map("supplier_id")
  vendorNameSnapshot String   @map("vendor_name_snapshot")
  receiptDate        DateTime @map("receipt_date") @db.Date
  warehouseId        Int      @map("warehouse_id")
  locationId         Int?     @map("location_id")
  receivedBy         Int?     @map("received_by")
  receivedByName     String   @map("received_by_name")
  notes              String?
  /// COMPLETED | CANCELLED
  status             String   @default("COMPLETED")
  createdBy          Int?     @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization  Organization          @relation(fields: [organizationId], references: [id])
  purchaseOrder ScmPurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  warehouse     ScmWarehouse          @relation(fields: [warehouseId], references: [id])
  items         ScmGoodsReceiptItem[]
  bills         ScmSupplierBill[]

  @@unique([organizationId, grnNumber])
  @@index([organizationId, purchaseOrderId])
  @@map("goods_receipts")
  @@schema("scm")
}

model ScmGoodsReceiptItem {
  id                         Int      @id @default(autoincrement())
  goodsReceiptId             Int      @map("goods_receipt_id")
  purchaseOrderItemId        Int      @map("purchase_order_item_id")
  productId                  Int      @map("product_id")
  productNameSnapshot        String   @map("product_name_snapshot")
  uom                        String
  orderedQuantity            Decimal  @map("ordered_quantity") @db.Decimal(14, 3)
  previouslyReceivedQuantity Decimal  @map("previously_received_quantity") @db.Decimal(14, 3)
  receivingQuantity          Decimal  @map("receiving_quantity") @db.Decimal(14, 3)
  rejectedQuantity           Decimal  @default(0) @map("rejected_quantity") @db.Decimal(14, 3)
  acceptedQuantity           Decimal  @map("accepted_quantity") @db.Decimal(14, 3)
  batchNumber                String?  @map("batch_number")
  serialNumbers              String[] @map("serial_numbers")
  unitCost                   Decimal  @default(0) @map("unit_cost") @db.Decimal(14, 2)
  totalCost                  Decimal  @default(0) @map("total_cost") @db.Decimal(14, 2)
  notes                      String?

  goodsReceipt      ScmGoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem ScmPurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product           ScmProduct           @relation(fields: [productId], references: [id])

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
  @@schema("scm")
}

// ---------------------------------------------------------------------------
// SCM sales orders, fulfillment, picking/packing, logistics
// (Docs/SCM_LEGACY_PARITY.md section 6). The new ERP has no Sales module, so a
// minimal SCM-owned customer + sales order exists as the demand source; it can
// be re-pointed at a real Sales module later. Fulfillment never duplicates the
// order — it tracks the slice of it being worked and rolls progress into one
// status.
// ---------------------------------------------------------------------------

model ScmCustomer {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  customerCode    String    @map("customer_code")
  name            String
  contactPerson   String?   @map("contact_person")
  email           String?
  phone           String?
  gstin           String?
  billingAddress  String?   @map("billing_address")
  shippingAddress String?   @map("shipping_address")
  status          String    @default("Active")
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  salesOrders  ScmSalesOrder[]
  fulfillments ScmFulfillment[]
  shipments    ScmShipment[]

  @@unique([organizationId, customerCode])
  @@map("customers")
  @@schema("scm")
}

model ScmSalesOrder {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  soNumber       String    @map("so_number")
  customerId     Int       @map("customer_id")
  customerName   String    @map("customer_name")
  orderDate      DateTime  @map("order_date") @db.Date
  expectedDate   DateTime? @map("expected_date") @db.Date
  shipToAddress  String?   @map("ship_to_address")
  billToAddress  String?   @map("bill_to_address")
  currency       String    @default("INR")
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  notes          String?
  /// DRAFT | CONFIRMED | CANCELLED | CLOSED (CONFIRMED orders may be fulfilled)
  status         String    @default("DRAFT")
  /// Not Shipped | Partially Shipped | Shipped (rolled up from dispatched shipments)
  shippedStatus  String    @default("Not Shipped") @map("shipped_status")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id])
  customer     ScmCustomer              @relation(fields: [customerId], references: [id])
  items        ScmSalesOrderItem[]
  fulfillments ScmFulfillment[]
  pickings     ScmPicking[]
  shipments    ScmShipment[]
  reservations ScmStockReservation[]
  requisitions ScmPurchaseRequisition[]

  @@unique([organizationId, soNumber])
  @@index([organizationId, status])
  @@map("sales_orders")
  @@schema("scm")
}

model ScmSalesOrderItem {
  id              Int     @id @default(autoincrement())
  salesOrderId    Int     @map("sales_order_id")
  lineNo          Int     @map("line_no")
  productId       Int     @map("product_id")
  itemCode        String  @map("item_code")
  itemDescription String  @map("item_description")
  uom             String
  salesQty        Decimal @map("sales_qty") @db.Decimal(14, 3)
  unitPrice       Decimal @default(0) @map("unit_price") @db.Decimal(14, 2)
  taxRate         Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  total           Decimal @default(0) @db.Decimal(14, 2)

  salesOrder       ScmSalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product          ScmProduct           @relation(fields: [productId], references: [id])
  fulfillmentItems ScmFulfillmentItem[]

  @@index([salesOrderId])
  @@map("sales_order_items")
  @@schema("scm")
}

model ScmFulfillment {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  fulfillmentNumber  String    @map("fulfillment_number")
  salesOrderId       Int       @map("sales_order_id")
  salesOrderNumber   String    @map("sales_order_number")
  customerId         Int       @map("customer_id")
  customerName       String    @map("customer_name")
  warehouseId        Int       @map("warehouse_id")
  /// PENDING | PARTIALLY_AVAILABLE | AVAILABLE | RESERVED | PICKING | PACKING | READY_TO_SHIP | FULFILLED | CANCELLED | ON_HOLD
  status             String    @default("AVAILABLE")
  /// NOT_DELIVERED | PARTIALLY_DELIVERED | DELIVERED
  deliveryStatus     String    @default("NOT_DELIVERED") @map("delivery_status")
  deliveredAt        DateTime? @map("delivered_at")
  cancelledBy        Int?      @map("cancelled_by")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  notes              String?
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id])
  salesOrder   ScmSalesOrder            @relation(fields: [salesOrderId], references: [id])
  customer     ScmCustomer              @relation(fields: [customerId], references: [id])
  warehouse    ScmWarehouse             @relation(fields: [warehouseId], references: [id])
  items        ScmFulfillmentItem[]
  pickings     ScmPicking[]
  packings     ScmPacking[]
  shipments    ScmShipment[]
  reservations ScmStockReservation[]
  requisitions ScmPurchaseRequisition[]

  @@unique([organizationId, fulfillmentNumber])
  @@index([organizationId, status])
  @@index([salesOrderId])
  @@map("fulfillments")
  @@schema("scm")
}

model ScmFulfillmentItem {
  id               Int     @id @default(autoincrement())
  fulfillmentId    Int     @map("fulfillment_id")
  lineNo           Int     @map("line_no")
  /// The sales-order line this slice covers (a SO may repeat a product).
  salesOrderItemId Int     @map("sales_order_item_id")
  productId        Int     @map("product_id")
  itemCode         String  @map("item_code")
  itemDescription  String  @map("item_description")
  uom              String
  orderedQty       Decimal @map("ordered_qty") @db.Decimal(14, 3)
  reservedQty      Decimal @default(0) @map("reserved_qty") @db.Decimal(14, 3)
  issuedQty        Decimal @default(0) @map("issued_qty") @db.Decimal(14, 3)

  fulfillment    ScmFulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  salesOrderItem ScmSalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  product        ScmProduct        @relation(fields: [productId], references: [id])

  @@index([fulfillmentId])
  @@map("fulfillment_items")
  @@schema("scm")
}

model ScmPicking {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  pickNumber       String    @map("pick_number")
  salesOrderId     Int       @map("sales_order_id")
  salesOrderNumber String    @map("sales_order_number")
  fulfillmentId    Int       @map("fulfillment_id")
  warehouseId      Int       @map("warehouse_id")
  pickerId         Int?      @map("picker_id")
  pickerName       String?   @map("picker_name")
  /// Low | Normal | High | Urgent
  priority         String    @default("Normal")
  /// PENDING | ASSIGNED | IN_PROGRESS | PARTIALLY_PICKED | COMPLETED | CANCELLED
  status           String    @default("PENDING")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  /// Set when the fulfillment's SALES_ISSUE posts: the units left their bins.
  stockIssuedAt    DateTime? @map("stock_issued_at")
  notes            String?
  createdBy        Int?      @map("created_by")
  updatedBy        Int?      @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  salesOrder   ScmSalesOrder    @relation(fields: [salesOrderId], references: [id])
  fulfillment  ScmFulfillment   @relation(fields: [fulfillmentId], references: [id])
  warehouse    ScmWarehouse     @relation(fields: [warehouseId], references: [id])
  items        ScmPickingItem[]
  packings     ScmPacking[]

  @@unique([organizationId, pickNumber])
  @@index([organizationId, status])
  @@index([fulfillmentId])
  @@map("pickings")
  @@schema("scm")
}

model ScmPickingItem {
  id                Int      @id @default(autoincrement())
  pickingId         Int      @map("picking_id")
  productId         Int      @map("product_id")
  productCode       String   @map("product_code")
  productName       String   @map("product_name")
  requestedQuantity Decimal  @map("requested_quantity") @db.Decimal(14, 3)
  pickedQuantity    Decimal  @default(0) @map("picked_quantity") @db.Decimal(14, 3)
  sourceLocationId  Int?     @map("source_location_id")
  batchId           Int?     @map("batch_id")
  serialNumbers     String[] @map("serial_numbers")
  notes             String?

  picking ScmPicking @relation(fields: [pickingId], references: [id], onDelete: Cascade)
  product ScmProduct @relation(fields: [productId], references: [id])

  @@index([pickingId])
  @@map("picking_items")
  @@schema("scm")
}

model ScmPacking {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  packNumber       String    @map("pack_number")
  pickingId        Int       @map("picking_id")
  salesOrderId     Int       @map("sales_order_id")
  salesOrderNumber String    @map("sales_order_number")
  fulfillmentId    Int       @map("fulfillment_id")
  warehouseId      Int       @map("warehouse_id")
  packerId         Int?      @map("packer_id")
  packerName       String?   @map("packer_name")
  /// PENDING | IN_PROGRESS | PACKED | CANCELLED
  status           String    @default("PENDING")
  completedAt      DateTime? @map("completed_at")
  notes            String?
  createdBy        Int?      @map("created_by")
  updatedBy        Int?      @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [organizationId], references: [id])
  picking       ScmPicking           @relation(fields: [pickingId], references: [id])
  fulfillment   ScmFulfillment       @relation(fields: [fulfillmentId], references: [id])
  warehouse     ScmWarehouse         @relation(fields: [warehouseId], references: [id])
  packages      ScmPackingPackage[]
  shipmentLinks ScmShipmentPacking[]

  @@unique([organizationId, packNumber])
  @@index([organizationId, status])
  @@index([fulfillmentId])
  @@map("packings")
  @@schema("scm")
}

model ScmPackingPackage {
  id            Int      @id @default(autoincrement())
  packingId     Int      @map("packing_id")
  packageNumber String   @map("package_number")
  packageType   String?  @map("package_type")
  weight        Decimal? @db.Decimal(14, 3)
  length        Decimal? @db.Decimal(14, 3)
  width         Decimal? @db.Decimal(14, 3)
  height        Decimal? @db.Decimal(14, 3)
  notes         String?

  packing ScmPacking              @relation(fields: [packingId], references: [id], onDelete: Cascade)
  items   ScmPackingPackageItem[]

  @@index([packingId])
  @@map("packing_packages")
  @@schema("scm")
}

model ScmPackingPackageItem {
  id          Int     @id @default(autoincrement())
  packageId   Int     @map("package_id")
  productId   Int     @map("product_id")
  productCode String  @map("product_code")
  productName String  @map("product_name")
  quantity    Decimal @db.Decimal(14, 3)

  package ScmPackingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product ScmProduct        @relation(fields: [productId], references: [id])

  @@index([packageId])
  @@map("packing_package_items")
  @@schema("scm")
}

model ScmCarrier {
  id                  Int      @id @default(autoincrement())
  organizationId      Int      @map("organization_id")
  carrierCode         String   @map("carrier_code")
  carrierName         String   @map("carrier_name")
  serviceTypes        String[] @map("service_types")
  contact             String?
  phone               String?
  email               String?
  website             String?
  /// e.g. https://track.example.com/{trackingNumber}
  trackingUrlTemplate String?  @map("tracking_url_template")
  /// ACTIVE | INACTIVE
  status              String   @default("ACTIVE")
  notes               String?
  createdBy           Int?     @map("created_by")
  updatedBy           Int?     @map("updated_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  shipments    ScmShipment[]

  @@unique([organizationId, carrierCode])
  @@map("carriers")
  @@schema("scm")
}

model ScmShipment {
  id                   Int       @id @default(autoincrement())
  organizationId       Int       @map("organization_id")
  shipmentNumber       String    @map("shipment_number")
  fulfillmentId        Int       @map("fulfillment_id")
  salesOrderId         Int       @map("sales_order_id")
  salesOrderNumber     String    @map("sales_order_number")
  customerId           Int       @map("customer_id")
  customerName         String    @map("customer_name")
  warehouseId          Int       @map("warehouse_id")
  /// Point-in-time package/line snapshot taken from the packed packings.
  packages             Json
  totalPackages        Int       @map("total_packages")
  totalWeight          Decimal   @default(0) @map("total_weight") @db.Decimal(14, 3)
  shippingAddress      String    @map("shipping_address")
  billingAddress       String?   @map("billing_address")
  carrierId            Int?      @map("carrier_id")
  carrierName          String?   @map("carrier_name")
  /// STANDARD | EXPRESS | SAME_DAY | ECONOMY | OTHER
  serviceType          String?   @map("service_type")
  trackingNumber       String?   @map("tracking_number")
  trackingUrl          String?   @map("tracking_url")
  shippingCost         Decimal?  @map("shipping_cost") @db.Decimal(14, 2)
  currency             String    @default("INR")
  /// READY_TO_SHIP | CARRIER_ASSIGNED | LABEL_CREATED | DISPATCHED | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | DELIVERY_EXCEPTION | FAILED_DELIVERY | CANCELLED
  status               String    @default("READY_TO_SHIP")
  shipmentDate         DateTime? @map("shipment_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  actualDeliveryDate   DateTime? @map("actual_delivery_date") @db.Date
  recipientName        String?   @map("recipient_name")
  deliveryNotes        String?   @map("delivery_notes")
  proofOfDeliveryUrl   String?   @map("proof_of_delivery_url")
  carrierAssignedBy    Int?      @map("carrier_assigned_by")
  carrierAssignedAt    DateTime? @map("carrier_assigned_at")
  dispatchedBy         Int?      @map("dispatched_by")
  dispatchedAt         DateTime? @map("dispatched_at")
  deliveredBy          Int?      @map("delivered_by")
  deliveredAt          DateTime? @map("delivered_at")
  cancelledBy          Int?      @map("cancelled_by")
  cancelledAt          DateTime? @map("cancelled_at")
  cancellationReason   String?   @map("cancellation_reason")
  notes                String?
  createdBy            Int?      @map("created_by")
  updatedBy            Int?      @map("updated_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [organizationId], references: [id])
  fulfillment  ScmFulfillment             @relation(fields: [fulfillmentId], references: [id])
  salesOrder   ScmSalesOrder              @relation(fields: [salesOrderId], references: [id])
  customer     ScmCustomer                @relation(fields: [customerId], references: [id])
  warehouse    ScmWarehouse               @relation(fields: [warehouseId], references: [id])
  carrier      ScmCarrier?                @relation(fields: [carrierId], references: [id])
  packingLinks ScmShipmentPacking[]
  events       ScmShipmentTrackingEvent[]
  exceptions   ScmShipmentException[]

  @@unique([organizationId, shipmentNumber])
  @@index([organizationId, status])
  @@index([fulfillmentId])
  @@map("shipments")
  @@schema("scm")
}

/// Which packings a shipment carries. A packing can be on at most one
/// non-cancelled shipment (partial index in the migration).
model ScmShipmentPacking {
  id         Int @id @default(autoincrement())
  shipmentId Int @map("shipment_id")
  packingId  Int @map("packing_id")

  shipment ScmShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  packing  ScmPacking  @relation(fields: [packingId], references: [id])

  @@unique([shipmentId, packingId])
  @@map("shipment_packings")
  @@schema("scm")
}

/// Append-only (DB trigger): a faithful shipment timeline.
model ScmShipmentTrackingEvent {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  shipmentId     Int      @map("shipment_id")
  status         String
  location       String?
  description    String?
  eventTime      DateTime @default(now()) @map("event_time")
  /// SYSTEM | MANUAL
  source         String   @default("SYSTEM")
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  shipment ScmShipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, eventTime])
  @@map("shipment_tracking_events")
  @@schema("scm")
}

model ScmShipmentException {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  shipmentId     Int       @map("shipment_id")
  /// CUSTOMER_UNAVAILABLE | ADDRESS_ISSUE | WEATHER_DELAY | DAMAGED_PACKAGE | CARRIER_DELAY | OTHER
  exceptionCode  String    @map("exception_code")
  description    String
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  resolution     String?
  resolvedAt     DateTime? @map("resolved_at")
  resolvedBy     Int?      @map("resolved_by")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  shipment ScmShipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@map("shipment_exceptions")
  @@schema("scm")
}

// ---------------------------------------------------------------------------
// SCM returns and quality control (Docs/SCM_LEGACY_PARITY.md sections 7-8).
// One ScmReturn entity discriminated by return_type (customer / vendor). The
// over-return guard is enforced under a row lock on the source document, not
// a separate reservation tree. Quality owns the inspection engine, defect and
// template masters and the quarantine register; stock effects go through
// StockPostingService only.
// ---------------------------------------------------------------------------

model ScmReturn {
  id                  Int       @id @default(autoincrement())
  organizationId      Int       @map("organization_id")
  returnNumber        String    @map("return_number")
  /// CUSTOMER_RETURN | VENDOR_RETURN
  returnType          String    @map("return_type")
  salesOrderId        Int?      @map("sales_order_id")
  salesOrderNumber    String?   @map("sales_order_number")
  fulfillmentId       Int?      @map("fulfillment_id")
  fulfillmentNumber   String?   @map("fulfillment_number")
  shipmentId          Int?      @map("shipment_id")
  shipmentNumber      String?   @map("shipment_number")
  customerId          Int?      @map("customer_id")
  customerName        String?   @map("customer_name")
  purchaseOrderId     Int?      @map("purchase_order_id")
  purchaseOrderNumber String?   @map("purchase_order_number")
  grnId               Int?      @map("grn_id")
  grnNumber           String?   @map("grn_number")
  supplierId          Int?      @map("supplier_id")
  supplierName        String?   @map("supplier_name")
  warehouseId         Int       @map("warehouse_id")
  reasonCode          String    @map("reason_code")
  reasonDescription   String?   @map("reason_description")
  /// Customer: REQUESTED PENDING_APPROVAL APPROVED REJECTED IN_TRANSIT RECEIVED
  /// INSPECTION_PENDING INSPECTED DISPOSITION_PENDING COMPLETED CANCELLED.
  /// Vendor: REQUESTED PENDING_APPROVAL APPROVED REJECTED READY_TO_SHIP SHIPPED
  /// VENDOR_RECEIVED COMPLETED CANCELLED.
  status              String    @default("REQUESTED")
  requestedDate       DateTime  @default(now()) @map("requested_date")
  approvedBy          Int?      @map("approved_by")
  approvedAt          DateTime? @map("approved_at")
  rejectionReason     String?   @map("rejection_reason")
  receivedBy          Int?      @map("received_by")
  receivedAt          DateTime? @map("received_at")
  inspectedBy         Int?      @map("inspected_by")
  inspectedAt         DateTime? @map("inspected_at")
  shippedBy           Int?      @map("shipped_by")
  shippedAt           DateTime? @map("shipped_at")
  vendorReceivedAt    DateTime? @map("vendor_received_at")
  completedBy         Int?      @map("completed_by")
  completedAt         DateTime? @map("completed_at")
  cancelledBy         Int?      @map("cancelled_by")
  cancelledAt         DateTime? @map("cancelled_at")
  cancellationReason  String?   @map("cancellation_reason")
  /// Manual reverse-leg tracking: { carrier, trackingNumber, shippedDate, receivedDate, notes }
  returnShipment      Json?     @map("return_shipment")
  qualityInspectionId Int?      @map("quality_inspection_id")
  notes               String?
  createdBy           Int?      @map("created_by")
  updatedBy           Int?      @map("updated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  warehouse    ScmWarehouse           @relation(fields: [warehouseId], references: [id])
  items        ScmReturnItem[]
  inspections  ScmReturnInspection[]
  dispositions ScmReturnDisposition[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, returnType, status])
  @@index([fulfillmentId])
  @@index([grnId])
  @@map("returns")
  @@schema("scm")
}

model ScmReturnItem {
  id                    Int      @id @default(autoincrement())
  returnId              Int      @map("return_id")
  lineNo                Int      @map("line_no")
  productId             Int      @map("product_id")
  productCode           String   @map("product_code")
  productName           String   @map("product_name")
  uom                   String   @default("PCS")
  orderedQty            Decimal? @map("ordered_qty") @db.Decimal(14, 3)
  /// Customer: units issued on the fulfillment; vendor: units accepted on the GRN line.
  sourceQty             Decimal  @map("source_qty") @db.Decimal(14, 3)
  previouslyReturnedQty Decimal  @default(0) @map("previously_returned_qty") @db.Decimal(14, 3)
  requestedQty          Decimal  @map("requested_qty") @db.Decimal(14, 3)
  receivedReturnQty     Decimal? @map("received_return_qty") @db.Decimal(14, 3)
  acceptedQty           Decimal? @map("accepted_qty") @db.Decimal(14, 3)
  rejectedQty           Decimal? @map("rejected_qty") @db.Decimal(14, 3)
  condition             String?
  grnItemId             Int?     @map("grn_item_id")
  batchId               Int?     @map("batch_id")
  batchNumber           String?  @map("batch_number")
  serialNumbers         String[] @map("serial_numbers")
  warehouseId           Int      @map("warehouse_id")
  locationId            Int?     @map("location_id")
  /// Vendor return: PURCHASE_RETURN ledger entry posted at ship time.
  postedLedgerEntryId   Int?     @map("posted_ledger_entry_id")
  unitCost              Decimal? @map("unit_cost") @db.Decimal(14, 4)
  notes                 String?

  return       ScmReturn              @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product      ScmProduct             @relation(fields: [productId], references: [id])
  dispositions ScmReturnDisposition[]

  @@index([returnId])
  @@index([productId])
  @@map("return_items")
  @@schema("scm")
}

model ScmReturnInspection {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  returnId       Int      @map("return_id")
  inspectorId    Int      @map("inspector_id")
  inspectionDate DateTime @default(now()) @map("inspection_date")
  condition      String
  acceptedQty    Decimal  @map("accepted_qty") @db.Decimal(14, 3)
  rejectedQty    Decimal  @map("rejected_qty") @db.Decimal(14, 3)
  /// ACCEPTED | PARTIALLY_ACCEPTED | REJECTED
  result         String
  items          Json
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  return ScmReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("return_inspections")
  @@schema("scm")
}

/// One row per disposition decision on a return line (a line may be split
/// across several). Append-only; RESTOCK draws on accepted units, REJECT on
/// rejected units.
model ScmReturnDisposition {
  id                 Int      @id @default(autoincrement())
  organizationId     Int      @map("organization_id")
  returnId           Int      @map("return_id")
  returnItemId       Int      @map("return_item_id")
  productId          Int      @map("product_id")
  /// RESTOCK | QUARANTINE | DAMAGED | SCRAP | REJECT
  disposition        String
  quantity           Decimal  @db.Decimal(14, 3)
  warehouseId        Int      @map("warehouse_id")
  locationId         Int?     @map("location_id")
  notes              String?
  ledgerEntryIds     Int[]    @map("ledger_entry_ids")
  quarantineRecordId Int?     @map("quarantine_record_id")
  createdBy          Int?     @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")

  return     ScmReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnItem ScmReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([returnItemId])
  @@map("return_dispositions")
  @@schema("scm")
}

model ScmQualityDefect {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  defectCode     String   @map("defect_code")
  name           String
  description    String?
  category       String
  severity       String
  active         Boolean  @default(true)
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, defectCode])
  @@map("quality_defects")
  @@schema("scm")
}

model ScmQualityTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  templateCode   String   @map("template_code")
  name           String
  description    String?
  /// INCOMING | CUSTOMER_RETURN | INVENTORY | PRE_DISPATCH
  inspectionType String   @map("inspection_type")
  active         Boolean  @default(true)
  /// [{ checkpointId, name, description?, required, expectedValue?, unit?, sequence }]
  checkpoints    Json
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, templateCode])
  @@map("quality_templates")
  @@schema("scm")
}

model ScmQualityInspection {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  inspectionNumber   String    @map("inspection_number")
  /// INCOMING | CUSTOMER_RETURN | INVENTORY | PRE_DISPATCH
  inspectionType     String    @map("inspection_type")
  /// GRN | RETURN | INVENTORY | FULFILLMENT
  sourceType         String    @map("source_type")
  sourceId           Int       @map("source_id")
  sourceNumber       String?   @map("source_number")
  templateId         Int?      @map("template_id")
  templateName       String?   @map("template_name")
  supplierId         Int?      @map("supplier_id")
  supplierName       String?   @map("supplier_name")
  customerId         Int?      @map("customer_id")
  customerName       String?   @map("customer_name")
  warehouseId        Int?      @map("warehouse_id")
  locationId         Int?      @map("location_id")
  /// DRAFT | PENDING_INSPECTION | IN_PROGRESS | COMPLETED | CANCELLED
  status             String    @default("PENDING_INSPECTION")
  /// PASSED | PARTIALLY_PASSED | FAILED | ON_HOLD (set on completion)
  result             String?
  /// LOW | MEDIUM | HIGH | CRITICAL
  priority           String    @default("MEDIUM")
  inspectionDate     DateTime  @default(now()) @map("inspection_date")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  inspectorId        Int?      @map("inspector_id")
  inspectorName      String?   @map("inspector_name")
  notes              String?
  cancelledBy        Int?      @map("cancelled_by")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  createdBy          Int?      @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [organizationId], references: [id])
  items        ScmQualityInspectionItem[]

  @@unique([organizationId, inspectionNumber])
  @@index([organizationId, status])
  @@index([organizationId, sourceType, sourceId])
  @@map("quality_inspections")
  @@schema("scm")
}

model ScmQualityInspectionItem {
  id                 Int      @id @default(autoincrement())
  inspectionId       Int      @map("inspection_id")
  lineNo             Int      @map("line_no")
  productId          Int      @map("product_id")
  productCode        String   @map("product_code")
  productName        String   @map("product_name")
  sourceLineId       Int?     @map("source_line_id")
  batchId            Int?     @map("batch_id")
  batchNumber        String?  @map("batch_number")
  serialNumbers      String[] @map("serial_numbers")
  orderedQty         Decimal? @map("ordered_qty") @db.Decimal(14, 3)
  sourceQty          Decimal  @map("source_qty") @db.Decimal(14, 3)
  inspectedQty       Decimal  @default(0) @map("inspected_qty") @db.Decimal(14, 3)
  acceptedQty        Decimal  @default(0) @map("accepted_qty") @db.Decimal(14, 3)
  rejectedQty        Decimal  @default(0) @map("rejected_qty") @db.Decimal(14, 3)
  /// PASS | PARTIAL_PASS | FAIL | HOLD
  inspectionResult   String?  @map("inspection_result")
  condition          String?
  defectCode         String?  @map("defect_code")
  defectDescription  String?  @map("defect_description")
  /// ACCEPT | RELEASE | QUARANTINE | REWORK | DAMAGED | SCRAP | REJECT
  disposition        String?
  notes              String?
  warehouseId        Int?     @map("warehouse_id")
  locationId         Int?     @map("location_id")
  unitCost           Decimal? @map("unit_cost") @db.Decimal(14, 4)
  /// [{ checkpointId, name, required, result, observedValue?, notes?, defectCode? }]
  checkpointResults  Json     @default("[]") @map("checkpoint_results")
  ledgerEntryId      Int?     @map("ledger_entry_id")
  quarantineRecordId Int?     @map("quarantine_record_id")

  inspection ScmQualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  product    ScmProduct           @relation(fields: [productId], references: [id])

  @@index([inspectionId])
  @@index([productId])
  @@map("quality_inspection_items")
  @@schema("scm")
}

model ScmQuarantineRecord {
  id                   Int       @id @default(autoincrement())
  organizationId       Int       @map("organization_id")
  productId            Int       @map("product_id")
  productCode          String    @map("product_code")
  productName          String    @map("product_name")
  batchId              Int?      @map("batch_id")
  batchNumber          String?   @map("batch_number")
  serialNumbers        String[]  @map("serial_numbers")
  warehouseId          Int       @map("warehouse_id")
  locationId           Int?      @map("location_id")
  quantity             Decimal   @db.Decimal(14, 3)
  /// GRN | RETURN | INVENTORY | FULFILLMENT
  sourceType           String    @map("source_type")
  sourceId             Int?      @map("source_id")
  sourceNumber         String?   @map("source_number")
  inspectionId         Int?      @map("inspection_id")
  inspectionNumber     String?   @map("inspection_number")
  defectCode           String?   @map("defect_code")
  reason               String?
  /// QUARANTINED | UNDER_REVIEW | RELEASED | REJECTED
  status               String    @default("QUARANTINED")
  quarantineDate       DateTime  @default(now()) @map("quarantine_date")
  reviewedBy           Int?      @map("reviewed_by")
  reviewedAt           DateTime? @map("reviewed_at")
  releasedBy           Int?      @map("released_by")
  releasedAt           DateTime? @map("released_at")
  releaseLedgerEntryId Int?      @map("release_ledger_entry_id")
  rejectedBy           Int?      @map("rejected_by")
  rejectedAt           DateTime? @map("rejected_at")
  rejectLedgerEntryId  Int?      @map("reject_ledger_entry_id")
  notes                String?
  createdBy            Int?      @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      ScmProduct   @relation(fields: [productId], references: [id])
  warehouse    ScmWarehouse @relation(fields: [warehouseId], references: [id])

  @@index([organizationId, status])
  @@index([productId])
  @@map("quarantine_records")
  @@schema("scm")
}

// ---------------------------------------------------------------------------
// Warehouse operations: put-away (received stock -> a bin) and internal
// movements (bin -> bin within one warehouse). Neither posts to the stock
// ledger — total on-hand per product/warehouse is unchanged, only *where*
// inside the warehouse it sits. `ScmLocationStock` is the running per-bin
// balance both post into under a row lock, which is a more direct design
// than the legacy Firebase port (which had no balance table and replayed
// every putaway/movement/picking document on every read).
// ---------------------------------------------------------------------------

model ScmLocationStock {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  productId      Int      @map("product_id")
  warehouseId    Int      @map("warehouse_id")
  locationId     Int      @map("location_id")
  quantity       Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id])
  product      ScmProduct           @relation(fields: [productId], references: [id])
  warehouse    ScmWarehouse         @relation(fields: [warehouseId], references: [id])
  location     ScmWarehouseLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, warehouseId, locationId])
  @@map("location_stock")
  @@schema("scm")
}

model ScmPutaway {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  putawayNumber      String    @map("putaway_number")
  warehouseId        Int       @map("warehouse_id")
  grnId              Int?      @map("grn_id")
  grnNumber          String?   @map("grn_number")
  /// PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  status             String    @default("PENDING")
  notes              String?
  createdBy          Int?      @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")

  organization Organization     @relation(fields: [organizationId], references: [id])
  warehouse    ScmWarehouse     @relation(fields: [warehouseId], references: [id])
  items        ScmPutawayItem[]

  @@unique([organizationId, putawayNumber])
  @@index([organizationId, status])
  @@map("putaways")
  @@schema("scm")
}

model ScmPutawayItem {
  id                    Int      @id @default(autoincrement())
  putawayId             Int      @map("putaway_id")
  lineNo                Int      @map("line_no")
  productId             Int      @map("product_id")
  productCode           String   @map("product_code")
  productName           String   @map("product_name")
  quantity              Decimal  @db.Decimal(14, 3)
  destinationLocationId Int?     @map("destination_location_id")
  putAwayQuantity       Decimal  @default(0) @map("put_away_quantity") @db.Decimal(14, 3)
  batchId               Int?     @map("batch_id")
  batchNumber           String?  @map("batch_number")
  serialNumbers         String[] @map("serial_numbers")
  notes                 String?

  putaway ScmPutaway @relation(fields: [putawayId], references: [id], onDelete: Cascade)
  product ScmProduct @relation(fields: [productId], references: [id])

  @@index([putawayId])
  @@map("putaway_items")
  @@schema("scm")
}

model ScmWarehouseMovement {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  movementNumber     String    @map("movement_number")
  warehouseId        Int       @map("warehouse_id")
  /// DRAFT | REQUESTED | APPROVED | IN_PROGRESS | COMPLETED | CANCELLED
  status             String    @default("DRAFT")
  requestedBy        Int?      @map("requested_by")
  approvedBy         Int?      @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  notes              String?
  createdBy          Int?      @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")

  organization Organization               @relation(fields: [organizationId], references: [id])
  warehouse    ScmWarehouse               @relation(fields: [warehouseId], references: [id])
  items        ScmWarehouseMovementItem[]

  @@unique([organizationId, movementNumber])
  @@index([organizationId, status])
  @@map("warehouse_movements")
  @@schema("scm")
}

model ScmWarehouseMovementItem {
  id                    Int      @id @default(autoincrement())
  movementId            Int      @map("movement_id")
  lineNo                Int      @map("line_no")
  productId             Int      @map("product_id")
  productCode           String   @map("product_code")
  productName           String   @map("product_name")
  quantity              Decimal  @db.Decimal(14, 3)
  sourceLocationId      Int      @map("source_location_id")
  destinationLocationId Int      @map("destination_location_id")
  batchId               Int?     @map("batch_id")
  batchNumber           String?  @map("batch_number")
  serialNumbers         String[] @map("serial_numbers")

  movement ScmWarehouseMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  product  ScmProduct           @relation(fields: [productId], references: [id])

  @@index([movementId])
  @@map("warehouse_movement_items")
  @@schema("scm")
}

// ---------------------------------------------------------------------------
// SCM supplier finance: Accounts Payable bills, payments made, and supplier
// documents (legacy supplier detail tabs "Bills", "Payments", "Documents").
// Money is Decimal(14,2). A bill's `paidAmount` is only ever changed together
// with a payment row, inside one transaction under a row lock.
// ---------------------------------------------------------------------------

/// A supplier's invoice recorded for payment, optionally against a PO / GRN.
model ScmSupplierBill {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  billNumber         String    @map("bill_number")
  /// The supplier's own invoice number.
  supplierBillNumber String?   @map("supplier_bill_number")
  supplierId         Int       @map("supplier_id")
  purchaseOrderId    Int?      @map("purchase_order_id")
  goodsReceiptId     Int?      @map("goods_receipt_id")
  billDate           DateTime  @map("bill_date") @db.Date
  dueDate            DateTime? @map("due_date") @db.Date
  currency           String    @default("INR")
  subtotal           Decimal   @default(0) @db.Decimal(14, 2)
  taxAmount          Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total              Decimal   @default(0) @db.Decimal(14, 2)
  paidAmount         Decimal   @default(0) @map("paid_amount") @db.Decimal(14, 2)
  /// OPEN | PARTIALLY_PAID | PAID | CANCELLED. "Overdue" is derived from dueDate.
  status             String    @default("OPEN")
  notes              String?
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [organizationId], references: [id])
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  purchaseOrder ScmPurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  ScmGoodsReceipt?     @relation(fields: [goodsReceiptId], references: [id])
  payments      ScmSupplierPayment[]

  @@unique([organizationId, billNumber])
  @@index([organizationId, supplierId])
  @@index([organizationId, status])
  @@map("supplier_bills")
  @@schema("scm")
}

/// A payment made to a supplier, optionally applied to one bill. An unapplied
/// payment is an advance / on-account payment.
model ScmSupplierPayment {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  paymentNumber   String    @map("payment_number")
  supplierId      Int       @map("supplier_id")
  billId          Int?      @map("bill_id")
  paymentDate     DateTime  @map("payment_date") @db.Date
  /// BANK_TRANSFER | CASH | CHEQUE | UPI | CARD | OTHER
  mode            String
  referenceNumber String?   @map("reference_number")
  amount          Decimal   @db.Decimal(14, 2)
  currency        String    @default("INR")
  notes           String?
  /// POSTED | VOIDED
  status          String    @default("POSTED")
  voidedAt        DateTime? @map("voided_at")
  voidReason      String?   @map("void_reason")
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  bill         ScmSupplierBill? @relation(fields: [billId], references: [id])

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, supplierId])
  @@index([billId])
  @@map("supplier_payments")
  @@schema("scm")
}

/// A file uploaded against a supplier (GST certificate, PAN, contract...).
/// The bytes live in local-disk file storage under `storageKey`.
model ScmSupplierDocument {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  supplierId     Int       @map("supplier_id")
  name           String
  documentType   String?   @map("document_type")
  fileName       String    @map("file_name")
  storageKey     String    @map("storage_key")
  mimeType       String    @map("mime_type")
  sizeBytes      Int       @map("size_bytes")
  uploadedBy     Int?      @map("uploaded_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  supplier     Supplier     @relation(fields: [supplierId], references: [id])

  @@index([organizationId, supplierId])
  @@map("supplier_documents")
  @@schema("scm")
}

// ---------------------------------------------------------------------------
// Projects Module Schema — projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  active
  on_hold
  completed
  cancelled

  @@schema("projects")
}

enum MilestoneStatus {
  not_started
  in_progress
  hold
  completed

  @@schema("projects")
}

enum TaskStatus {
  not_started
  in_progress
  hold
  completed

  @@schema("projects")
}

enum TaskPriority {
  low
  medium
  high
  urgent

  @@schema("projects")
}

enum ProjectExpenseStatus {
  unpaid
  paid
  cancelled

  @@schema("projects")
}

model Project {
  id                     Int           @id @default(autoincrement())
  organizationId         Int           @map("organization_id")
  projectCode            String        @map("project_code")
  name                   String
  description            String?
  customerId             Int?          @map("customer_id")
  customerName           String?       @map("customer_name")
  projectType            String?       @map("project_type")
  /// Multi-department selection (legacy `ProjectForm.tsx` chip-toggle UX) —
  /// a project can span more than one department, unlike the single-string
  /// `department` field other modules use for employee home department.
  departments            String[]      @default([])
  /// Name-based resource assignment, matching legacy exactly (array of
  /// employee display names, not IDs). `ProjectMember` rows (below) are
  /// still written for referential integrity/hours-tracking; this is the
  /// denormalized display/search array the old UI reads and edits directly.
  resourceNames          String[]      @default([]) @map("resource_names")
  expectedHours          Decimal       @default(0) @map("expected_hours") @db.Decimal(10, 2)
  projectPrice           Decimal       @default(0) @map("project_price") @db.Decimal(14, 2)
  actualCost             Decimal       @default(0) @map("actual_cost") @db.Decimal(14, 2)
  status                 ProjectStatus @default(active)
  startDate              DateTime      @map("start_date") @db.Date
  plannedEndDate         DateTime?     @map("planned_end_date") @db.Date
  actualEndDate          DateTime?     @map("actual_end_date") @db.Date
  clientHandlingPersonId Int?          @map("client_handling_person_id")
  customFields           Json          @default("{}") @map("custom_fields")
  createdBy              Int?          @map("created_by")
  updatedBy              Int?          @map("updated_by")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(6)

  organization         Organization       @relation(fields: [organizationId], references: [id])
  customer             Account?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  clientHandlingPerson Employee?          @relation("ProjectClientHandler", fields: [clientHandlingPersonId], references: [id])
  members              ProjectMember[]
  milestones           ProjectMilestone[]
  tasks                ProjectTask[]
  expenses             ProjectExpense[]
  proposalDocuments    ProposalDocument[]
  momDocuments         MomDocument[]

  @@unique([organizationId, projectCode])
  @@index([organizationId, status])
  @@map("projects")
  @@schema("projects")
}

model ProjectMember {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  projectId      Int      @map("project_id")
  employeeId     Int      @map("employee_id")
  role           String   @default("Contributor")
  estimatedHours Decimal  @default(0) @map("estimated_hours") @db.Decimal(10, 2)
  loggedHours    Decimal  @default(0) @map("logged_hours") @db.Decimal(10, 2)
  hourlyRate     Decimal  @default(0) @map("hourly_rate") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([projectId, employeeId])
  @@index([organizationId, employeeId])
  @@map("project_members")
  @@schema("projects")
}

model ProjectMilestone {
  id             Int             @id @default(autoincrement())
  organizationId Int             @map("organization_id")
  projectId      Int             @map("project_id")
  title          String
  targetDate     DateTime        @map("target_date") @db.Date
  actualDate     DateTime?       @map("actual_date") @db.Date
  status         MilestoneStatus @default(not_started)
  order          Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        ProjectTask[]

  @@index([projectId, order])
  @@map("project_milestones")
  @@schema("projects")
}

model ProjectTask {
  id                    Int          @id @default(autoincrement())
  organizationId        Int          @map("organization_id")
  projectId             Int          @map("project_id")
  taskCode              String       @map("task_code")
  milestoneId           Int?         @map("milestone_id")
  assignedToId          Int?         @map("assigned_to_id")
  title                 String
  description           String?
  department            String?
  startDate             DateTime     @map("start_date") @db.Date
  endDate               DateTime     @map("end_date") @db.Date
  actualEndDate         DateTime?    @map("actual_end_date") @db.Date
  hoursToComplete       Decimal      @default(0) @map("hours_to_complete") @db.Decimal(10, 2)
  loggedHours           Decimal      @default(0) @map("logged_hours") @db.Decimal(10, 2)
  status                TaskStatus   @default(not_started)
  completionPercent     Int          @default(0) @map("completion_percent")
  priority              TaskPriority @default(medium)
  dependencyTaskId      Int?         @map("dependency_task_id")
  /// Legacy `types.ts` richer dependency metadata, kept alongside
  /// `dependencyTaskId` (which stays the authoritative FK used for DFS
  /// cycle-detection) purely for the old UI's descriptive display —
  /// finish_to_start|start_to_start|finish_to_finish etc.
  dependencyType        String?      @map("dependency_type")
  /// must_complete|should_complete|informational — matches legacy's
  /// `dependencyRequirement`.
  dependencyRequirement String?      @map("dependency_requirement")
  /// Legacy also allowed a "soft" dependency target that isn't necessarily
  /// another ProjectTask row (e.g. an external/employee milestone) —
  /// `dependencyTargetId`/`dependencyTargetName` reproduce that free-form
  /// display pair; `dependencyTaskId` above remains the only one enforced
  /// as a real FK.
  dependencyTargetId    Int?         @map("dependency_target_id")
  dependencyTargetName  String?      @map("dependency_target_name")
  points                Int          @default(10)
  customFields          Json         @default("{}") @map("custom_fields")
  createdBy             Int?         @map("created_by")
  updatedBy             Int?         @map("updated_by")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization   Organization          @relation(fields: [organizationId], references: [id])
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      ProjectMilestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignedTo     Employee?             @relation(fields: [assignedToId], references: [id])
  dependencyTask ProjectTask?          @relation("TaskDependencies", fields: [dependencyTaskId], references: [id])
  dependentTasks ProjectTask[]         @relation("TaskDependencies")
  timeEntries    ProjectTimeEntry[]
  pointsLedger   ProjectPointsLedger[]

  @@unique([organizationId, taskCode])
  @@index([projectId, status])
  @@index([organizationId, assignedToId])
  @@map("project_tasks")
  @@schema("projects")
}

model ProjectTimeEntry {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  taskId          Int       @map("task_id")
  employeeId      Int       @map("employee_id")
  startedAt       DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(6)
  durationMinutes Int       @default(0) @map("duration_minutes")
  entryDate       DateTime  @map("entry_date") @db.Date
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  task         ProjectTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId, employeeId, entryDate])
  @@index([taskId])
  @@map("project_time_entries")
  @@schema("projects")
}

model ProjectExpense {
  id             Int                  @id @default(autoincrement())
  organizationId Int                  @map("organization_id")
  projectId      Int                  @map("project_id")
  department     String?
  amount         Decimal              @db.Decimal(14, 2)
  expenseDate    DateTime             @map("expense_date") @db.Date
  /// Display name of the vendor. When `supplierId` is set this is a copy of
  /// the SCM supplier's company name at the time of saving; otherwise it is a
  /// free-text vendor not (yet) in the supplier master.
  vendor         String?
  /// Optional link to the SCM supplier master (`scm.suppliers`) — reuses the
  /// existing vendor register instead of a Projects-only vendor table.
  supplierId     Int?                 @map("supplier_id")
  referenceNo    String?              @map("reference_no")
  status         ProjectExpenseStatus @default(unpaid)
  notes          String?
  createdBy      Int?                 @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
  @@index([organizationId, supplierId])
  @@map("project_expenses")
  @@schema("projects")
}

model ProjectPointsLedger {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  employeeId     Int      @map("employee_id")
  taskId         Int      @map("task_id")
  taskTitle      String   @map("task_title")
  points         Int
  awardedAt      DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)
  note           String?

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  task         ProjectTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@map("project_points_ledger")
  @@schema("projects")
}

model ProjectPointsConfig {
  id             Int      @id @default(autoincrement())
  organizationId Int      @unique @map("organization_id")
  low            Int      @default(5)
  medium         Int      @default(10)
  high           Int      @default(20)
  urgent         Int      @default(30)
  customRules    Json     @default("{}") @map("custom_rules")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("project_points_config")
  @@schema("projects")
}

// ---------------------------------------------------------------------------
// Proposal Documents — legacy `src/modules/projects/proposals/` +
// `proposalTypes.ts`. Full port (not a stub): templates with versioned,
// dynamic JSON-driven section schemas, issued documents that snapshot their
// template at issue time, and a workflow/audit trail (one `ProposalActivity`
// row per status transition). Proposal numbers are allocated via
// `platform.document_sequences` (Docs/PROJECTS_MODULE_SPEC.md pattern),
// replacing legacy's ad-hoc `ProposalSettings.nextSequence` counter.
// ---------------------------------------------------------------------------

enum ProposalTemplateStatus {
  draft
  active
  archived

  @@schema("projects")
}

enum ProposalStatus {
  draft
  under_review
  changes_requested
  approved
  sent
  accepted
  rejected
  archived

  @@schema("projects")
}

model ProposalTemplate {
  id              Int                    @id @default(autoincrement())
  organizationId  Int                    @map("organization_id")
  code            String?
  name            String
  title           String
  description     String?
  department      String?
  category        String?
  version         Int                    @default(1)
  parentVersionId Int?                   @map("parent_version_id")
  isCurrent       Boolean                @default(true) @map("is_current")
  status          ProposalTemplateStatus @default(draft)
  isDefault       Boolean                @default(false) @map("is_default")
  /// Dynamic section schema — `ProposalSectionConfig[]` shape from legacy
  /// `proposalTypes.ts` (nested section_group support, per-section content
  /// type, table/key-value/signature field configs, etc.)
  schemaJson      Json                   @default("[]") @map("schema_json")
  createdBy       Int?                   @map("created_by")
  createdByName   String?                @map("created_by_name")
  publishedAt     DateTime?              @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id])
  parentVersion ProposalTemplate?  @relation("ProposalTemplateVersions", fields: [parentVersionId], references: [id])
  childVersions ProposalTemplate[] @relation("ProposalTemplateVersions")
  documents     ProposalDocument[]

  @@index([organizationId, status])
  @@map("proposal_templates")
  @@schema("projects")
}

model ProposalDocument {
  id                     Int            @id @default(autoincrement())
  organizationId         Int            @map("organization_id")
  proposalNumber         String         @map("proposal_number")
  title                  String
  projectId              Int?           @map("project_id")
  projectCode            String?        @map("project_code")
  projectName            String?        @map("project_name")
  clientId               Int?           @map("client_id")
  clientName             String?        @map("client_name")
  templateId             Int?           @map("template_id")
  templateTitle          String?        @map("template_title")
  templateCode           String?        @map("template_code")
  templateVersion        Int?           @map("template_version")
  /// Full clone of the template's `schemaJson` at issue time — protects
  /// already-issued documents from later template edits (legacy
  /// `template_snapshot`).
  templateSnapshot       Json?          @map("template_snapshot")
  /// Section values keyed by section id (legacy `proposal_data`).
  sectionValues          Json           @default("{}") @map("section_values")
  status                 ProposalStatus @default(draft)
  preparedBy             Int?           @map("prepared_by")
  proposalDate           DateTime?      @map("proposal_date") @db.Date
  dueDate                DateTime?      @map("due_date") @db.Date
  followUpNotes          String?        @map("follow_up_notes")
  followUpExtensionCount Int            @default(0) @map("follow_up_extension_count")
  createdBy              Int?           @map("created_by")
  updatedBy              Int?           @map("updated_by")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id])
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template     ProposalTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  activities   ProposalActivity[]

  @@unique([organizationId, proposalNumber])
  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@index([organizationId, dueDate])
  @@map("proposal_documents")
  @@schema("projects")
}

/// One row per workflow-status transition — legacy `ProposalActivity`
/// (audit trail shown on the Hub's "Workflow & Audit History" tab).
model ProposalActivity {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  proposalId     Int      @map("proposal_id")
  userId         Int?     @map("user_id")
  userName       String?  @map("user_name")
  userRole       String?  @map("user_role")
  action         String
  previousStatus String?  @map("previous_status")
  newStatus      String?  @map("new_status")
  comments       String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  proposal     ProposalDocument @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("proposal_activities")
  @@schema("projects")
}

/// One row per organization — company branding + numbering config, legacy
/// `ProposalSettings`. `nextSequence`/`sampleGeneratedNumber` stay here only
/// as display/preview fields; actual allocation uses
/// `platform.document_sequences` (see proposals module's sequence helper).
model ProposalSettings {
  id                    Int      @id @default(autoincrement())
  organizationId        Int      @unique @map("organization_id")
  companyName           String?  @map("company_name")
  logoUrl               String?  @map("logo_url")
  email                 String?
  phone                 String?
  website               String?
  address               String?
  showHeader            Boolean  @default(true) @map("show_header")
  showFooter            Boolean  @default(true) @map("show_footer")
  /// Granular header/footer toggles (legacy `ProposalSettingsPage`). The
  /// `showHeader`/`showFooter` flags above remain the master switches.
  showHeaderLogo        Boolean  @default(true) @map("show_header_logo")
  showHeaderCompanyName Boolean  @default(true) @map("show_header_company_name")
  showHeaderDocTitle    Boolean  @default(true) @map("show_header_doc_title")
  showFooterEmail       Boolean  @default(true) @map("show_footer_email")
  showFooterPhone       Boolean  @default(true) @map("show_footer_phone")
  showFooterWebsite     Boolean  @default(true) @map("show_footer_website")
  showFooterAddress     Boolean  @default(true) @map("show_footer_address")
  showFooterPageNumber  Boolean  @default(true) @map("show_footer_page_number")
  prefix                String   @default("PROP")
  yearFormat            String   @default("YYYY") @map("year_format")
  sequenceDigits        Int      @default(4) @map("sequence_digits")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("proposal_settings")
  @@schema("projects")
}

// ---------------------------------------------------------------------------
// Minutes of Meeting (MoM) — legacy `src/modules/projects/mom/`. Full port:
// documents with draft/finalized/archived lifecycle, revision tracking when
// a finalized MoM is edited again (`workingRevision`/`workingRevisionReason`
// -> a new `MomRevision` row + `MomHistoryEvent` entries), and a template
// library mirroring the Proposals template pattern. Reference numbers
// (`MOM-YYYY-NNNN`) are allocated via `platform.document_sequences`,
// replacing legacy's `mom_counters/{year}` RTDB path.
// ---------------------------------------------------------------------------

enum MomTemplateStatus {
  draft
  active
  archived

  @@schema("projects")
}

enum MomStatus {
  draft
  finalized
  archived

  @@schema("projects")
}

model MomTemplate {
  id                     Int               @id @default(autoincrement())
  organizationId         Int               @map("organization_id")
  code                   String?
  name                   String
  description            String?
  category               String?
  version                Int               @default(1)
  parentVersionId        Int?              @map("parent_version_id")
  status                 MomTemplateStatus @default(draft)
  isDefault              Boolean           @default(false) @map("is_default")
  /// `MomSectionConfig[]` — section_type/title/order/visible/required.
  sectionsJson           Json              @default("[]") @map("sections_json")
  defaultAgendaJson      Json              @default("[]") @map("default_agenda_json")
  defaultNoteRowsJson    Json              @default("[]") @map("default_note_rows_json")
  additionalSectionsJson Json              @default("[]") @map("additional_sections_json")
  createdBy              Int?              @map("created_by")
  publishedAt            DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?         @map("deleted_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id])
  parentVersion MomTemplate?  @relation("MomTemplateVersions", fields: [parentVersionId], references: [id])
  childVersions MomTemplate[] @relation("MomTemplateVersions")
  documents     MomDocument[]

  @@index([organizationId, status])
  @@map("mom_templates")
  @@schema("projects")
}

model MomDocument {
  id                     Int       @id @default(autoincrement())
  organizationId         Int       @map("organization_id")
  reference              String
  projectId              Int?      @map("project_id")
  projectCode            String?   @map("project_code")
  projectName            String?   @map("project_name")
  clientName             String?   @map("client_name")
  meetingTitle           String    @map("meeting_title")
  meetingDate            DateTime  @map("meeting_date") @db.Date
  startTime              String?   @map("start_time")
  endTime                String?   @map("end_time")
  timezone               String?
  location               String?
  attendeesJson          Json      @default("[]") @map("attendees_json")
  absenteesJson          Json      @default("[]") @map("absentees_json")
  agendaJson             Json      @default("[]") @map("agenda_json")
  meetingNotesJson       Json      @default("[]") @map("meeting_notes_json")
  additionalSectionsJson Json      @default("[]") @map("additional_sections_json")
  freeTextContent        String?   @map("free_text_content")
  status                 MomStatus @default(draft)
  previousStatus         String?   @map("previous_status")
  templateId             Int?      @map("template_id")
  templateTitle          String?   @map("template_title")
  templateVersion        Int?      @map("template_version")
  templateSnapshot       Json?     @map("template_snapshot")
  currentRevision        Int       @default(1) @map("current_revision")
  /// Non-null while a finalized MoM is being re-edited (legacy
  /// `workingRevision`/`workingRevisionReason`) — cleared once re-finalized,
  /// at which point a `MomRevision` row captures the prior snapshot.
  workingRevision        Int?      @map("working_revision")
  workingRevisionReason  String?   @map("working_revision_reason")
  /// Optimistic-concurrency token (legacy `versionToken`), bumped on every
  /// save so concurrent editors get a conflict instead of a silent overwrite.
  versionToken           String?   @map("version_token")
  createdBy              Int?      @map("created_by")
  updatedBy              Int?      @map("updated_by")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template     MomTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  revisions    MomRevision[]
  history      MomHistoryEvent[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@map("mom_documents")
  @@schema("projects")
}

/// Full meeting-state snapshot captured whenever a finalized MoM is revised
/// — legacy `MomRevision`.
model MomRevision {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  momId          Int      @map("mom_id")
  revisionNumber Int      @map("revision_number")
  userId         Int?     @map("user_id")
  userName       String?  @map("user_name")
  changeSummary  String?  @map("change_summary")
  snapshotJson   Json     @map("snapshot_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  mom          MomDocument  @relation(fields: [momId], references: [id], onDelete: Cascade)

  @@unique([momId, revisionNumber])
  @@map("mom_revisions")
  @@schema("projects")
}

/// Lifecycle audit log — legacy `MomHistoryEvent`
/// (created/saved_draft/finalized/revision_started/
/// revised_version_finalized/archived/restored).
model MomHistoryEvent {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  momId          Int      @map("mom_id")
  userId         Int?     @map("user_id")
  userName       String?  @map("user_name")
  action         String
  details        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  mom          MomDocument  @relation(fields: [momId], references: [id], onDelete: Cascade)

  @@index([momId, createdAt])
  @@map("mom_history_events")
  @@schema("projects")
}

model OrganizationSetting {
  id                     Int      @id @default(autoincrement())
  organizationId         Int      @unique @map("organization_id")
  theme                  String   @default("system")
  density                String   @default("comfortable")
  country                String   @default("IN")
  locale                 String   @default("en-IN")
  timezone               String   @default("Asia/Kolkata")
  dateFormat             String   @default("DD/MM/YYYY") @map("date_format")
  timeFormat             String   @default("12h") @map("time_format")
  baseCurrency           String   @default("INR") @map("base_currency")
  currencySymbolPosition String   @default("before") @map("currency_symbol_position")
  numberFormat           String   @default("indian") @map("number_format")
  fiscalYearStartMonth   Int      @default(4) @map("fiscal_year_start_month")
  customFields           Json     @default("{}") @map("custom_fields")
  createdBy              Int?     @map("created_by")
  updatedBy              Int?     @map("updated_by")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_settings")
  @@schema("platform")
}

model UserPreference {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  organizationId  Int      @map("organization_id")
  theme           String?
  density         String?
  locale          String?
  timezone        String?
  dateFormat      String?  @map("date_format")
  timeFormat      String?  @map("time_format")
  displayCurrency String?  @map("display_currency")
  customFields    Json     @default("{}") @map("custom_fields")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("user_preferences")
  @@schema("platform")
}

model ExchangeRate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  fromCurrency   String   @map("from_currency") @db.VarChar(3)
  toCurrency     String   @map("to_currency") @db.VarChar(3)
  rate           Decimal  @db.Decimal(18, 6)
  effectiveDate  DateTime @map("effective_date") @db.Date
  source         String   @default("manual") @db.VarChar(64)
  isHistorical   Boolean  @default(false) @map("is_historical")
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, fromCurrency, toCurrency, effectiveDate])
  @@index([organizationId, fromCurrency, toCurrency])
  @@map("exchange_rates")
  @@schema("platform")
}
