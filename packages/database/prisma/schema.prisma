/// Document metadata only. The file itself lives in storage at `storage_key`
/// (storage backend not yet decided; Vault is paused).
/// employeeId+documentType is unique only among source="ONBOARDING" rows — a
/// partial unique index enforced in migration
/// 20261007000000_hr_employee_documents/migration.sql, since Prisma's schema
/// language cannot express a partial (WHERE-qualified) unique index. Do not
/// add `@@unique([employeeId, documentType])` here: it would reject the
/// multiple HR_UPLOADED rows this model is designed to allow.
model EmployeeDocument {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  teamId         Int       @map("team_id")
  employeeId     Int       @map("employee_id")
  documentType   String    @map("document_type")
  /// Free-text display name for HR ad-hoc uploads (e.g. "Offer Letter").
  /// Null for onboarding's fixed-type rows, where documentType is the name.
  label          String?   @map("label")
  /// "ONBOARDING" (employee self-service, one per documentType) or
  /// "HR_UPLOADED" (ad-hoc, HR-added, unlimited per documentType).
  source         String    @default("ONBOARDING") @map("source")
  fileName       String    @map("file_name")
  storageKey     String    @map("storage_key")
  /// Set by the file upload path; null only on rows written before uploads existed.
  mimeType       String?   @map("mime_type")
  sizeBytes      Int?      @map("size_bytes")
  uploadedAt     DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  team         Team         @relation(fields: [teamId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([employeeId, documentType])
  @@index([organizationId, teamId, employeeId])
  @@map("employee_documents")
  @@schema("hr")
}

