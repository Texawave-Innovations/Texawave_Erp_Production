  approver      User?         @relation("LoanSkipApprover", fields: [approvedById], references: [id])

  @@unique([loanId, payrollPeriodId])
  @@index([organizationId, loanId])
  @@index([organizationId, status])
  @@map("loan_skip_requests")
  @@schema("hr")
}

model EmployeeBonus {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  employeeId      Int       @map("employee_id")
  payrollPeriodId Int?      @map("payroll_period_id")
  bonusType       String    @map("bonus_type")
  calculationBase String?   @map("calculation_base")
  tenureMonths    Int?      @map("tenure_months")
  attendanceDays  Decimal?  @map("attendance_days") @db.Decimal(5, 2)
  amount          Decimal   @map("amount") @db.Decimal(12, 2)
  status          String    @default("PENDING")
  reason          String?
  approvedById    Int?      @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  customFields    Json      @default("{}") @map("custom_fields")
  isActive        Boolean   @default(true) @map("is_active")
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
