  employeeAddresses          EmployeeAddress[]
  employeeGovernmentIds      EmployeeGovernmentId[]
  payrollPeriods             PayrollPeriod[]
  payrollRuns                PayrollRun[]
  payrollEntries             PayrollEntry[]
  companyDetail              CompanyDetail?
  bankAccounts               BankAccount[]
  authorizedSignatory        AuthorizedSignatory?
  salespersons               Salesperson[]
  sealSignatures             SealSignature[]
  salesMasterListItems       SalesMasterListItem[]
  financeMasterListItems     FinanceMasterListItem[]
  payrollEarnings            PayrollEarning[]
  payrollDeductions          PayrollDeduction[]
  projectCategoryMasters     ProjectCategoryMaster[]
  projectCodeMaster          ProjectCodeMaster?
  taskRunningNumberMaster    TaskRunningNumberMaster?
  employeeSalaries           EmployeeSalary[]
