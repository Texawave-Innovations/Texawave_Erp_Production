/// Organization-wide payroll rules (apps/api/src/modules/hr/payroll/settings).
/// At most one row per organization; no row means the defaults in
/// `payroll-settings.rules.ts`, which equal the values that were hard-coded
/// before this table existed. Percentages are 0–100 (CHECKs in the migration).
model PayrollSetting {
  id                Int      @id @default(autoincrement())
  organizationId    Int      @unique @map("organization_id")
  /// Auto-split of a gross monthly salary; the remainder is `other_allowance`.
  basicPercent      Decimal  @default(35) @map("basic_percent") @db.Decimal(5, 2)
  hraPercent        Decimal  @default(30) @map("hra_percent") @db.Decimal(5, 2)
  conveyancePercent Decimal  @default(20) @map("conveyance_percent") @db.Decimal(5, 2)
  pfWageCeiling     Decimal  @default(15000) @map("pf_wage_ceiling") @db.Decimal(12, 2)
  pfEmployeeRate    Decimal  @default(12) @map("pf_employee_rate") @db.Decimal(5, 2)
  pfEmployerRate    Decimal  @default(12) @map("pf_employer_rate") @db.Decimal(5, 2)
  esiWageThreshold  Decimal  @default(21000) @map("esi_wage_threshold") @db.Decimal(12, 2)
  esiEmployeeRate   Decimal  @default(0.75) @map("esi_employee_rate") @db.Decimal(5, 2)
  esiEmployerRate   Decimal  @default(3.25) @map("esi_employer_rate") @db.Decimal(5, 2)
  /// Pay-days policy (Docs/PAYROLL_AND_COMPLIANCE.md §3.1): the per-day
  /// divisor. CALENDAR | FIXED_30 | FIXED_26 | WORKING_DAYS (CHECK).
  payDaysMode       String   @default("CALENDAR") @map("pay_days_mode")
  /// Read the employee's APPROVED attendance month lock (absences, half days,
  /// overtime); a run refuses employees whose month is not approved.
  useAttendance     Boolean  @default(true) @map("use_attendance")
  /// A working day with no attendance at all counts as an absence (LOP).
  unmarkedDaysAsAbsent Boolean @default(true) @map("unmarked_days_as_absent")
  overtimeEnabled   Boolean  @default(false) @map("overtime_enabled")
  /// Fixed rupees per overtime hour; when null the rate is the hourly wage
  /// (gross ÷ divisor ÷ standard hours) × `overtime_multiplier`.
  overtimeRatePerHour Decimal? @map("overtime_rate_per_hour") @db.Decimal(10, 2)
  overtimeMultiplier Decimal @default(2) @map("overtime_multiplier") @db.Decimal(4, 2)
  standardHoursPerDay Decimal @default(8) @map("standard_hours_per_day") @db.Decimal(4, 2)
  /// PF: when false, PF is on the full PF wage (voluntary higher wage).
  pfCapAtCeiling    Boolean  @default(true) @map("pf_cap_at_ceiling")
  epsRate           Decimal  @default(8.33) @map("eps_rate") @db.Decimal(5, 2)
  epsWageCeiling    Decimal  @default(15000) @map("eps_wage_ceiling") @db.Decimal(12, 2)
  epsAgeLimit       Int      @default(58) @map("eps_age_limit")
  edliRate          Decimal  @default(0.5) @map("edli_rate") @db.Decimal(5, 2)
  edliWageCeiling   Decimal  @default(15000) @map("edli_wage_ceiling") @db.Decimal(12, 2)
  pfAdminRate       Decimal  @default(0.5) @map("pf_admin_rate") @db.Decimal(5, 2)
  ptEnabled         Boolean  @default(false) @map("pt_enabled")
  ptDefaultStateCode String? @map("pt_default_state_code")
  tdsEnabled        Boolean  @default(false) @map("tds_enabled")
  /// OLD | NEW (CHECK): the regime of an employee with no declaration.
  defaultTaxRegime  String   @default("NEW") @map("default_tax_regime")
  bonusEligibilityLimit Decimal @default(21000) @map("bonus_eligibility_limit") @db.Decimal(12, 2)
  bonusCalculationCeiling Decimal @default(7000) @map("bonus_calculation_ceiling") @db.Decimal(12, 2)
  bonusPercent      Decimal  @default(8.33) @map("bonus_percent") @db.Decimal(5, 2)
  gratuityCap       Decimal  @default(2000000) @map("gratuity_cap") @db.Decimal(12, 2)
  gratuityMinYears  Int      @default(5) @map("gratuity_min_years")
  loanMaxMultiple   Decimal  @default(3) @map("loan_max_multiple") @db.Decimal(5, 2)
  loanMaxEmiPercent Decimal  @default(100) @map("loan_max_emi_percent") @db.Decimal(5, 2)
  /// Employer details printed on payslips, Form 16 and statutory files.
  companyName       String?  @map("company_name")
  companyAddress    String?  @map("company_address")
  companyGstin      String?  @map("company_gstin")
  companyPan        String?  @map("company_pan")
  companyTan        String?  @map("company_tan")
  pfEstablishmentCode String? @map("pf_establishment_code")
  esiEmployerCode   String?  @map("esi_employer_code")
  version           Int      @default(1)
  createdBy         Int?     @map("created_by")
  updatedBy         Int?     @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("payroll_settings")
  @@schema("hr")
}

model PayrollPeriod {
