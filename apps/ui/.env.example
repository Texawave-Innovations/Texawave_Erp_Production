# Copy to apps/ui/.env.local (Next.js's own convention for local overrides)
# or plain .env — either works. Only NEXT_PUBLIC_* vars belong here: Next.js
# only inlines vars with that prefix into the browser bundle, so anything
# else added here would silently never reach client code.

# Must point at wherever apps/api is actually listening. The two apps'
# default dev ports collide (both default to 3000) — see
# Docs/ARCHITECTURE.md "Local environment" for running one on a different
# port and keeping this in sync with apps/api's CORS_ORIGIN.
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Playwright e2e only (apps/ui/playwright.config.ts), not read by the app itself ---
# Optional — defaults to http://localhost:3001 if unset.
# UI_BASE_URL=http://localhost:3001
