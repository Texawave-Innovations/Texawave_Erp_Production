# Copy to apps/api/.env. Every var below is validated at startup by
# apps/api/src/config/env.validation.ts (zod) — it fails fast with a clear
# message naming any var that's missing or malformed, rather than an
# undefined a hundred requests later. Keep this file and that schema in
# sync — every process.env.* the API reads must be declared in both places.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001

# --- Database (matches docker-compose.yml's postgres service / root .env.example) ---
DATABASE_URL="postgresql://texawave:texawave@localhost:5432/texawave_erp?schema=public"

# --- Redis (matches docker-compose.yml's redis service / root .env.example) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Generate a real one for anything beyond a laptop: openssl rand -base64 48
# Never commit a real secret here or anywhere else in the repo.
JWT_SECRET="replace-with-a-real-random-secret-at-least-32-characters-long"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Password reset ---
# How long a forgot-password link stays valid before it must be re-requested.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Used to build the reset link sent by email (apps/ui's own origin, not the API's).
APP_BASE_URL=http://localhost:3001
