  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login & Token Extraction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', () => pm.expect(pm.response.code).to.eq(201));",
                  "const json = pm.response.json();",
                  "pm.test('Response contains valid accessToken', () => {",
                  "    pm.expect(json.data).to.have.property('accessToken');",
                  "    pm.expect(json.data.accessToken).to.be.a('string');",
                  "});",
                  "if (json.data && json.data.accessToken) {",
                  "    pm.environment.set('token', json.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationSlug\": \"{{organizationSlug}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
