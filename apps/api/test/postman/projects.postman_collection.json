{
  "info": {
    "_postman_id": "texawave-projects-api-collection",
    "name": "TexaWave ERP - Projects Module API",
    "description": "Comprehensive automated Postman test collection for TexaWave ERP Projects, Milestones, Tasks, Live Stopwatch, Manual Work Logs, Expenses, EVM Financials, Gamification Points, and Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
