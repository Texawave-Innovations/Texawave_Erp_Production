{
  "info": {
    "_postman_id": "a4d81290-8e12-4012-98ab-34f789abcdef",
    "name": "TexaOne Finance API (Milestones 3 & 4)",
    "description": "Complete Postman collection for TexaOne Finance Core Backend APIs:\n- Milestone 3: Operational Expenses Lifecycle & General Ledger Integration\n- Milestone 4: Customer Payments Received, Invoice Allocations & General Ledger Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication & Prerequisite Discovery",
      "item": [
        {
          "name": "0.1 Login (Retrieve Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Access token returned\", () => {",
                  "  pm.expect(res.data.accessToken).to.be.a(\"string\");",
                  "  pm.environment.set(\"accessToken\", res.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationSlug\": \"{{organizationSlug}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "0.2 Discover Payment Modes (Master List)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "if (res.data && res.data.length > 0) {",
                  "  pm.environment.set(\"paymentModeId\", res.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance-settings/master-list-items?category=payment_mode&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["finance-settings", "master-list-items"],
              "query": [
                { "key": "category", "value": "payment_mode" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "0.3 Discover Expense Types (Master List)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "if (res.data && res.data.length > 0) {",
                  "  pm.environment.set(\"expenseTypeId\", res.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance-settings/master-list-items?category=expense_type&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["finance-settings", "master-list-items"],
              "query": [
                { "key": "category", "value": "expense_type" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "0.4 Discover Chart of Accounts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/accounts?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "accounts"],
              "query": [{ "key": "limit", "value": "50" }]
            }
          }
        }
      ]
    },
    {
      "name": "1. Milestone 3: Operational Expenses",
      "item": [
        {
          "name": "1.1 Create Draft Expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Expense created in DRAFT status\", () => {",
                  "  pm.expect(res.data.status).to.equal(\"DRAFT\");",
                  "  pm.expect(res.data.id).to.be.a(\"number\");",
                  "  pm.environment.set(\"expenseId\", res.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expenseTypeId\": {{expenseTypeId}},\n  \"expenseDate\": \"2026-10-23\",\n  \"amount\": 3000.00,\n  \"taxAmount\": 540.00,\n  \"paymentModeId\": {{paymentModeId}},\n  \"vendorName\": \"Apex Office Hub\",\n  \"referenceNumber\": \"INV-AOH-9912\",\n  \"notes\": \"Workstation equipment purchase\",\n  \"status\": \"DRAFT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses"]
            }
          }
        },
        {
          "name": "1.2 Get Expense by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses", "{{expenseId}}"]
            }
          }
        },
        {
          "name": "1.3 List & Filter Expenses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/expenses?status=DRAFT&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses"],
              "query": [
                { "key": "status", "value": "DRAFT" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "1.4 Update Expense (Metadata)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 3200.00,\n  \"taxAmount\": 576.00,\n  \"notes\": \"Revised equipment purchase including surge protectors\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses", "{{expenseId}}"]
            }
          }
        },
        {
          "name": "1.5 Submit Expense for Approval",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Status is PENDING_APPROVAL\", () => {",
                  "  pm.expect(res.data.status).to.equal(\"PENDING_APPROVAL\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/expenses/{{expenseId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses", "{{expenseId}}", "submit"]
            }
          }
        },
        {
          "name": "1.6 Approve Expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Status is APPROVED\", () => {",
                  "  pm.expect(res.data.status).to.equal(\"APPROVED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/expenses/{{expenseId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses", "{{expenseId}}", "approve"]
            }
          }
        },
        {
          "name": "1.7 Pay Expense & Post GL Journal Voucher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Status is PAID\", () => {",
                  "  pm.expect(res.data.status).to.equal(\"PAID\");",
                  "  pm.expect(res.data.journalEntryId).to.be.a(\"number\");",
                  "  pm.environment.set(\"expenseJournalId\", res.data.journalEntryId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentDate\": \"2026-10-23\",\n  \"referenceNumber\": \"NEFT-TXN-778899\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/expenses/{{expenseId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses", "{{expenseId}}", "pay"]
            }
          }
        },
        {
          "name": "1.8 Cancel Paid Expense (Generate GL Reversal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Status is CANCELLED\", () => {",
                  "  pm.expect(res.data.status).to.equal(\"CANCELLED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/expenses/{{expenseId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses", "{{expenseId}}", "cancel"]
            }
          }
        },
        {
          "name": "1.9 Soft Delete Cancelled Expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses", "{{expenseId}}"]
            }
          }
        },
        {
          "name": "1.10 [Negative] Future Expense Date Rejection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expenseTypeId\": {{expenseTypeId}},\n  \"expenseDate\": \"2099-01-01\",\n  \"amount\": 1000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Milestone 4: Customer Payments Received",
      "item": [
        {
          "name": "2.1 Record Customer Receipt (Draft) with Multi-Invoice Allocations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Receipt created with correct balances\", () => {",
                  "  pm.expect(res.data.status).to.equal(\"DRAFT\");",
                  "  pm.expect(res.data.amount).to.equal(8000);",
                  "  pm.expect(res.data.allocatedAmount).to.equal(5000);",
                  "  pm.expect(res.data.unallocatedAmount).to.equal(3000);",
                  "  pm.environment.set(\"paymentReceivedId\", res.data.id);",
                  "  if (res.data.allocations && res.data.allocations.length > 0) {",
                  "    pm.environment.set(\"allocationId\", res.data.allocations[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentDate\": \"2026-10-23\",\n  \"amount\": 8000.00,\n  \"paymentModeId\": {{paymentModeId}},\n  \"customerName\": \"Globex Corporation\",\n  \"referenceNumber\": \"CHQ-AXIS-112233\",\n  \"notes\": \"Initial customer receipt with partial allocations\",\n  \"status\": \"DRAFT\",\n  \"allocations\": [\n    {\n      \"invoiceReference\": \"INV-202610-0044\",\n      \"allocatedAmount\": 3000.00,\n      \"notes\": \"Full clearance INV-0044\"\n    },\n    {\n      \"invoiceReference\": \"INV-202610-0045\",\n      \"allocatedAmount\": 2000.00,\n      \"notes\": \"Partial payment INV-0045\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "payments-received"]
            }
          }
        },
        {
          "name": "2.2 Get Customer Receipt by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received/{{paymentReceivedId}}",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "payments-received", "{{paymentReceivedId}}"]
            }
          }
        },
        {
          "name": "2.3 List & Filter Customer Payments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received?page=1&limit=10&status=DRAFT",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "payments-received"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "DRAFT" }
              ]
            }
          }
        },
        {
          "name": "2.4 Update Receipt Metadata",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceNumber\": \"CHQ-AXIS-REVISED\",\n  \"notes\": \"Updated cheque number per bank stamp\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received/{{paymentReceivedId}}",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "payments-received", "{{paymentReceivedId}}"]
            }
          }
        },
        {
          "name": "2.5 Dynamically Add Invoice Allocation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Unallocated balance decremented\", () => {",
                  "  pm.expect(res.data.allocatedAmount).to.equal(6500);",
                  "  pm.expect(res.data.unallocatedAmount).to.equal(1500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceReference\": \"INV-202610-0046\",\n  \"allocatedAmount\": 1500.00,\n  \"notes\": \"Follow-up allocation from remaining balance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received/{{paymentReceivedId}}/allocations",
              "host": ["{{baseUrl}}"],
              "path": [
                "finance",
                "payments-received",
                "{{paymentReceivedId}}",
                "allocations"
              ]
            }
          }
        },
        {
          "name": "2.6 Remove Invoice Allocation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received/{{paymentReceivedId}}/allocations/{{allocationId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "finance",
                "payments-received",
                "{{paymentReceivedId}}",
                "allocations",
                "{{allocationId}}"
              ]
            }
          }
        },
        {
          "name": "2.7 Confirm Receipt & Post Double-Entry GL Journal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Status is CONFIRMED with journal entry\", () => {",
                  "  pm.expect(res.data.status).to.equal(\"CONFIRMED\");",
                  "  pm.expect(res.data.journalEntryId).to.be.a(\"number\");",
                  "  pm.environment.set(\"paymentReceivedJournalId\", res.data.journalEntryId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received/{{paymentReceivedId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": [
                "finance",
                "payments-received",
                "{{paymentReceivedId}}",
                "confirm"
              ]
            }
          }
        },
        {
          "name": "2.8 Void Receipt & Reverse GL Journal Voucher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Status is VOID\", () => {",
                  "  pm.expect(res.data.status).to.equal(\"VOID\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received/{{paymentReceivedId}}/void",
              "host": ["{{baseUrl}}"],
              "path": [
                "finance",
                "payments-received",
                "{{paymentReceivedId}}",
                "void"
              ]
            }
          }
        },
        {
          "name": "2.9 Soft Delete Void Receipt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received/{{paymentReceivedId}}",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "payments-received", "{{paymentReceivedId}}"]
            }
          }
        },
        {
          "name": "2.10 [Negative] Over-Allocation on Creation Rejection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentDate\": \"2026-10-23\",\n  \"amount\": 1000.00,\n  \"paymentModeId\": {{paymentModeId}},\n  \"customerName\": \"Globex Corporation\",\n  \"allocations\": [\n    {\n      \"invoiceReference\": \"INV-001\",\n      \"allocatedAmount\": 800.00\n    },\n    {\n      \"invoiceReference\": \"INV-002\",\n      \"allocatedAmount\": 400.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/payments-received",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "payments-received"]
            }
          }
        }
      ]
    }
  ]
}
